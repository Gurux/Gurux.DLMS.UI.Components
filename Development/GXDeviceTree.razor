@* <summary>Displays devices and their objects in selectable groups with context-menu actions.</summary> *@

@using Microsoft.AspNetCore.Components.Web
@typeparam TDevice
@typeparam TObject

<section class="gx-device-tree" aria-label="@Title">
    <details open>
        <summary><GXButton type="button" class="@(IsCollectionSelected ? "node selected" : "node")"
                         aria-pressed="@(IsCollectionSelected ? "true" : "false")"
                         OnContextMenu="e => OpenContextMenuAsync(e, OnSelectCollection.InvokeAsync, true)" PreventContextMenu="true" OnClick="() => OnSelectCollection.InvokeAsync()" StopClickPropagation="true"><img src="@Icon("devices")" alt="" width="16" height="16" />@Title</GXButton></summary>
        @if (Devices.Count == 0)
        {
            <p>@EmptyText</p>
        }
        @foreach (var device in Devices)
        {
            <details class="device" open @key="device">
                <summary>
                    <GXButton type="button" class="@(IsDeviceSelected?.Invoke(device) == true ? "node selected" : "node")"
                            aria-pressed="@(IsDeviceSelected?.Invoke(device) == true ? "true" : "false")"
                            OnContextMenu="e => OpenContextMenuAsync(e, () => OnSelectDevice.InvokeAsync(device))" PreventContextMenu="true" OnClick="() => OnSelectDevice.InvokeAsync(device)" StopClickPropagation="true"><img src="@Icon("device")" alt="" width="16" height="16" />@GetDeviceName(device)</GXButton>
                </summary>
                @foreach (var group in GetObjects(device).GroupBy(GetObjectType))
                {
                    <details class="group" open @key="group.Key">
                        <summary><GXButton type="button" class="@(IsGroupSelected?.Invoke(device, group.Key) == true ? "node selected" : "node")"
                            aria-pressed="@(IsGroupSelected?.Invoke(device, group.Key) == true ? "true" : "false")"
                            OnContextMenu="e => OpenContextMenuAsync(e, () => SelectGroupAsync(device, group.Key))" PreventContextMenu="true" OnClick="() => SelectGroupAsync(device, group.Key)" StopClickPropagation="true"><img src="@Icon("category")" alt="" width="16" height="16" />@group.Key</GXButton></summary>
                        @foreach (var item in group)
                        {
                            <GXButton @key="item" type="button" class="@(IsObjectSelected?.Invoke(device, item) == true ? "node object selected" : "node object")"
                                    aria-pressed="@(IsObjectSelected?.Invoke(device, item) == true ? "true" : "false")"
                                    OnContextMenu="e => OpenContextMenuAsync(e, () => SelectObjectAsync(device, item))" PreventContextMenu="true" OnClick="() => SelectObjectAsync(device, item)">
                                <img src="@Icon(GetObjectType(item) == "ProfileGeneric" ? "profile-generic" : "object")" alt="" width="16" height="16" />@GetLogicalName(item) @GetObjectName(item)
                            </GXButton>
                        }
                    </details>
                }
            </details>
        }
    </details>
</section>
@if (_contextOpen)
{
    <div class="gx-tree-menu-backdrop" @onclick="CloseContextMenu" @oncontextmenu="CloseContextMenu" @oncontextmenu:preventDefault="true"></div>
    <div class="gx-tree-context-menu" role="menu" aria-label="Device commands"
         style="@($"left:min({_contextX.ToString(System.Globalization.CultureInfo.InvariantCulture)}px, calc(100vw - 190px));top:min({_contextY.ToString(System.Globalization.CultureInfo.InvariantCulture)}px, calc(100dvh - 340px))")"
         @onkeydown="ContextKeyDown">
        @foreach (var command in ContextCommands)
        {
            if (command.Id.Length == 0)
            {
                <hr role="separator" />
            }
            else
            {
                <GXButton type="button" role="menuitem" Disabled="@(IsContextCommandEnabled?.Invoke(command.Id) == false)"
                        OnClick="() => ExecuteContextCommandAsync(command.Id)">@command.Text</GXButton>
            }
        }
    </div>
}


@code {
    /// <summary>
    /// Callback receiving the chosen context-menu command identifier.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnContextCommand
    {
        get; set;
    }
    /// <summary>
    /// Determines whether a context-menu command is enabled.
    /// </summary>
    [Parameter]
    public Func<string, bool>? IsContextCommandEnabled
    {
        get; set;
    }
    private bool _contextOpen, _contextCollection;
    private double _contextX, _contextY;
    private (string Id, string Text)[] ContextCommands => _contextCollection
        ? [("AddDeviceMnu", "Add Device")]
        : [("ConnectMnu", "Connect"), ("DisconnectMnu", "Disconnect"), ("ReadMnu", "Read"),
           ("ReadObjectMnu", "Read Object"), ("", ""), ("ImportMenu", "Load Values"),
           ("ExportMenu", "Save Values As..."), ("", ""), ("DeleteMnu", "Delete"),
           ("", ""), ("PropertiesMnu", "Properties")];

    /// <summary>
    /// Selects the target node and opens its context menu at the pointer position.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    /// <param name="collection">Whether to show commands for the root device collection.</param>
    /// <param name="e">Pointer event supplying the menu position.</param>
    /// <param name="select">Callback that selects the target node.</param>
    public async Task OpenContextMenuAsync(MouseEventArgs e, Func<Task> select, bool collection = false)
    {
        await select();
        _contextCollection = collection;
        _contextX = e.ClientX;
        _contextY = e.ClientY;
        _contextOpen = true;
    }

    /// <summary>
    /// Dispatches an enabled command from the open context menu.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    /// <param name="command">Context-menu command identifier.</param>
    public async Task ExecuteContextCommandAsync(string command)
    {
        if (!_contextOpen || !ContextCommands.Any(item => item.Id == command && command.Length != 0)
            || IsContextCommandEnabled?.Invoke(command) == false)
        {
            return;
        }
        CloseContextMenu();
        await OnContextCommand.InvokeAsync(command);
    }

    private void CloseContextMenu() => _contextOpen = false;
    private void ContextKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseContextMenu();
        }
    }

    private static string Icon(string name) => $"_content/Gurux.DLMS.UI.Components/images/icons/{name}.svg";
    /// <summary>
    /// Devices displayed in the collection.
    /// </summary>
    [Parameter] public IReadOnlyList<TDevice> Devices { get; set; } = [];
    /// <summary>
    /// Resolves the display name for a device node.
    /// </summary>
    [Parameter, EditorRequired] public Func<TDevice, string> GetDeviceName { get; set; } = device => device?.ToString() ?? string.Empty;
    /// <summary>
    /// Resolves the objects belonging to a device.
    /// </summary>
    [Parameter, EditorRequired] public Func<TDevice, IReadOnlyList<TObject>> GetObjects { get; set; } = _ => [];
    /// <summary>
    /// Resolves the object type used for grouping or display.
    /// </summary>
    [Parameter, EditorRequired] public Func<TObject, string> GetObjectType { get; set; } = _ => string.Empty;
    /// <summary>
    /// Resolves the object's displayed logical name.
    /// </summary>
    [Parameter, EditorRequired] public Func<TObject, string> GetLogicalName { get; set; } = _ => string.Empty;
    /// <summary>
    /// Resolves the display name for an object node.
    /// </summary>
    [Parameter, EditorRequired] public Func<TObject, string> GetObjectName { get; set; } = item => item?.ToString() ?? string.Empty;
    /// <summary>
    /// Determines whether a device node is selected.
    /// </summary>
    [Parameter]
    public Func<TDevice, bool>? IsDeviceSelected
    {
        get; set;
    }
    /// <summary>
    /// Determines whether an object node in a device is selected.
    /// </summary>
    [Parameter]
    public Func<TDevice, TObject, bool>? IsObjectSelected
    {
        get; set;
    }
    /// <summary>
    /// Callback receiving the selected device.
    /// </summary>
    [Parameter]
    public EventCallback<TDevice> OnSelectDevice
    {
        get; set;
    }
    /// <summary>
    /// Callback invoked when the root device collection is selected.
    /// </summary>
    [Parameter]
    public EventCallback OnSelectCollection
    {
        get; set;
    }
    /// <summary>
    /// Whether the root device collection is selected.
    /// </summary>
    [Parameter]
    public bool IsCollectionSelected
    {
        get; set;
    }
    /// <summary>
    /// Callback receiving the selected object.
    /// </summary>
    [Parameter]
    public EventCallback<TObject> OnSelectObject
    {
        get; set;
    }
    /// <summary>
    /// Callback receiving the selected device and object-type group.
    /// </summary>
    [Parameter]
    public EventCallback<(TDevice Device, string ObjectType)> OnSelectGroup
    {
        get; set;
    }
    /// <summary>
    /// Determines whether an object-type group in a device is selected.
    /// </summary>
    [Parameter]
    public Func<TDevice, string, bool>? IsGroupSelected
    {
        get; set;
    }
    /// <summary>
    /// Heading displayed above the component content.
    /// </summary>
    [Parameter] public string Title { get; set; } = "Devices";
    /// <summary>
    /// Message displayed when the collection is empty.
    /// </summary>
    [Parameter] public string EmptyText { get; set; } = "No devices loaded.";

    /// <summary>Optional atomic device/object selection callback, used instead of the separate selection callbacks.</summary>
    [Parameter] public EventCallback<(TDevice Device, TObject Object)> OnNavigateObject { get; set; }

    /// <summary>Optional atomic device/group selection callback, used instead of the separate selection callbacks.</summary>
    [Parameter] public EventCallback<(TDevice Device, string ObjectType)> OnNavigateGroup { get; set; }

    /// <summary>
    /// Selects the device and notifies the parent of the chosen object-type group.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    /// <param name="objectType">Object type identifying the group.</param>
    /// <param name="device">Device containing the group.</param>
    public async Task SelectGroupAsync(TDevice device, string objectType)
    {
        if (OnNavigateGroup.HasDelegate)
        {
            await OnNavigateGroup.InvokeAsync((device, objectType));
            return;
        }
        await OnSelectDevice.InvokeAsync(device);
        await OnSelectGroup.InvokeAsync((device, objectType));
    }

    /// <summary>
    /// Selects the device and notifies the parent of the chosen object.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    /// <param name="device">Device containing the object.</param>
    /// <param name="item">Object to select.</param>
    public async Task SelectObjectAsync(TDevice device, TObject item)
    {
        if (OnNavigateObject.HasDelegate)
        {
            await OnNavigateObject.InvokeAsync((device, item));
            return;
        }
        await OnSelectDevice.InvokeAsync(device);
        await OnSelectObject.InvokeAsync(item);
    }
}
