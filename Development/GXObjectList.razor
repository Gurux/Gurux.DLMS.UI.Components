@typeparam TObject
@using System.Globalization
@using System.Text.Json
@using Microsoft.JSInterop
@using Gurux.UI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IGXLocalStorage Storage

<section class="gx-object-list" aria-label="@Title">
    <h2>@Title</h2>
    @if (Objects.Count == 0)
    {
        <p>@EmptyText</p>
    }
    else
    {
        var rows = Objects.Select(item => (Item: item, Values: GetAttributeValues(item))).ToArray();
        var columns = rows.SelectMany(row => row.Values.Keys).Where(index => index > 1).Distinct().Order().ToArray();
        <div class="table-scroll" tabindex="0" role="region" aria-label="COSEM objects">
            <table id="@_tableId" style="width:@(TableWidth(columns))px">
                <colgroup>
                    <col data-column="name" style="@ColumnStyle("name")" />
                    <col data-column="type" style="@ColumnStyle("type")" />
                    @foreach (var index in columns)
                    {
                        <col data-column="@AttributeKey(index)" style="@ColumnStyle(AttributeKey(index))" />
                    }
                </colgroup>
                <thead><tr><th scope="col">Name @ResizeHandle("name", "Name")</th><th scope="col">Object Type @ResizeHandle("type", "Object Type")</th>
                    @foreach (var index in columns)
                    {
                        <th scope="col">Attribute @index @ResizeHandle(AttributeKey(index), $"Attribute {index}")</th>
                    }
                </tr></thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        var selected = IsSelected?.Invoke(row.Item) == true;
                        <tr @key="row.Item" class="@(selected ? "selected" : null)">
                            <td><GXButton type="button" aria-pressed="@(selected ? "true" : "false")" OnClick="() => OnSelect.InvokeAsync(row.Item)" OnDoubleClick="() => OnActivate.InvokeAsync(row.Item)">
                                <img src="@Icon(GetObjectType(row.Item) == "ProfileGeneric" ? "profile-generic" : "object")" alt="" width="16" height="16" />
                                @GetLogicalName(row.Item) @GetName(row.Item)
                            </GXButton></td>
                            <td>@GetObjectType(row.Item)</td>
                            @foreach (var index in columns)
                            {
                                <td title="@row.Values.GetValueOrDefault(index)">@row.Values.GetValueOrDefault(index)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter] public string ColumnWidthsKey { get; set; } = "GXObjectList:ColumnWidths";
    private readonly string _tableId = "gx-objects-" + Guid.NewGuid().ToString("N");
    private readonly Dictionary<string, double> _widths = new();
    private IJSObjectReference? _module;
    private IJSObjectReference? _resizer;
    private DotNetObjectReference<GXObjectList<TObject>>? _reference;
    private bool _loaded;
    private static string AttributeKey(int index) => $"attribute-{index}";
    private double Width(string key) => _widths.GetValueOrDefault(key, key == "name" ? 320 : 160);
    private string ColumnStyle(string key) => $"width:{Width(key).ToString(CultureInfo.InvariantCulture)}px";
    private string TableWidth(int[] columns) => (Width("name") + Width("type") + columns.Sum(index => Width(AttributeKey(index)))).ToString(CultureInfo.InvariantCulture);
    private static bool ValidKey(string key) => key is "name" or "type" || key.StartsWith("attribute-", StringComparison.Ordinal)
        && int.TryParse(key[10..], out var index) && index > 1;
    private RenderFragment ResizeHandle(string key, string label) => @<span class="column-resizer" role="separator" tabindex="0"
        aria-label="@($"Resize {label}")" aria-orientation="vertical" aria-valuemin="64" aria-valuemax="4096"
        aria-valuenow="@Width(key)" data-column="@key"></span>;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loaded)
        {
            _loaded = true;
            var saved = await Storage.GetValueAsync(ColumnWidthsKey);
            if (!string.IsNullOrWhiteSpace(saved))
            {
                try
                {
                    var values = JsonSerializer.Deserialize<Dictionary<string, double>>(saved);
                    if (values is not null)
                        foreach (var entry in values.Where(entry => ValidKey(entry.Key) && double.IsFinite(entry.Value) && entry.Value >= 64 && entry.Value <= 4096))
                            _widths[entry.Key] = entry.Value;
                }
                catch (JsonException) { }
            }
            StateHasChanged();
        }
        if (Objects.Count == 0)
        {
            if (_resizer is not null)
            {
                await _resizer.InvokeVoidAsync("dispose");
                await _resizer.DisposeAsync();
                _resizer = null;
            }
            return;
        }
        if (_resizer is null)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Gurux.DLMS.UI.Components/GXObjectList.razor.js");
            _reference ??= DotNetObjectReference.Create(this);
            _resizer = await _module.InvokeAsync<IJSObjectReference>("initialize", _tableId, _reference);
        }
    }

    [JSInvokable]
    public async Task SaveColumnWidthAsync(string key, double width)
    {
        if (!ValidKey(key) || !double.IsFinite(width) || width < 64 || width > 4096) return;
        _widths[key] = width;
        await Storage.SetValueAsync(ColumnWidthsKey, JsonSerializer.Serialize(_widths));
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_resizer is not null)
            {
                await _resizer.InvokeVoidAsync("dispose");
                await _resizer.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _reference?.Dispose(); }
    }
    [Parameter] public IReadOnlyList<TObject> Objects { get; set; } = [];
    [Parameter, EditorRequired] public Func<TObject, string> GetName { get; set; } = item => item?.ToString() ?? string.Empty;
    [Parameter, EditorRequired] public Func<TObject, string> GetLogicalName { get; set; } = _ => string.Empty;
    [Parameter, EditorRequired] public Func<TObject, string> GetObjectType { get; set; } = _ => string.Empty;
    [Parameter] public Func<TObject, IReadOnlyDictionary<int, string?>> GetAttributeValues { get; set; }
        = item => item is Gurux.DLMS.Objects.GXDLMSObject target ? Gurux.DLMS.UI.Components.Objects.GXDLMSAttributeValues.Get(target) : new Dictionary<int, string?>();
    [Parameter] public Func<TObject, bool>? IsSelected { get; set; }
    [Parameter] public EventCallback<TObject> OnSelect { get; set; }
    [Parameter] public EventCallback<TObject> OnActivate { get; set; }
    [Parameter] public string Title { get; set; } = "Objects";
    [Parameter] public string EmptyText { get; set; } = "No objects loaded.";
    private static string Icon(string name) => $"_content/Gurux.DLMS.UI.Components/images/icons/{name}.svg";
}
