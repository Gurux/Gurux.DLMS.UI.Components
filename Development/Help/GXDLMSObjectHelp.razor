@* <summary>Displays contextual help for the attributes and methods of a DLMS object.</summary> *@

@namespace Gurux.DLMS.UI.Components.Help
@using Gurux.DLMS.Objects
@using Gurux.UI.Components
@using Gurux.UI.Components.Help
@using HelpResources = Gurux.DLMS.UI.Components.Properties.Resources
@implements IDisposable

<CascadingValue TValue="string" Name="@GXHelpContext.ScopeName" Value="@((string)null!)" IsFixed="true">
    <GXHelpContext Topic="@_request.Topic" Version="@_request.Version" Culture="@_request.Culture" />
</CascadingValue>
<div class="gx-object-help">
<button type="button" class="gx-object-help-button" title="@HelpResources.HelpForCosemClass" @onclick="OpenAsync">@HelpResources.Help</button>
@if (_visible)
{
    <GXDialog Title="@HelpResources.CosemObjectHelp" OkButtonTitle="" CancelButtonTitle="@HelpResources.Close" Save="false"
              ManageFocus="true" Resizable="true" OnCancel="Close" class="gx-object-help-dialog" aria-label="@HelpResources.CosemObjectHelp">
        <div class="gx-object-help-content">
            @if (_markdown is not null)
            {
                <GXMarkdownView Content="@_markdown" />
            }
            else if (_error is not null)
            {
                <p role="alert">@_error</p>
            }
            else
            {
                <p role="status">@HelpResources.LoadingHelp</p>
            }
        </div>
    </GXDialog>
}

</div>

@code {
    /// <summary>The object whose class help is registered and displayed.</summary>
    [Parameter, EditorRequired] public GXDLMSObject Target { get; set; } = default!;
    private static readonly IGXHelpProvider Provider = new GXDLMSObjectHelpProvider();
    private GXHelpRequest _request = new(string.Empty);
    private string? _markdown;
    private string? _error;
    private bool _visible;
    private CancellationTokenSource? _loading;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        GXHelpRequest request = GXDLMSObjectHelpCatalog.GetRequest(Target);
        if (_request != request)
        {
            Close();
            _request = request;
            _markdown = null;
        }
    }

    private async Task OpenAsync()
    {
        if (_visible)
        {
            return;
        }
        _visible = true;
        _error = null;
        var loading = new CancellationTokenSource();
        _loading = loading;
        try
        {
            var help = Services.GetService<GXHelpService>();
            GXHelpContent? content = help == null
                ? await Provider.GetHelpAsync(_request, loading.Token)
                : await help.GetHelpAsync(_request, loading.Token);
            string? markdown = content?.Value;
            if (!loading.IsCancellationRequested)
            {
                _markdown = markdown;
                if (markdown is null)
                {
                    _error = HelpResources.CosemHelpUnavailable;
                }
            }
        }
        catch (OperationCanceledException) when (loading.IsCancellationRequested)
        {
        }
        catch (Exception error) when (error is IOException or InvalidOperationException or HttpRequestException or OperationCanceledException)
        {
            if (!loading.IsCancellationRequested)
            {
                _error = HelpResources.CosemHelpLoadFailed;
            }
        }
        finally
        {
            if (ReferenceEquals(_loading, loading))
            {
                _loading = null;
            }
            loading.Dispose();
        }
    }

    private void Close()
    {
        _visible = false;
        _loading?.Cancel();
        _loading = null;
    }

    /// <summary>Cancels any pending help load when the owning view is removed.</summary>
    public void Dispose()
    {
        Close();
    }
}
