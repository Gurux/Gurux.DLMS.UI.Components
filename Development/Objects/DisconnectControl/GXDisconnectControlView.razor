@* <summary>Displays and edits DLMS disconnect control values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.DLMS
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Objects.Enums
@using Gurux.UI.Components.Tab
@inherits GXDLMSObjectViewBase<GXDLMSDisconnectControl>

<section class="gx-object-view" @key="Target">
<GXObjectViewHeader Target="Target" Edit="Edit" Error="@ActionError" Title="Disconnect Control Object" />
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
{
<GXAttributeField Edit="Edit" Index="2" Label="Output State:" Enabled="CanEditAttribute(2)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
{
<GXAttributeField Edit="Edit" Index="3" Label="Control State:" Enabled="CanEditAttribute(3)" EnumType="typeof(ControlState)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
{
<GXAttributeField Edit="Edit" Index="4" Label="Control Mode:" Enabled="CanEditAttribute(4)" EnumType="typeof(ControlMode)" />
}
<GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="DisconnectAsync">Disconnect</GXButton>
<GXButton type="button" Disabled="@(!CanInvokeMethod(2))" OnClick="ReconnectAsync">Reconnect</GXButton>
</section>

@code {
    /// <summary>
    /// Requests remote disconnection of the controlled output.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task DisconnectAsync() => InvokeMethodAsync(1, client => Target.RemoteDisconnect(client));
    /// <summary>
    /// Requests remote reconnection of the controlled output.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task ReconnectAsync() => InvokeMethodAsync(2, client => Target.RemoteReconnect(client));
}




