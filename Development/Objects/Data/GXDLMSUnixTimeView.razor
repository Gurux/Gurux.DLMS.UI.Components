@* <summary>Displays a Unix-time data object as local date and time and supports writing the current time.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Task = System.Threading.Tasks.Task
@inherits GXDLMSObjectViewBase<GXDLMSData>

<section class="gx-object-view" @key="Target">
    @if (Edit.Error(2) is { } error) { <p role="alert">@error</p> }
    @if (_writeError is not null) { <p role="alert">@_writeError</p> }
    <GXObjectViewHeader Target="Target" Edit="Edit" Title="@Properties.Resources.DataObjectUnixTime" />
    <GXValueField Label="@Properties.Resources.TimeZoneLabel2" Value="@TimeZoneInfo.Local.DisplayName" Enabled="false" />
    <GXValueField Label="@Properties.Resources.LocalTimeLabel" Value="@LocalTimeText" Enabled="@(CanEditAttribute(2) && !_writing)" Validate="ValidateLocalTime" OnCommit="EditLocalTime" />
    <GXButton type="button" Disabled="@(!CanWriteCurrentTime)" OnClick="WriteCurrentTimeAsync">@Properties.Resources.WriteCurrentTime</GXButton>
    @if (!OnWriteRequested.HasDelegate) { <p>@Properties.Resources.ImmediateWritingIsNotAvailableForThisConnection</p> }
    @if (_written) { <p role="status">@Properties.Resources.CurrentTimeWritten</p> }
    @if (Edit.HasChanges) { <p role="status">@Properties.Resources.ValueChanged</p> }
</section>

@code {
    /// <summary>
    /// Standard logical name identifying the Unix-time data object.
    /// </summary>
    public const string UnixTimeLogicalName = "0.0.1.1.0.255";
    /// <summary>
    /// Callback receiving an attribute write request.
    /// </summary>
    [Parameter]
    public EventCallback<GXDLMSWriteRequest> OnWriteRequested
    {
        get; set;
    }
    /// <summary>
    /// Whether the current-time write action is offered.
    /// </summary>
    [Parameter] public bool WriteEnabled { get; set; } = true;
    /// <summary>Retains the previous model to clear operation state when the target changes.</summary>
    private GXDLMSData? _previousTarget;
    /// <summary>Prevents overlapping requests to write the current meter time.</summary>
    private bool _writing;
    /// <summary>Tracks whether the current-time write completed successfully.</summary>
    private bool _written;
    /// <summary>Stores the most recent current-time write failure shown in the view.</summary>
    private string? _writeError;
    /// <summary>
    /// Whether the current time can be written with the current access rights and callback.
    /// </summary>
    public bool CanWriteCurrentTime => !_writing && !ReadOnly && WriteEnabled && OnWriteRequested.HasDelegate && GXDLMSObjectAccess.CanWrite(Target, 2, Association);
    /// <summary>
    /// Gets the draft local timestamp, or the current object value formatted with its UTC offset.
    /// </summary>
    public string LocalTimeText => Edit.GetEditorText(nameof(GXDLMSUnixTimeView)) ?? FormatLocalTime(Edit.CurrentValue);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!ReferenceEquals(_previousTarget, Target))
        {
            _writeError = null;
            _written = false;
            _previousTarget = Target;
        }
    }

    /// <summary>
    /// Converts a Unix timestamp to local date and time with its UTC offset, or returns empty text for invalid values.
    /// </summary>
    /// <param name="value">Unix timestamp in seconds since the UTC epoch.</param>
    /// <returns>The local timestamp and UTC offset, or empty text for an invalid timestamp.</returns>
    public static string FormatLocalTime(object? value)
    {
        if (value is null)
        {
            return string.Empty;
        }
        try
        {
            var date = DateTimeOffset.FromUnixTimeSeconds(Convert.ToInt64(value, CultureInfo.InvariantCulture)).ToLocalTime();
            return string.Format(System.Globalization.CultureInfo.CurrentCulture, Properties.Resources.Text012, date.ToString("G", CultureInfo.CurrentCulture), date.ToString("zzz", CultureInfo.CurrentCulture));
        }
        catch (Exception ex) when (ex is FormatException or InvalidCastException or OverflowException or ArgumentOutOfRangeException)
        {
            return string.Empty;
        }
    }

    /// <summary>Checks the local date-time input and its representable meter epoch range.</summary>
    /// <param name="text">The user input in the editor&apos;s invariant text representation.</param>
    /// <returns>The validation message, or null when the input is valid.</returns>
    private string? ValidateLocalTime(string text)
    {
        if (!DateTimeOffset.TryParse(text, CultureInfo.CurrentCulture, DateTimeStyles.AllowWhiteSpaces | DateTimeStyles.AssumeLocal, out var date))
        {
            return Properties.Resources.EnterAValidLocalDateAndTime;
        }
        try
        {
            _ = MeterEpoch(date.UtcDateTime);
            return null;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException) { return ex.Message; }
    }
    /// <summary>Converts UTC time to the meter value&apos;s existing integer epoch representation.</summary>
    /// <param name="utc">The UTC instant to encode as the meter&apos;s epoch value.</param>
    /// <returns>Converts UTC time to the meter value&apos;s existing integer epoch representation.</returns>
    private object MeterEpoch(DateTime utc)
    {
        var epoch = GXDateTime.ToUnixTime(utc);
        var type = Target.GetDataType(2);
        return GXDLMSConverter.ChangeType(epoch, type == DataType.None ? DataType.UInt32 : type, CultureInfo.InvariantCulture);
    }

    /// <summary>
    /// Parses local date and time and stages its Unix timestamp using the meter data type.
    /// </summary>
    /// <param name="text">Local date and time text to parse.</param>
    public void EditLocalTime(string text)
    {
        if (!CanEditAttribute(2) || _writing)
        {
            return;
        }
        Edit.SetEditorText(nameof(GXDLMSUnixTimeView), text);
        _written = false;
        _writeError = null;
        if (!DateTimeOffset.TryParse(text, CultureInfo.CurrentCulture, DateTimeStyles.AllowWhiteSpaces | DateTimeStyles.AssumeLocal, out var date))
        {
            Edit.SetValueError(Properties.Resources.EnterAValidLocalDateAndTime);
            return;
        }
        try
        {
            Edit.EditMeterValue(MeterEpoch(date.UtcDateTime));
        }
        catch (Exception ex) when (ex is OverflowException or FormatException or InvalidCastException or ArgumentException)
        {
            Edit.SetValueError(Properties.Resources.TheDateIsOutsideTheMeterSSupportedRange);
        }
    }

    /// <summary>
    /// Writes the current UTC timestamp and accepts it after the write callback completes.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public async Task WriteCurrentTimeAsync()
    {
        if (!CanWriteCurrentTime)
        {
            return;
        }
        _writing = true;
        _written = false;
        _writeError = null;
        var target = Target;
        var session = Edit;
        try
        {
            var value = MeterEpoch(DateTime.UtcNow);
            await OnWriteRequested.InvokeAsync(new GXDLMSWriteRequest(target, 2, value));
            // The callback is responsible for awaiting the meter acknowledgement.
            session.AcceptValue(value);
            if (ReferenceEquals(Target, target))
            {
                _written = true;
            }
        }
        catch (Exception ex)
        {
            if (ReferenceEquals(Target, target))
            {
                _writeError = string.Format(System.Globalization.CultureInfo.CurrentCulture, Properties.Resources.WritingCurrentTimeFailed0, ex.Message);
            }
        }
        finally { _writing = false; }
    }
}
