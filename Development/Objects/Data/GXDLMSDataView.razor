@* <summary>Displays and edits DLMS data values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.DLMS.Objects
@inherits GXDLMSObjectViewBase<GXDLMSData>

<section class="gx-object-view">
    @if (Edit.Error(2) is { } error) { <p role="alert">@error</p> }
    <GXObjectViewHeader Target="Target" Edit="Edit" Title="Data Object" />
    <GXAttributeField Edit="Edit" Index="2" Label="Value" Enabled="CanEditAttribute(2)" Rows="@(Edit.IsXml ? 10 : 2)" />
    @if (Edit.HasChanges) { <p role="status">Value changed</p> }
</section>
