@* <summary>Displays and edits DLMS token gateway values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@inherits GXDLMSObjectViewBase<GXDLMSTokenGateway>

<section @key="Target" class="gx-object-view">
    <GXObjectViewHeader Title="Token Gateway Object" Target="Target" Edit="Edit" Error="@ActionError" />
    <GXAttributeField Edit="Edit" Index="2" InputKind="hex" Label="Token" Enabled="CanEditAttribute(2)" />
    <GXAttributeField Edit="Edit" Index="3" Label="Time" Enabled="CanEditAttribute(3)" />
    <GXAttributeField Edit="Edit" Index="4" InputKind="text" Label="Descriptions" Enabled="CanEditAttribute(4)" Columns="@(new[] { "Name" })" CreateRow="@(() => Array.Empty<byte>())" />
    <GXAttributeField Edit="Edit" Index="5" Label="Delivery Method" Enabled="CanEditAttribute(5)" EnumType="typeof(TokenDelivery)" />
    <GXAttributeField Edit="Edit" Index="6" Part="0" Label="Status code" Enabled="CanEditAttribute(6)" EnumType="typeof(TokenStatusCode)" />
    <GXAttributeField Edit="Edit" Index="6" Part="1" Label="Data Value" Enabled="CanEditAttribute(6)" />
    <fieldset><legend>Methods</legend>
    <GXValueField Label="Token (hexadecimal)" Value="@TokenHex" Enabled="@(CanInvokeMethod(1))" InputKind="hex" OnCommit="value => TokenHex = value" Validate="text => ValidateParameter(nameof(TokenHex), text)" />
    <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="EnterAsync">Transfer token</GXButton>
    </fieldset>
</section>

@code {
    /// <summary>
    /// Hexadecimal token entered for the token-gateway request.
    /// </summary>
    public string TokenHex { get; set; } = string.Empty;
    /// <summary>
    /// Requests processing of the entered token by the token gateway.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task EnterAsync() => InvokeMethodAsync(1, client =>
    {
        var bytes = Convert.FromHexString(TokenHex.Replace(" ", string.Empty));
        if (bytes.Length == 0)
        {
            throw new FormatException("Enter a token.");
        }
        return Target.Enter(client, bytes);
    });

    private static string? ValidateParameter(string field, string text)
    {
        try
        {
            switch (field)
            {
                case nameof(TokenHex):
                    {
                        if (Convert.FromHexString(text.Replace(" ", string.Empty)).Length == 0)
                        {
                            throw new FormatException("Enter a token.");
                        }
                        break;
                    }
            }
            return null;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException) { return ex.Message; }
    }
}
