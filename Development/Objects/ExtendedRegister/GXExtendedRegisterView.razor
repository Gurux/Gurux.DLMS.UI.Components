@* <summary>Displays and edits DLMS extended register values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@inherits GXDLMSObjectViewBase<GXDLMSExtendedRegister>

<section @key="Target" class="gx-object-view">
    <GXObjectViewHeader Title="Extended Register Object" Target="Target" Edit="Edit" Error="@ActionError" />
    <GXAttributeField Edit="Edit" Index="2" Label="Value" Enabled="CanEditAttribute(2)" />
    <GXAttributeField Edit="Edit" Index="3" Part="0" InputKind="scaler" Label="Scaler" Enabled="CanEditAttribute(3)" />
    <GXAttributeField Edit="Edit" Index="3" Part="1" Label="Unit" Enabled="CanEditAttribute(3)" EnumType="typeof(Unit)" />
    <GXAttributeField Edit="Edit" Index="4" Label="Status" Enabled="CanEditAttribute(4)" />
    <GXAttributeField Edit="Edit" Index="5" Label="Capture Time" Enabled="CanEditAttribute(5)" />
    <fieldset><legend>Methods</legend>
    <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="ResetAsync">Reset</GXButton>
    </fieldset>
</section>

@code {
    /// <summary>
    /// Requests execution of the target object's reset method.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task ResetAsync() => InvokeMethodAsync(1, client => Target.Reset(client));
}
