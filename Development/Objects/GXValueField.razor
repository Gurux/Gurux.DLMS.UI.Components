@* <summary>Displays a labeled value with validated editing and commit handling.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.UI.Components
@implements IDisposable

<div class="gx-value-field gx-field-row">
    <GXLabel for="@_displayId">@Label</GXLabel>
    <div class="gx-field-value">
        <GXDraftInput Id="@_displayId" Label="@Label" Value="@(Editing ? Draft : Value)" ValueChanged="ChangeInlineAsync" InputKind="@InputKind" EnumType="EnumType" Disabled="@(!Enabled)" />
        @if (Error is not null) { <p role="alert">@Error</p> }
    </div>
</div>
