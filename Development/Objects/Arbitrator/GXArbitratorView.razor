@* <summary>Displays and edits DLMS arbitrator values and supported actions.</summary> *@

@using Gurux.UI.Components
@using Gurux.UI.Components.Table
@using Microsoft.AspNetCore.Components.Web.Virtualization
@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@inherits GXDLMSObjectViewBase<GXDLMSArbitrator>

<section @key="Target" class="gx-object-view">
    <GXObjectViewHeader Title="@Properties.Resources.ArbitratorObject" Target="Target" Edit="Edit" Error="@ActionError" />
    <fieldset><legend>@Properties.Resources.Actions</legend>
    <GXTable @key="ArbitratorKey" TItem="int" ItemsProvider="GetActionRows" Save="false" ShowAllData="true" Total="false" Filter="false" Menu="false" CanEdit="false">
        <HeaderContent><GXTh TItem="int" Name="Script">@Properties.Resources.Script</GXTh><GXTh TItem="int" Name="Selector">@Properties.Resources.Selector</GXTh><GXTh TItem="int" Name="Allowed">@Properties.Resources.Allowed</GXTh><GXTh TItem="int" Name="Weightings">@Properties.Resources.Weightings</GXTh><GXTh TItem="int" Name="Recent">@Properties.Resources.MostRecent</GXTh></HeaderContent>
        <ItemContent Context="row">@foreach (var cell in ActionCells(row)) { <GXTd>@cell</GXTd> }</ItemContent>
    </GXTable>
    <GXAttributeField Edit="Edit" Index="2" Label="@Properties.Resources.Scripts" Enabled="CanEditAttribute(2)" Columns="@(new[] { Properties.Resources.Script, Properties.Resources.Selector })" CreateRow="@(() => new GXStructure { new byte[6], (ushort)0 })" />
    <GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.Allowed" Enabled="CanEditAttribute(3)" Columns="@(new[] { Properties.Resources.Allowed })" CreateRow="@(() => new GXBitString("0"))" />
    <GXAttributeField Edit="Edit" Index="4" Label="@Properties.Resources.Weightings" Enabled="CanEditAttribute(4)" Columns="@(new[] { Properties.Resources.Weightings })" CreateRow="@(() => new GXArray { (ushort)0 })" />
    <GXAttributeField Edit="Edit" Index="5" Label="@Properties.Resources.MostRecent" Enabled="CanEditAttribute(5)" Columns="@(new[] { Properties.Resources.MostRecent })" CreateRow="@(() => new GXBitString("0"))" />
    </fieldset>
    <GXAttributeField Edit="Edit" Index="6" Label="@Properties.Resources.LastOutcome" Enabled="CanEditAttribute(6)" />
    <fieldset><legend>@Properties.Resources.Methods</legend>
    <GXValueField Label="@Properties.Resources.Actor0255" Value="@Actor" Enabled="@(CanInvokeMethod(1))" InputKind="number" OnCommit="value => Actor = value" Validate="text => ValidateParameter(nameof(Actor), text)" />
    <GXValueField Label="@Properties.Resources.ActionsBinaryBitString" Value="@RequestedActions" Enabled="@(CanInvokeMethod(1))" InputKind="text" OnCommit="value => RequestedActions = value" Validate="text => ValidateParameter(nameof(RequestedActions), text)" />
    <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="RequestAsync">@Properties.Resources.RequestAction</GXButton>
    <GXButton type="button" Disabled="@(!CanInvokeMethod(2))" OnClick="ResetAsync">@Properties.Resources.Reset</GXButton>
    </fieldset>
</section>

@code {
    /// <summary>
    /// Actor identifier entered for the arbitration request.
    /// </summary>
    public string Actor { get; set; } = string.Empty;
    /// <summary>
    /// Requested action bit string entered for arbitration.
    /// </summary>
    public string RequestedActions { get; set; } = string.Empty;
    /// <summary>
    /// Requests arbitration using the entered actor and action bit string.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task RequestAsync() => InvokeMethodAsync(1, client =>
    {
        if (string.IsNullOrEmpty(RequestedActions) || RequestedActions.Any(c => c != '0' && c != '1'))
        {
            throw new FormatException(Properties.Resources.EnterTheRequestedActionsAsABinaryBitString);
        }
        return Target.RequestAction(client, byte.Parse(Actor, CultureInfo.InvariantCulture), RequestedActions);
    });
    /// <summary>
    /// Requests execution of the target object's reset method.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task ResetAsync() => InvokeMethodAsync(2, client => Target.Reset(client));

    /// <summary>Checks a method input and returns a validation message instead of throwing.</summary>
    /// <param name="field">The input identifier selecting the parameter validation rules.</param>
    /// <param name="text">The user input in the editor&apos;s invariant text representation.</param>
    /// <returns>The validation message, or null when the input is valid.</returns>
    private static string? ValidateParameter(string field, string text)
    {
        try
        {
            switch (field)
            {
                case nameof(Actor):
                    {
                        byte.Parse(text, CultureInfo.InvariantCulture);
                        break;
                    }
                case nameof(RequestedActions):
                    {
                        CheckBits(text);
                        break;
                    }
            }
            return null;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException) { return ex.Message; }
    }

    /// <summary>Rejects input containing characters other than binary zero and one.</summary>
    /// <param name="text">The user input in the editor&apos;s invariant text representation.</param>
    private static void CheckBits(string text)
    {
        if (string.IsNullOrEmpty(text) || text.Any(c => c != '0' && c != '1'))
        {
            throw new FormatException(Properties.Resources.EnterABinaryBitString);
        }
    }
    /// <summary>Gets a render key covering the arbitrator&apos;s pending action attributes.</summary>
    private string ArbitratorKey => string.Join("|", Enumerable.Range(2, 4).Select(Edit.AttributeText));
    /// <summary>Gets the maximum row count across the related arbitrator action tables.</summary>
    private int ActionRowCount => Enumerable.Range(2, 4).Select(i => Edit.AttributeRows(i).Count()).DefaultIfEmpty(0).Max();
    /// <summary>Supplies arbitrator action row indices and their total count.</summary>
    /// <param name="request">The table request; this provider returns the complete current row set.</param>
    /// <returns>The current table rows together with their total count.</returns>
    private ValueTask<ItemsProviderResult<int>> GetActionRows(GXItemsProviderRequest request) => ValueTask.FromResult(new ItemsProviderResult<int>(Enumerable.Range(0, ActionRowCount), ActionRowCount));
    /// <summary>Formats one arbitrator action row across the related attribute tables.</summary>
    /// <param name="row">The zero-based row index in the current table.</param>
    /// <returns>The formatted text for the supplied value.</returns>
    private IEnumerable<string> ActionCells(int row)
    {
        var action = Edit.AttributeRows(2).ElementAtOrDefault(row);
        return [action?.ElementAtOrDefault(0) ?? "", action?.ElementAtOrDefault(1) ?? "", string.Join(", ", Edit.AttributeRows(3).ElementAtOrDefault(row) ?? []), string.Join(", ", Edit.AttributeRows(4).ElementAtOrDefault(row) ?? []), string.Join(", ", Edit.AttributeRows(5).ElementAtOrDefault(row) ?? [])];
    }
}
