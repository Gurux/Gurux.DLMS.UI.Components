@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSAutoConnect>


<section class="gx-network-view">
<fieldset class="gx-object-fields"><legend>Auto Connect Object</legend>
<GXObjectViewHeader Title="@string.Empty" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="Mode:" Enabled="CanEditAttribute(2)" EnumType="typeof(AutoConnectMode)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="Repetitions:" Enabled="CanEditAttribute(3)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Repetition Delay:" Enabled="CanEditAttribute(4)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="Calling Window:" Enabled="CanEditAttribute(5)" Columns='@(new[] { "Start Time:", "End Time:" })' CreateRow='@(() => new GXStructure { new byte[] { 255, 255, 1, 1, 255, 0, 0, 0, 0, 128, 0, 0 }, new byte[] { 255, 255, 1, 1, 255, 0, 0, 0, 0, 128, 0, 0 } })' />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
    {
        <GXAttributeField Edit="Edit" Index="6" Label="Destination:" Enabled="CanEditAttribute(6)" Columns='@(new[] { "Destination:" })' CreateRow='@(() => Target.Version == 0 ? (object)string.Empty : Array.Empty<byte>())' />
    }
</fieldset>
</section>
<section class="gx-object-actions"><GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="ConnectAsync">Connect</GXButton></section>
@code {
    private Task ConnectAsync() => InvokeMethodAsync(1, client => Target.Connect(client));
}

