@* <summary>Displays and edits DLMS prime nb ofdm plc applications identification values and supported actions.</summary> *@

@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSPrimeNbOfdmPlcApplicationsIdentification>


<section class="gx-network-view">
<div class="gx-view-content">
<GXObjectViewHeader Title="PRIME NB OFDM PLC Application identification Object" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="Firmware Version:" Enabled="CanEditAttribute(2)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="Vendor ID:" Enabled="CanEditAttribute(3)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Product ID:" Enabled="CanEditAttribute(4)"  />
    }
</div>
</section>
