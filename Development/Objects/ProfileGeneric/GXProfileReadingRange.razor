@* <summary>Edits a nullable local-time interval shared by profile reads and host-managed history.</summary> *@
@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.UI.Components

<fieldset class="gx-profile-reading-range">
    <legend>@Properties.Resources.Reading</legend>
    <label>@Properties.Resources.ReadFrom
        <GXDateTimeSelector TItem="DateTime?" class="gx-profile-range-start" Value="Start" ValueChanged="StartChanged" Disabled="Disabled" Save="false" />
    </label>
    <label>@Properties.Resources.To
        <GXDateTimeSelector TItem="DateTime?" class="gx-profile-range-end" Value="End" ValueChanged="EndChanged" Disabled="Disabled" Save="false" />
    </label>
</fieldset>

@code {
    /// <summary>Gets or sets the local start of the requested interval, or null when cleared.</summary>
    [Parameter] public DateTime? Start { get; set; }
    /// <summary>Gets or sets the callback receiving changes to the local start, including a cleared value.</summary>
    [Parameter] public EventCallback<DateTime?> StartChanged { get; set; }
    /// <summary>Gets or sets the local end of the requested interval, or null when cleared.</summary>
    [Parameter] public DateTime? End { get; set; }
    /// <summary>Gets or sets the callback receiving changes to the local end, including a cleared value.</summary>
    [Parameter] public EventCallback<DateTime?> EndChanged { get; set; }
    /// <summary>Gets or sets whether both date and time inputs are disabled.</summary>
    [Parameter] public bool Disabled { get; set; }
}
