@* <summary>Displays and edits DLMS profile generic values and supported actions.</summary> *@

@using Gurux.UI.Components
@using Gurux.UI.Components.Table
@using Gurux.UI.Components.Tab
@using Microsoft.AspNetCore.Components.Web.Virtualization
@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@inherits GXDLMSObjectViewBase<GXDLMSProfileGeneric>
@inject IServiceProvider Services

<section @key="Target" class="gx-object-view">
    <GXObjectViewHeader Title="@Properties.Resources.ProfileGeneric" Target="Target" Edit="Edit" Error="@ActionError" />
    <GXAttributeField Edit="Edit" Index="4" Label="@Properties.Resources.Period" Enabled="CanEditAttribute(4)" />
    <GXAttributeField Edit="Edit" Index="7" Label="@Properties.Resources.EntriesInUse" Enabled="CanEditAttribute(7)" />
    <GXAttributeField Edit="Edit" Index="8" Label="@Properties.Resources.Entries" Enabled="CanEditAttribute(8)" />
    <fieldset><legend>@Properties.Resources.Sort</legend>
        <GXAttributeField Edit="Edit" Index="5" Label="@Properties.Resources.Mode" Enabled="CanEditAttribute(5)" EnumType="typeof(SortMethod)" />
        <GXAttributeField Edit="Edit" Index="6" EditorLabels="@(new[] { Properties.Resources.ObjectType, Properties.Resources.LogicalName, Properties.Resources.AttributeIndex, Properties.Resources.DataIndex })" Label="@Properties.Resources.Object" Enabled="CanEditAttribute(6)" />
    </fieldset>
    @if (RangeOnly)
    {
        <GXProfileReadingRange Start="RangeStart" StartChanged="ChangeRangeStartAsync" End="RangeEnd" EndChanged="ChangeRangeEndAsync" Disabled="@_reading" />
    }
    else
    {
        <fieldset><legend>@Properties.Resources.Reading</legend>
            <GXValueField Label="@Properties.Resources.Read" Value="@ReadingMode" Enabled="@(!ReadOnly && !_reading)" EnumType="typeof(GXProfileReadMode)" OnCommit="value => ReadingMode = value" />
            <GXValueField Label="@Properties.Resources.ReadLastDays" Value="@LastDays" Enabled="@(!ReadOnly && !_reading && ReadingMode == nameof(GXProfileReadMode.LastDays))" InputKind="number" Validate="ValidateUnsigned" OnCommit="value => LastDays = value" />
            <GXValueField Label="@Properties.Resources.ReadFrom" Value="@From" Enabled="@(!ReadOnly && !_reading && ReadingMode == nameof(GXProfileReadMode.Range))" InputKind="datetime" Validate="ValidateDate" OnCommit="value => From = value" />
            <GXValueField Label="@Properties.Resources.To" Value="@To" Enabled="@(!ReadOnly && !_reading && ReadingMode == nameof(GXProfileReadMode.Range))" InputKind="datetime" Validate="ValidateDate" OnCommit="value => To = value" />
            <GXValueField Label="@Properties.Resources.ReadEntry" Value="@EntryStart" Enabled="@(!ReadOnly && !_reading && ReadingMode == nameof(GXProfileReadMode.Entry))" InputKind="number" Validate="ValidateUnsigned" OnCommit="value => EntryStart = value" />
            <GXValueField Label="@Properties.Resources.Count" Value="@EntryCount" Enabled="@(!ReadOnly && !_reading && ReadingMode == nameof(GXProfileReadMode.Entry))" InputKind="number" Validate="ValidateUnsigned" OnCommit="value => EntryCount = value" />
        </fieldset>
    }
    <GXTabControl NavigateOnSelection="false">
    <GXTabPage Text="@Properties.Resources.Data">
    <div class="gx-profile-scroll">
    <GXTable @key="Edit.AttributeText(2)" TItem="IReadOnlyList<string>" ItemsProvider="GetBufferRows" Save="false" ShowAllData="true" Total="false" Filter="false" Menu="false" CanEdit="false">
        <HeaderContent>
        @foreach (var capture in CaptureObjects())
        {
            <GXTh TItem="IReadOnlyList<string>" Name="@($"{capture.Key.LogicalName}/{capture.Value.AttributeIndex}/{capture.Value.DataIndex}")">@CaptureLabel(capture.Key, capture.Value.AttributeIndex)<br />@(capture.Value.DataIndex == 0
                ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Properties.Resources.Text0Attribute1, capture.Key.LogicalName, capture.Value.AttributeIndex)
                : string.Format(System.Globalization.CultureInfo.CurrentCulture, Properties.Resources.CaptureObjectAttributeAndData, capture.Key.LogicalName, capture.Value.AttributeIndex, capture.Value.DataIndex))</GXTh>
        }
        </HeaderContent>
        <ItemContent Context="row">@foreach (var cell in row) { <GXTd>@cell</GXTd> }</ItemContent>
    </GXTable></div>
    </GXTabPage>
    <GXTabPage Text="@Properties.Resources.CaptureObjects">
        <GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.CaptureObjects" Enabled="CanEditAttribute(3)" Columns="@(new[] { Properties.Resources.ObjectType2, Properties.Resources.LogicalName, Properties.Resources.AttributeIndex, Properties.Resources.DataIndex })" EditorKinds="@(new[] { "number", "logicalname", "number", "number" })" CreateRow="@(() => new GXStructure { (ushort)1, new byte[6], (sbyte)2, (ushort)0 })" />
    </GXTabPage>
    </GXTabControl>
    <GXButton type="button" Disabled="@(_confirmingReset || !CanInvokeMethod(1))" OnClick="ResetAsync">@Properties.Resources.Reset</GXButton>
    <GXButton type="button" Disabled="@(!CanInvokeMethod(2))" OnClick="CaptureAsync">@Properties.Resources.Capture</GXButton>
</section>

@code {
    /// <summary>Gets or sets whether reading is restricted to the bound From-To interval; other read modes remain available by default. Query boundaries remain editable when object editing is read-only.</summary>
    [Parameter] public bool RangeOnly { get; set; }
    /// <summary>Gets or sets the local range start used in range-only mode; null represents a cleared input.</summary>
    [Parameter] public DateTime? RangeStart { get; set; } = DateTime.Today;
    /// <summary>Gets or sets the callback notified when the range-only start changes.</summary>
    [Parameter] public EventCallback<DateTime?> RangeStartChanged { get; set; }
    /// <summary>Gets or sets the local range end used in range-only mode; null represents a cleared input.</summary>
    [Parameter] public DateTime? RangeEnd { get; set; } = DateTime.Today.AddDays(1);
    /// <summary>Gets or sets the callback notified when the range-only end changes.</summary>
    [Parameter] public EventCallback<DateTime?> RangeEndChanged { get; set; }

    /// <summary>Stages the local start and notifies the host without substituting a value for a cleared input.</summary>
    /// <param name="value">The local interval start, or null when cleared.</param>
    /// <returns>The completion of the host notification.</returns>
    private async Task ChangeRangeStartAsync(DateTime? value)
    {
        RangeStart = value;
        await RangeStartChanged.InvokeAsync(value);
    }

    /// <summary>Stages the local end and notifies the host without substituting a value for a cleared input.</summary>
    /// <param name="value">The local interval end, or null when cleared.</param>
    /// <returns>The completion of the host notification.</returns>
    private async Task ChangeRangeEndAsync(DateTime? value)
    {
        RangeEnd = value;
        await RangeEndChanged.InvokeAsync(value);
    }

    /// <summary>Enumerates the profile&apos;s pending or confirmed capture-object descriptors.</summary>
    /// <returns>Enumerates the profile&apos;s pending or confirmed capture-object descriptors.</returns>
    private IEnumerable<GXKeyValuePair<GXDLMSObject, GXDLMSCaptureObject>> CaptureObjects()
    {
        if (!Target.GetDirty(3, out var pending))
        {
            return Target.CaptureObjects;
        }
        var current = (GXDLMSProfileGeneric)Target.Clone();
        ((IGXDLMSBase)current).SetValue(new GXDLMSSettings(), new ValueEventArgs(current, 3, 0, null) { Value = pending, User = true });
        return current.CaptureObjects;
    }
    /// <summary>Builds a readable object-and-attribute caption for a profile capture column.</summary>
    /// <param name="target">The DLMS object whose attribute or method is selected.</param>
    /// <param name="index">The one-based COSEM attribute or method index.</param>
    /// <returns>A readable object-and-attribute caption for a profile capture column.</returns>
    private static string CaptureLabel(GXDLMSObject target, int index)
    {
        var names = (target as IGXDLMSBase)?.GetNames();
        var attribute = names is not null && index > 0 && index <= names.Length ? names[index - 1] : string.Format(System.Globalization.CultureInfo.CurrentCulture, Properties.Resources.Attribute0, index);
        return string.Format(System.Globalization.CultureInfo.CurrentCulture, Properties.Resources.Text01, string.IsNullOrEmpty(target.Description) ? target.ObjectType.ToString() : target.Description, attribute);
    }
    /// <summary>
    /// Requests execution of the target object's reset method.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public async Task ResetAsync()
    {
        if (_confirmingReset || !CanInvokeMethod(1))
        {
            return;
        }
        var target = Target;
        _confirmingReset = true;
        try
        {
            if (Services.GetService(typeof(IGXConfirmation)) is IGXConfirmation confirmation
                && !await confirmation.ConfirmAsync(Properties.Resources.Reset, Properties.Resources.ResetProfileClearsBuffer))
            {
                return;
            }
            if (!ReferenceEquals(Target, target) || !CanInvokeMethod(1))
            {
                return;
            }
            await InvokeMethodAsync(1, client => target.Reset(client));
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            if (!IsDisposed && ReferenceEquals(Target, target))
            {
                ActionError = ex.Message;
            }
        }
        finally { _confirmingReset = false; }
    }
    /// <summary>Prevents overlapping reset confirmations and requests.</summary>
    private bool _confirmingReset;
    /// <summary>
    /// Requests capture of the target object's current values.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task CaptureAsync() => InvokeMethodAsync(2, client => Target.Capture(client));
    /// <summary>
    /// Callback receiving the requested attributes or profile selection.
    /// </summary>
    [Parameter]
    public EventCallback<GXProfileReadRequest> OnReadRequested
    {
        get; set;
    }
    /// <summary>
    /// Profile read mode selected by the user.
    /// </summary>
    public string ReadingMode { get => RangeOnly ? nameof(GXProfileReadMode.Range) : Edit.GetEditorText("Profile.ReadMode") ?? nameof(GXProfileReadMode.All); set => Edit.SetEditorText("Profile.ReadMode", Enum.Parse<GXProfileReadMode>(value).ToString()); }
    /// <summary>
    /// Number of recent days entered for a relative profile read.
    /// </summary>
    public string LastDays { get => Edit.GetEditorText("Profile.LastDays") ?? "1"; set => Edit.SetEditorText("Profile.LastDays", value); }
    /// <summary>
    /// Start timestamp entered for a profile range read.
    /// </summary>
    public string From { get => Edit.GetEditorText("Profile.From") ?? DateTime.Today.ToString("s", CultureInfo.InvariantCulture); set => Edit.SetEditorText("Profile.From", value); }
    /// <summary>
    /// End timestamp entered for a profile range read.
    /// </summary>
    public string To { get => Edit.GetEditorText("Profile.To") ?? DateTime.Today.AddDays(1).ToString("s", CultureInfo.InvariantCulture); set => Edit.SetEditorText("Profile.To", value); }
    /// <summary>
    /// First entry index entered for a profile entry read.
    /// </summary>
    public string EntryStart { get => Edit.GetEditorText("Profile.EntryStart") ?? "1"; set => Edit.SetEditorText("Profile.EntryStart", value); }
    /// <summary>
    /// Number of profile entries requested; zero requests the remaining entries.
    /// </summary>
    public string EntryCount { get => Edit.GetEditorText("Profile.EntryCount") ?? "0"; set => Edit.SetEditorText("Profile.EntryCount", value); }
    /// <summary>Prevents overlapping read requests while a host callback is running.</summary>
    private bool _reading;
    /// <summary>Gets whether the current state permits a host-managed profile read.</summary>
    private bool CanRead => !IsDisposed && !_reading && !ReadOnly && ActionsEnabled && OnReadRequested.HasDelegate;
    /// <summary>Checks that the input represents an unsigned 32-bit number.</summary>
    /// <param name="value">The input value to convert, format or stage.</param>
    /// <returns>The validation message, or null when the input is valid.</returns>
    private static string? ValidateUnsigned(string value) => uint.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out _) ? null : Properties.Resources.EnterAnUnsigned32BitNumber;
    /// <summary>Checks that the input represents an invariant date and time.</summary>
    /// <param name="value">The input value to convert, format or stage.</param>
    /// <returns>The validation message, or null when the input is valid.</returns>
    private static string? ValidateDate(string value) => DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.None, out _) ? null : Properties.Resources.EnterAValidDateAndTime;
    /// <summary>Supplies the profile&apos;s buffered rows and their total count to the table.</summary>
    /// <param name="request">The table request; this provider returns the complete current row set.</param>
    /// <returns>The current table rows together with their total count.</returns>
    private ValueTask<ItemsProviderResult<IReadOnlyList<string>>> GetBufferRows(GXItemsProviderRequest request)
    {
        var rows = GXProfileBufferFormatter.For(Target).GetRows().ToArray();
        return ValueTask.FromResult(new ItemsProviderResult<IReadOnlyList<string>>(rows, rows.Length));
    }
    /// <summary>Validates the active selection and builds a request for the host's Read command.</summary>
    /// <returns>The profile read request using the selected mode and local interval.</returns>
    /// <exception cref="FormatException">The mode or required range boundaries are invalid.</exception>
    public GXProfileReadRequest CreateReadRequest()
    {
        var mode = Enum.Parse<GXProfileReadMode>(ReadingMode);
        if (!Enum.IsDefined(mode))
        {
            throw new FormatException(Properties.Resources.ChooseAReadingMode);
        }
        if (RangeOnly && (RangeStart == null || RangeEnd == null))
        {
            throw new FormatException(Properties.Resources.EnterAValidDateAndTime);
        }
        var start = mode == GXProfileReadMode.Range ? RangeOnly ? RangeStart!.Value : DateTime.Parse(From, CultureInfo.InvariantCulture) : default;
        var end = mode == GXProfileReadMode.Range ? RangeOnly ? RangeEnd!.Value : DateTime.Parse(To, CultureInfo.InvariantCulture) : default;
        if (mode == GXProfileReadMode.Range && (start > end || (RangeOnly && start == end)))
        {
            throw new FormatException(Properties.Resources.ReadFromMustNotFollowTo);
        }
        return new GXProfileReadRequest(Target, mode,
            mode == GXProfileReadMode.LastDays ? uint.Parse(LastDays, CultureInfo.InvariantCulture) : 0,
            start, end,
            mode == GXProfileReadMode.Entry ? uint.Parse(EntryStart, CultureInfo.InvariantCulture) : 0,
            mode == GXProfileReadMode.Entry ? uint.Parse(EntryCount, CultureInfo.InvariantCulture) : 0);
    }
    /// <summary>
    /// Validates the profile selection and emits a profile read request.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public async Task ReadAsync()
    {
        if (!CanRead)
        {
            return;
        }
        _reading = true;
        var target = Target;
        try
        {
            ActionError = null;
            await OnReadRequested.InvokeAsync(CreateReadRequest());
        }
        catch (Exception ex) when (ex is not OutOfMemoryException) { if (!IsDisposed && ReferenceEquals(Target, target)) { ActionError = ex.Message; } }
        finally { _reading = false; }
    }
}
