@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSSFSKMacSynchronizationTimeouts>


<section class="gx-network-view">
<fieldset class="gx-object-fields"><legend>S-FSK MAC synchronization timeouts Object</legend>
<GXObjectViewHeader Title="@string.Empty" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="Search initiator timeout:" Enabled="CanEditAttribute(2)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="Confirmation Timeout:" Enabled="CanEditAttribute(3)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Timeout not addressed:" Enabled="CanEditAttribute(4)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="Timeuout frame not OK:" Enabled="CanEditAttribute(5)"  />
    }
</fieldset>
</section>
