@* <summary>Displays and edits DLMS push setup values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.DLMS
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Objects.Enums
@using Gurux.UI.Components.Tab
@inherits GXDLMSObjectViewBase<GXDLMSPushSetup>

<section class="gx-object-view" @key="Target">
<GXObjectViewHeader Target="Target" Edit="Edit" Error="@ActionError" Title="@Properties.Resources.PushObject" />
<GXTabControl NavigateOnSelection="false">
<GXTabPage Text="@Properties.Resources.General">
<fieldset><legend>@Properties.Resources.SendDestinationAndMethod</legend>
<GXValueField Label="@Properties.Resources.ServiceLabel" Value="@SelectedService.ToString()" Enabled="CanEditAttribute(3)" EnumType="typeof(ServiceType)" Validate="@(value => Enum.TryParse<ServiceType>(value, out var service) ? ValidateDestination(service, DestinationText, SelectedMessage) : Properties.Resources.ChooseASupportedService)" OnCommit="@((string value) => { if (CanEditAttribute(3)) { SelectedService = Enum.Parse<ServiceType>(value); } })" />
<GXValueField Label="@Properties.Resources.DestinationLabel" Value="@DestinationText" Enabled="CanEditAttribute(3)" Validate="@(value => ValidateDestination(SelectedService, value, SelectedMessage))" OnCommit="@((string value) => { if (CanEditAttribute(3)) { DestinationText = value; } })" />
<GXValueField Label="@Properties.Resources.MessageLabel" Value="@SelectedMessage.ToString()" Enabled="CanEditAttribute(3)" EnumType="typeof(MessageType)" Validate="@(value => Enum.TryParse<MessageType>(value, out var message) ? ValidateDestination(SelectedService, DestinationText, message) : Properties.Resources.ChooseASupportedMessage)" OnCommit="@((string value) => { if (CanEditAttribute(3)) { SelectedMessage = Enum.Parse<MessageType>(value); } })" />
</fieldset>
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
{
<GXAttributeField Edit="Edit" Index="5" Label="@Properties.Resources.RandomisationLabel" Enabled="CanEditAttribute(5)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
{
<GXAttributeField Edit="Edit" Index="6" Label="@Properties.Resources.NumberOfRetriesLabel" Enabled="CanEditAttribute(6)" />
}
@if (Target.Version < 2)
{
<GXAttributeField Edit="Edit" Index="7" Label="@Properties.Resources.RepetitionDelayLabel2" Enabled="CanEditAttribute(7)" />
}
else
{
<fieldset><legend>@Properties.Resources.RepetitionDelayLabel2</legend>
<GXAttributeField Edit="Edit" Index="7" Label="@Properties.Resources.MinLabel" Enabled="CanEditAttribute(7)" Part="0" />
<GXAttributeField Edit="Edit" Index="7" Label="@Properties.Resources.ExponentLabel" Enabled="CanEditAttribute(7)" Part="1" />
<GXAttributeField Edit="Edit" Index="7" Label="@Properties.Resources.MaxLabel" Enabled="CanEditAttribute(7)" Part="2" />
</fieldset>
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 8)
{
<GXAttributeField Edit="Edit" Index="8" Label="@Properties.Resources.PortReferenceLabel" Enabled="CanEditAttribute(8)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 9)
{
<GXAttributeField Edit="Edit" Index="9" Label="@Properties.Resources.PushClientSAPLabel" Enabled="CanEditAttribute(9)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 10)
{
<GXAttributeField Edit="Edit" Index="10" Label="@Properties.Resources.PushProtectionParametersLabel" Enabled="CanEditAttribute(10)" Columns="@(new[] { Properties.Resources.ProtectionType, Properties.Resources.TransactionID, Properties.Resources.OriginatorSystemTitle, Properties.Resources.RecipientSystemTitle, Properties.Resources.OtherInformation, Properties.Resources.KeyInfo })" ColumnPaths="@(new[] { "0", "1.0", "1.1", "1.2", "1.3", "1.4" })" CreateRow="CreateProtectionParameter" EditorKinds="@(new[] { "number", "hex", "hex", "hex", "hex", "text" })" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 11)
{
<GXAttributeField Edit="Edit" Index="11" Label="@Properties.Resources.OperationMethodLabel" Enabled="CanEditAttribute(11)" EnumType="typeof(PushOperationMethod)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 12)
{
<fieldset><legend>@Properties.Resources.ConfirmationParameters</legend>
<GXAttributeField Edit="Edit" Index="12" Label="@Properties.Resources.StartDateLabel" Enabled="CanEditAttribute(12)" Part="0" />
<GXAttributeField Edit="Edit" Index="12" Label="@Properties.Resources.IntervalLabel" Enabled="CanEditAttribute(12)" Part="1" />
</fieldset>
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 13)
{
<GXAttributeField Edit="Edit" Index="13" Label="@Properties.Resources.LastConfirmationLabel" Enabled="CanEditAttribute(13)" />
}
</GXTabPage>
<GXTabPage Text="@Properties.Resources.Objects">
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
{
<GXAttributeField Edit="Edit" Index="2" Label="@Properties.Resources.Objects" Enabled="CanEditAttribute(2)" Columns="@(new[] { Properties.Resources.Type, Properties.Resources.LogicalName3, Properties.Resources.AttributeIndex, Properties.Resources.DataIndex2 })" ColumnIndices="@(new[] { 0, 1, 2, 3 })" CreateRow="CreatePushObject" EditorLabels="PushObjectEditorLabels" EditorKinds="@(new[] { "number", "logicalname", "number", "number", "text", "text" })" EditorPathLabels="PushObjectPathLabels" EditorPathKinds="_pushObjectPathKinds" EditorPathFactories="_pushObjectPathFactories" />
}
</GXTabPage>
<GXTabPage Text="@Properties.Resources.CommunicationWindow">
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
{
<GXAttributeField Edit="Edit" Index="4" Label="@Properties.Resources.CommunicationWindow" Enabled="CanEditAttribute(4)" Columns="@(new[] { Properties.Resources.Start, Properties.Resources.End })" CreateRow="@(() => new GXStructure { GXDLMSTranslator.HexToBytes(new GXDateTime(DateTime.Now).ToHex(false, false)), GXDLMSTranslator.HexToBytes(new GXDateTime(DateTime.Now).ToHex(false, false)) })" EditorKinds="@(new[] { "datetime", "datetime" })" />
}
</GXTabPage>
</GXTabControl>
<GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="PushAsync">@Properties.Resources.Push</GXButton>
@if (Target.Version > 1) { <GXButton type="button" Disabled="@(!CanInvokeMethod(2))" OnClick="ResetAsync">@Properties.Resources.Reset</GXButton> }
</section>

@code {
    /// <summary>Gets the push-object descriptor captions supported by the current object version.</summary>
    private string[] PushObjectEditorLabels => Target.Version switch
    {
        0 => [Properties.Resources.Type, Properties.Resources.LogicalName3, Properties.Resources.AttributeIndex, Properties.Resources.DataIndex2],
        1 => [Properties.Resources.Type, Properties.Resources.LogicalName3, Properties.Resources.AttributeIndex, Properties.Resources.DataIndex2, Properties.Resources.Restriction],
        _ => [Properties.Resources.Type, Properties.Resources.LogicalName3, Properties.Resources.AttributeIndex, Properties.Resources.DataIndex2, Properties.Resources.Restriction, Properties.Resources.ColumnSelection]
    };
    /// <summary>Creates nested restriction and column-selection structures for push objects.</summary>
    private static readonly IReadOnlyDictionary<string, Func<object>> _pushObjectPathFactories = new Dictionary<string, Func<object>>
    {
        ["5"] = () => new GXStructure { (ushort)ObjectType.Data, new byte[6], (sbyte)2, (ushort)0 }
    };
    /// <summary>Maps nested push-object descriptor paths to field captions.</summary>
    private static IReadOnlyDictionary<string, string> PushObjectPathLabels => new Dictionary<string, string>
    {
        ["4.0"] = Properties.Resources.RestrictionType,
        ["4.1"] = Properties.Resources.RestrictionRange,
        ["5.*"] = Properties.Resources.Column,
        ["5.*.0"] = Properties.Resources.Type,
        ["5.*.1"] = Properties.Resources.LogicalName3,
        ["5.*.2"] = Properties.Resources.AttributeIndex,
        ["5.*.3"] = Properties.Resources.DataIndex2
    };
    /// <summary>Maps nested push-object descriptor paths to scalar input kinds.</summary>
    private static readonly IReadOnlyDictionary<string, string> _pushObjectPathKinds = new Dictionary<string, string>
    {
        ["5.*.1"] = "logicalname"
    };

    /// <summary>Creates a push-object descriptor with the fields required by the current version.</summary>
    /// <returns>A push-object descriptor with the fields required by the current version.</returns>
    private object CreatePushObject()
    {
        var row = new GXStructure { (ushort)ObjectType.Data, new byte[6], (sbyte)2, (ushort)0 };
        if (Target.Version > 0)
        {
            row.Add(new GXStructure { new GXEnum(0), null! });
        }
        if (Target.Version > 1)
        {
            row.Add(new GXArray());
        }
        return row;
    }
    /// <summary>Creates the default nested structure for a protection parameter.</summary>
    /// <returns>The default nested structure for a protection parameter.</returns>
    private static object CreateProtectionParameter() => new GXStructure
{
    new GXEnum(0), new GXStructure
    {
        Array.Empty<byte>(), new byte[8], new byte[8], Array.Empty<byte>(),
        new GXStructure { new GXEnum(0), new GXStructure { new GXEnum(0) } }
    }
};

    /// <summary>Validates and encodes the push destination, service and message as a structure.</summary>
    /// <param name="service">The transport service used by the push destination.</param>
    /// <param name="text">The user input in the editor&apos;s invariant text representation.</param>
    /// <param name="message">The push message format to encode.</param>
    /// <returns>Validates and encodes the push destination, service and message as a structure.</returns>
    private GXStructure DestinationValue(ServiceType service, string text, MessageType message)
    {
        var destination = System.Text.Encoding.ASCII.GetBytes(text);
        var parts = text.Split('.');
        if (service == ServiceType.Hdlc && parts.Length == 6 && parts.All(part => byte.TryParse(part, out _)) && parts[5] == "255")
        {
            destination = parts.Select(byte.Parse).ToArray();
        }
        return new GXStructure { new GXEnum((byte)service), destination, new GXEnum((byte)message) };
    }
    /// <summary>Gets the staged push destination structure when a pending value exists.</summary>
    private GXStructure? PendingDestination => Target.GetDirty(3, out var pending) ? pending as GXStructure : null;
    /// <summary>
    /// Service type used by the edited push destination.
    /// </summary>
    public ServiceType SelectedService
    {
        get => PendingDestination is { Count: 3 } value ? (ServiceType)Convert.ToByte(value[0]) : Target.Service;
        set
        {
            if (CanEditAttribute(3))
            {
                SaveDestination(value, DestinationText, SelectedMessage);
            }
        }
    }
    /// <summary>
    /// Message encoding used by the edited push destination.
    /// </summary>
    public MessageType SelectedMessage
    {
        get => PendingDestination is { Count: 3 } value ? (MessageType)Convert.ToByte(value[2]) : Target.Message;
        set
        {
            if (CanEditAttribute(3))
            {
                SaveDestination(SelectedService, DestinationText, value);
            }
        }
    }
    /// <summary>
    /// Destination address entered for push messages.
    /// </summary>
    public string DestinationText
    {
        get
        {
            if (PendingDestination is not { Count: 3 } value || value[1] is not byte[] destination)
            {
                return Target.Destination ?? "";
            }
            if (SelectedService == ServiceType.Hdlc && destination.Length == 6 && destination[5] == 255)
            {
                return string.Join(".", destination);
            }
            return System.Text.Encoding.ASCII.GetString(destination);
        }
        set
        {
            if (CanEditAttribute(3))
            {
                SaveDestination(SelectedService, value, SelectedMessage);
            }
        }
    }
    /// <summary>Checks a proposed destination structure and returns any validation error.</summary>
    /// <param name="service">The transport service used by the push destination.</param>
    /// <param name="text">The user input in the editor&apos;s invariant text representation.</param>
    /// <param name="message">The push message format to encode.</param>
    /// <returns>The validation message, or null when the input is valid.</returns>
    private string? ValidateDestination(ServiceType service, string text, MessageType message)
    {
        if (!Enum.IsDefined(service) || !Enum.IsDefined(message))
        {
            return Properties.Resources.ChooseASupportedServiceAndMessage;
        }
        if (text.Any(character => character > 127))
        {
            return Properties.Resources.DestinationMustContainASCIICharacters;
        }
        try
        {
            var trial = GXDLMSObjectEditState.For(Target.Clone());
            trial.EditAttribute(3, GXDLMSObjectEditState.Format(DestinationValue(service, text, message)));
            return trial.Error(3);
        }
        catch (Exception error) when (error is not OutOfMemoryException) { return error.Message; }
    }
    /// <summary>Stages a validated push destination structure on the target object.</summary>
    /// <param name="service">The transport service used by the push destination.</param>
    /// <param name="text">The user input in the editor&apos;s invariant text representation.</param>
    /// <param name="message">The push message format to encode.</param>
    private void SaveDestination(ServiceType service, string text, MessageType message)
    {
        if (ValidateDestination(service, text, message) is not null)
        {
            return;
        }
        Edit.EditAttribute(3, GXDLMSObjectEditState.Format(DestinationValue(service, text, message)));
    }
    /// <summary>
    /// Requests immediate transmission using the push setup.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task PushAsync() => InvokeMethodAsync(1, client => Target.Push(client));
    /// <summary>
    /// Requests execution of the target object's reset method.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task ResetAsync() => InvokeMethodAsync(2, client => Target.Reset(client));
}





