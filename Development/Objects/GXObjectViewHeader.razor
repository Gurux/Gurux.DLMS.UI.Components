@* <summary>Displays object identity, edit status, and operation errors.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.DLMS.Objects
@using Gurux.DLMS.UI.Components.Help
@using Gurux.UI.Components

@if (Error is not null) { <p class="gx-object-error" role="alert">@Error</p> }
@for (var index = 1; index <= Target.GetValues().Length; ++index)
{
    if (Edit.Error(index) is { } error) { <p class="gx-object-error" role="alert">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Properties.Resources.AttributeError, index, error)</p> }
}
<div class="gx-object-title">
    @if (Title != string.Empty)
    {
        <h2>@(Title ?? string.Format(System.Globalization.CultureInfo.CurrentCulture, Properties.Resources.Text0Object, Target.ObjectType))</h2>
    }
    <GXDLMSObjectHelp Target="Target" />
</div>
<div class="gx-object-identity">
    <div class="gx-field-row"><GXLabel>@Properties.Resources.DescriptionLabel</GXLabel><GXInputText Value="@Target.Description" readonly aria-label="@Properties.Resources.Description" /></div>
    <div class="gx-field-row"><GXLabel>@Properties.Resources.LogicalNameLabel</GXLabel><GXInputText Value="@Target.LogicalName" readonly aria-label="@Properties.Resources.LogicalName" /></div>
</div>
@if (Edit.HasChanges) { <p role="status">@Properties.Resources.ValueChanged</p> }
@if (Edit.LastActionResult is { } result)
{
    <details open><summary>@Properties.Resources.MethodResult</summary><pre role="status">@result</pre></details>
}

@code {
    /// <summary>
    /// DLMS object whose values or help are displayed.
    /// </summary>
    [Parameter, EditorRequired] public GXDLMSObject Target { get; set; } = default!;
    /// <summary>
    /// Edit state containing pending attribute changes and validation errors.
    /// </summary>
    [Parameter, EditorRequired] public GXDLMSObjectEditState Edit { get; set; } = default!;
    /// <summary>
    /// Validation or operation error displayed by the component.
    /// </summary>
    [Parameter]
    public string? Error
    {
        get; set;
    }
    /// <summary>
    /// Heading displayed above the component content.
    /// </summary>
    [Parameter]
    public string? Title
    {
        get; set;
    }
}
