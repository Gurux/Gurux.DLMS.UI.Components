@* <summary>Displays and edits DLMS sfskmac counters values and supported actions.</summary> *@

@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSSFSKMacCounters>


<section class="gx-network-view">
<div class="gx-view-content account-object">
<GXObjectViewHeader Title="@Properties.Resources.SFSKMACCountersObject" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="@Properties.Resources.SynchronizationRegisterLabel" Enabled="CanEditAttribute(2)" Columns='@(new[] { Properties.Resources.SynchronizationRegister, Properties.Resources.Counter })' CreateRow='@(() => new GXStructure { (ushort)0, (uint)0 })' />
    }
    <fieldset class="gx-object-fields"><legend>@Properties.Resources.DesynchronizationListing</legend>
        <GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.PhysicalLayerDesynchronizationLabel" Enabled="CanEditAttribute(3)" Part="0" />
        <GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.TimeoutNotAddressedDesynchronizationLabel" Enabled="CanEditAttribute(3)" Part="1" />
        <GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.TimeoutFrameNotOKDesynchronizationLabel" Enabled="CanEditAttribute(3)" Part="2" />
        <GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.WriteRequestDesynchronizationLabel" Enabled="CanEditAttribute(3)" Part="3" />
        <GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.WrongInitiatorDesynchronizationLabel" Enabled="CanEditAttribute(3)" Part="4" />
    </fieldset>
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="@Properties.Resources.BroadcastFramesCounterLabel" Enabled="CanEditAttribute(4)" CreateRow='@(() => new GXStructure { (ushort)0, (uint)0 })'  Columns='@(new[] { Properties.Resources.MACAddress, Properties.Resources.Counter })' />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="@Properties.Resources.RepetitionsCounterLabel" Enabled="CanEditAttribute(5)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
    {
        <GXAttributeField Edit="Edit" Index="6" Label="@Properties.Resources.TransmissionsCounterLabel2" Enabled="CanEditAttribute(6)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 7)
    {
        <GXAttributeField Edit="Edit" Index="7" Label="@Properties.Resources.CRCOKFramesCounterLabel" Enabled="CanEditAttribute(7)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 8)
    {
        <GXAttributeField Edit="Edit" Index="8" Label="@Properties.Resources.CRCNOKFramesCounterLabel" Enabled="CanEditAttribute(8)"  />
    }
</div>
</section>
