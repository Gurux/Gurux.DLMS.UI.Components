@* <summary>Displays object data, access rights, and help with attribute read controls.</summary> *@

@using Gurux.DLMS.Objects
@using Gurux.UI.Components.Tab
@using Gurux.UI.Components
@inject IGXLocalStorage ReadStorage

<section class="gx-object-tabs">
    <GXTabControl @key="Target" NavigateOnSelection="false">
        <GXTabPage Text="@Properties.Resources.Data">@Data</GXTabPage>
        <GXTabPage Text="@Properties.Resources.Attributes">
            <div class="attribute-read-actions">
                <GXButton Disabled="@(!ReadsEnabled || !SelectedAttributes.Any(CanRead))" OnClick="ReadSelectedAsync">@Properties.Resources.Read</GXButton>
                <GXButton Disabled="@(!ReadsEnabled)" OnClick="ReadAllAsync">@Properties.Resources.ReadAll</GXButton>
                <GXButton Disabled="@(!ReadsEnabled)" OnClick="RefreshValuesAsync">@Properties.Resources.RefreshValues</GXButton>
                <GXInputSwitch TValue="bool" Inline="true" Save="false" Text="@Properties.Resources.ReadAutomaticallyOnObjectSelection" Value="AutoRead" ValueChanged="SetAutoReadAsync" />
            </div>
            <div class="rights-scroll">
                <table><thead><tr><th>@Properties.Resources.Read</th><th>@Properties.Resources.Index</th><th>@Properties.Resources.Description</th><th>@Properties.Resources.Value</th><th>@Properties.Resources.AccessRights</th></tr></thead><tbody>
                @for (var index = 1; index <= AttributeCount; ++index)
                {
                    var attributeIndex = index;
                    <tr><td><GXInputSwitch TValue="bool" Inline="true" Save="false" Value="@SelectedAttributes.Contains(index)" Disabled="@(!CanRead(index))" ValueChanged="value => SelectAttributeAsync(attributeIndex, value)" aria-label="@(string.Format(System.Globalization.CultureInfo.CurrentCulture, Properties.Resources.Read0, AttributeName(index)))" /></td>
                        <td>@index</td><td>@AttributeName(index)</td>
                        <td>
                            @if (Target.Attributes.Find(index)?.Values is { Count: > 0 })
                            {
                                <GXAttributeField Edit="@GXDLMSObjectEditState.For(Target)" Index="@index" Label="@AttributeName(index)" Enabled="false" />
                            }
                            else
                            {
                                @AttributeValue(index)
                            }
                        </td>
                        <td>@AttributeAccess(index)</td></tr>
                }
                </tbody></table>
            </div>
        </GXTabPage>
        <GXTabPage Text="@Properties.Resources.AccessRights">
            <div class="rights-scroll">
                <table><thead><tr><th>@Properties.Resources.AttributeIndex</th><th>@Properties.Resources.Description</th><th>@Properties.Resources.AccessRights</th><th>@Properties.Resources.AccessSelector</th><th>@Properties.Resources.Static</th><th>@Properties.Resources.Type</th><th>@Properties.Resources.UIType</th></tr></thead>
                    <tbody>
                        @for (var index = 1; index <= AttributeCount; ++index)
                        {
                            <tr><td>@index</td><td>@AttributeName(index)</td><td>@AttributeAccess(index)</td><td>@Target.GetAccessSelector(index)</td>
                                <td>@Target.GetStatic(index)</td><td>@Target.GetDataType(index)</td><td>@Target.GetUIDataType(index)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </GXTabPage>
        @if (MethodCount > 0)
        {
            <GXTabPage Text="@Properties.Resources.MethodAccessRights">
                <div class="rights-scroll">
                    <table><thead><tr><th>@Properties.Resources.MethodIndex</th><th>@Properties.Resources.Description</th><th>@Properties.Resources.MethodAccess</th></tr></thead>
                        <tbody>
                            @for (var index = 1; index <= MethodCount; ++index)
                            {
                                <tr><td>@index</td><td>@MethodName(index)</td><td>@MethodAccess(index)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </GXTabPage>
        }
    </GXTabControl>
</section>

@code {
    /// <summary>
    /// DLMS object whose values or help are displayed.
    /// </summary>
    [Parameter, EditorRequired] public GXDLMSObject Target { get; set; } = default!;
    /// <summary>
    /// Association used to resolve attribute and method access rights.
    /// </summary>
    [Parameter]
    public GXDLMSAssociationLogicalName? Association
    {
        get; set;
    }
    /// <summary>
    /// Content rendered in the object data tab.
    /// </summary>
    [Parameter]
    public RenderFragment? Data
    {
        get; set;
    }
    /// <summary>
    /// Whether attribute read requests can be issued.
    /// </summary>
    [Parameter]
    public bool ReadsEnabled
    {
        get; set;
    }
    /// <summary>
    /// Callback receiving the requested attributes or profile selection.
    /// </summary>
    [Parameter]
    public EventCallback<int[]> OnReadRequested
    {
        get; set;
    }
    /// <summary>
    /// Attribute indices currently selected for reading.
    /// </summary>
    public HashSet<int> SelectedAttributes { get; private set; } = [];
    /// <summary>
    /// Whether changing the attribute selection automatically requests a read.
    /// </summary>
    public bool AutoRead
    {
        get; private set;
    }
    /// <summary>Identifies the model whose read selections are currently loaded.</summary>
    private GXDLMSObject? _settingsTarget;
    /// <summary>Tracks whether the persisted component settings have been loaded. Prevents overlapping read requests while a host callback is running.</summary>
    private bool _loaded, _reading;
    /// <summary>Gets the storage key for the current object&apos;s selected attribute indices.</summary>
    private string SelectionKey => $"GXAttributeReads:{Target.ObjectType}";
    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_settingsTarget, Target))
        {
            return;
        }
        _settingsTarget = Target;
        _loaded = false;
        SelectedAttributes = DefaultAttributes().ToHashSet();
    }
    /// <summary>Chooses the default readable attributes, with the clock-specific selection.</summary>
    /// <returns>Chooses the default readable attributes, with the clock-specific selection.</returns>
    private IEnumerable<int> DefaultAttributes() => Target.ObjectType == Gurux.DLMS.Enums.ObjectType.Clock
        ? new[] { 2, 4 }.Where(CanRead)
        : Enumerable.Range(1, AttributeCount).Where(index => index > 1 && !Target.GetStatic(index) && CanRead(index));
    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loaded)
        {
            return;
        }
        _loaded = true;
        var target = Target;
        var saved = await ReadStorage.GetValueAsync(SelectionKey);
        var auto = await ReadStorage.GetValueAsync("GXAttributeReads:AutoRead");
        if (!ReferenceEquals(target, Target))
        {
            return;
        }
        if (saved is not null)
        {
            SelectedAttributes = saved.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(value => int.TryParse(value, out var index) ? index : 0).Where(index => index > 0 && index <= AttributeCount).ToHashSet();
        }
        AutoRead = auto == "true";
        StateHasChanged();
        if (AutoRead && ReadsEnabled)
        {
            await ReadSelectedAsync();
        }
    }
    /// <summary>
    /// Determines whether the association permits reading the specified attribute.
    /// </summary>
    /// <param name="index">One-based attribute index.</param>
    /// <returns>Whether the attribute can be read.</returns>
    public bool CanRead(int index) => GXDLMSObjectAccess.CanRead(Target, index, Association);
    /// <summary>
    /// Updates the attribute selection and requests a read when automatic reading is enabled.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    /// <param name="index">One-based attribute index.</param>
    /// <param name="selected">Whether the attribute is selected.</param>
    public async Task SelectAttributeAsync(int index, bool selected)
    {
        if (index < 1 || index > AttributeCount || !CanRead(index))
        {
            return;
        }
        if (selected)
        {
            SelectedAttributes.Add(index);
        }
        else
        {
            SelectedAttributes.Remove(index);
        }
        await ReadStorage.SetValueAsync(SelectionKey, string.Join(',', SelectedAttributes.Order()));
    }
    /// <summary>
    /// Changes automatic reading and requests selected attributes when enabled.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    /// <param name="enabled">Whether selection changes automatically request reads.</param>
    public async Task SetAutoReadAsync(bool enabled)
    {
        AutoRead = enabled;
        await ReadStorage.SetValueAsync("GXAttributeReads:AutoRead", enabled ? "true" : "false");
    }
    /// <summary>
    /// Requests the selected readable attributes.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task ReadSelectedAsync() => RequestReadAsync(SelectedAttributes);
    /// <summary>
    /// Requests all readable attributes of the target object.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task ReadAllAsync() => RequestReadAsync(Enumerable.Range(1, AttributeCount));
    /// <summary>
    /// Requests the default attributes used to refresh displayed values.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task RefreshValuesAsync() => RequestReadAsync(DefaultAttributes());
    /// <summary>Requests a host-managed attribute read and updates the loading state.</summary>
    /// <param name="indices">The one-based attribute indices requested from the host.</param>
    /// <returns>A task that completes when the request or callback has finished.</returns>
    private async Task RequestReadAsync(IEnumerable<int> indices)
    {
        if (!ReadsEnabled || _reading || !OnReadRequested.HasDelegate)
        {
            return;
        }
        var readable = indices.Where(CanRead).Distinct().Order().ToArray();
        if (readable.Length == 0)
        {
            return;
        }
        _reading = true;
        try
        {
            await OnReadRequested.InvokeAsync(readable);
        }
        finally { _reading = false; }
    }
    /// <summary>Formats an attribute value and retains a readable error when conversion fails.</summary>
    /// <param name="index">The one-based COSEM attribute or method index.</param>
    /// <returns>The formatted text for the supplied value.</returns>
    private string AttributeValue(int index)
    {
        try
        {
            return GXDLMSObjectEditState.For(Target).AttributeText(index);
        }
        catch { return string.Empty; }
    }
    /// <summary>
    /// Number of attributes exposed by the target object.
    /// </summary>
    public int AttributeCount => (Target as IGXDLMSBase)?.GetAttributeCount() ?? Target.Attributes.Select(item => item.Index).DefaultIfEmpty().Max();
    /// <summary>
    /// Number of methods exposed by the target object.
    /// </summary>
    public int MethodCount => (Target as IGXDLMSBase)?.GetMethodCount() ?? Target.MethodAttributes.Select(item => item.Index).DefaultIfEmpty().Max();
    /// <summary>Gets the protocol attribute name or a numbered fallback.</summary>
    /// <param name="index">The one-based COSEM attribute or method index.</param>
    /// <returns>The protocol attribute name or a numbered fallback.</returns>
    private string AttributeName(int index) => Name((Target as IGXDLMSBase)?.GetNames(), index, Properties.Resources.Attribute0);
    /// <summary>Gets the protocol method name or a numbered fallback.</summary>
    /// <param name="index">The one-based COSEM attribute or method index.</param>
    /// <returns>The protocol method name or a numbered fallback.</returns>
    private string MethodName(int index) => Name((Target as IGXDLMSBase)?.GetMethodNames(), index, Properties.Resources.Method0);
    /// <summary>Returns the indexed protocol name or a numbered fallback label.</summary>
    /// <param name="names">The ordered protocol names, if supplied by the object.</param>
    /// <param name="index">The one-based COSEM attribute or method index.</param>
    /// <param name="fallback">The numbered fallback format used when no protocol name is available.</param>
    /// <returns>The indexed protocol name or a numbered fallback label.</returns>
    private static string Name(string[]? names, int index, string fallback) => names is not null && index <= names.Length ? names[index - 1] : string.Format(System.Globalization.CultureInfo.CurrentCulture, fallback, index);
    /// <summary>
    /// Returns association-specific access rights for an attribute.
    /// </summary>
    /// <param name="index">One-based attribute index.</param>
    /// <returns>The formatted access rights.</returns>
    public string AttributeAccess(int index) => Association?.Version >= 3
        ? GXDLMSObjectAccess.GetAccess3(Target, index, Association).ToString()
        : GXDLMSObjectAccess.GetAccess(Target, index, Association).ToString();
    /// <summary>
    /// Returns association-specific access rights for a method.
    /// </summary>
    /// <param name="index">One-based method index.</param>
    /// <returns>The formatted access rights.</returns>
    public string MethodAccess(int index) => Association?.Version >= 3
        ? (Association.IsAccessRightSet(Target) ? Association.GetMethodAccess3(Target, index) : Target.GetMethodAccess3(index)).ToString()
        : (Association?.IsAccessRightSet(Target) == true ? Association.GetMethodAccess(Target, index) : Target.GetMethodAccess(index)).ToString();
}
