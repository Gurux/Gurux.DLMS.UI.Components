@* <summary>Displays and edits DLMS special days table values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@inherits GXDLMSObjectViewBase<GXDLMSSpecialDaysTable>

<section @key="Target" class="gx-object-view">
    <GXObjectViewHeader Title="Special Days Table Object" Target="Target" Edit="Edit" Error="@ActionError" />
    <GXAttributeField Edit="Edit" Index="2" EditorKinds="@(new[] { "number", "datetime", "number" })" Label="Entries" Enabled="CanEditAttribute(2)" Columns="@(new[] { "Index", "Special Day Date", "Day ID" })" CreateRow="@(() => new GXStructure { (ushort)1, new byte[] { 0xFF, 0xFF, 0xFF, 0xFF, 0xFF }, (byte)1 })" />
    <fieldset><legend>Methods</legend>
    <GXValueField Label="Entry index" Value="@EntryIndex" Enabled="@(CanInvokeMethod(1) || CanInvokeMethod(2))" InputKind="number" OnCommit="value => EntryIndex = value" Validate="text => ValidateParameter(nameof(EntryIndex), text)" />
    <GXValueField Label="Date (yyyy-MM-dd)" Value="@EntryDate" Enabled="@(CanInvokeMethod(1) || CanInvokeMethod(2))" InputKind="text" OnCommit="value => EntryDate = value" Validate="text => ValidateParameter(nameof(EntryDate), text)" />
    <GXValueField Label="Day ID (0–255)" Value="@DayId" Enabled="@(CanInvokeMethod(1) || CanInvokeMethod(2))" InputKind="number" OnCommit="value => DayId = value" Validate="text => ValidateParameter(nameof(DayId), text)" />
    <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="InsertAsync">Insert day</GXButton>
    <GXButton type="button" Disabled="@(!CanInvokeMethod(2))" OnClick="DeleteAsync">Delete day</GXButton>
    </fieldset>
</section>

@code {
    /// <summary>
    /// Entry index entered for the selected operation.
    /// </summary>
    public string EntryIndex { get; set; } = string.Empty;
    /// <summary>
    /// Date entered for the special-day entry.
    /// </summary>
    public string EntryDate { get; set; } = string.Empty;
    /// <summary>
    /// Day identifier associated with the special-day entry.
    /// </summary>
    public string DayId { get; set; } = string.Empty;
    /// <summary>
    /// Requests insertion of the entered special-day entry.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task InsertAsync() => InvokeMethodAsync(1, client => Target.Insert(client, new GXDLMSSpecialDay
    {
        Index = ushort.Parse(EntryIndex, CultureInfo.InvariantCulture),
        Date = new GXDate(DateTime.ParseExact(EntryDate, "yyyy-MM-dd", CultureInfo.InvariantCulture)),
        DayId = byte.Parse(DayId, CultureInfo.InvariantCulture)
    }));
    /// <summary>
    /// Requests deletion of the selected special-day entry.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task DeleteAsync() => InvokeMethodAsync(2, client => Target.Delete(client, new GXDLMSSpecialDay { Index = ushort.Parse(EntryIndex, CultureInfo.InvariantCulture) }));

    private static string? ValidateParameter(string field, string text)
    {
        try
        {
            switch (field)
            {
                case nameof(EntryIndex):
                    {
                        ushort.Parse(text, CultureInfo.InvariantCulture);
                        break;
                    }
                case nameof(EntryDate):
                    {
                        DateTime.ParseExact(text, "yyyy-MM-dd", CultureInfo.InvariantCulture);
                        break;
                    }
                case nameof(DayId):
                    {
                        byte.Parse(text, CultureInfo.InvariantCulture);
                        break;
                    }
            }
            return null;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException) { return ex.Message; }
    }
}
