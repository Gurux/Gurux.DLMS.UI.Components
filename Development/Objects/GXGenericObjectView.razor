@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.DLMS.Objects
@inherits GXDLMSObjectViewBase<GXDLMSObject>

<section class="gx-object-view">
    <GXObjectViewHeader Target="Target" Edit="Edit" Title="@(Target.ObjectType + " Object")" />
    @if (Target is IGXDLMSBase details)
    {
        var names = details.GetNames();
        @for (var index = 2; index <= details.GetAttributeCount(); ++index)
        {
            <GXAttributeField @key="index" Edit="Edit" Index="index" Label="@(names.ElementAtOrDefault(index - 1) ?? $"Attribute {index}")" Enabled="CanEditAttribute(index)" />
        }
    }
</section>
