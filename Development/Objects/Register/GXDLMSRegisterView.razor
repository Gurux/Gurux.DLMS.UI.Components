@* <summary>Displays and edits DLMS register values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS
@inherits GXDLMSObjectViewBase<GXDLMSRegister>

<section class="gx-object-view">
    @if (_resetError is not null) { <p role="alert">@_resetError</p> }
    @if (Edit.Error(2) is { } valueError) { <p role="alert">@valueError</p> }
    @if (Edit.Error(3) is { } scalerError) { <p role="alert">@scalerError</p> }
    <GXObjectViewHeader Target="Target" Edit="Edit" Title="Register Object" />
    <GXAttributeField Edit="Edit" Index="2" Label="Value" Enabled="CanEditAttribute(2)" Rows="@(Edit.IsXml ? 10 : 2)" />
    <GXAttributeField Edit="Edit" Index="3" Part="0" Label="Scaler:" InputKind="scaler" Enabled="CanEditAttribute(3)" />
    <GXAttributeField Edit="Edit" Index="3" Part="1" Label="Unit:" EnumType="typeof(Unit)" Enabled="CanEditAttribute(3)" />
    @if (Edit.HasChanges) { <p role="status">Value changed</p> }
    <GXButton type="button" Disabled="@(!CanReset)" OnClick="ResetAsync">Reset</GXButton>
</section>

@code {
    /// <summary>
    /// Whether the register reset action is offered.
    /// </summary>
    [Parameter] public bool ResetEnabled { get; set; } = true;
    private bool _resetting;
    private string? _resetError;
    private GXDLMSRegister? _previousTarget;
    /// <summary>
    /// Whether the register can currently execute its reset method.
    /// </summary>
    public bool CanReset => !_resetting && ResetEnabled && CanInvokeMethod(1);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!ReferenceEquals(Target, _previousTarget))
        {
            _resetError = null;
        }
        _previousTarget = Target;
    }

    /// <summary>
    /// Requests execution of the target object's reset method.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public async System.Threading.Tasks.Task ResetAsync()
    {
        if (!CanReset)
        {
            return;
        }
        _resetting = true;
        _resetError = null;
        var target = Target;
        try
        {
            await OnActionRequested.InvokeAsync(new GXDLMSActionRequest(target, 1, client => target.Reset(client)));
        }
        catch (Exception ex)
        {
            if (ReferenceEquals(Target, target))
            {
                _resetError = $"Reset failed: {ex.Message}";
            }
        }
        finally { _resetting = false; }
    }
}
