@* <summary>Displays and edits DLMS credit values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@inherits GXDLMSObjectViewBase<GXDLMSCredit>

<section @key="Target" class="gx-object-view">
    <GXObjectViewHeader Title="Credit Object" Target="Target" Edit="Edit" Error="@ActionError" />
    <GXAttributeField Edit="Edit" Index="2" Label="Current Credit Amount" Enabled="CanEditAttribute(2)" />
    <GXAttributeField Edit="Edit" Index="3" Label="Type" Enabled="CanEditAttribute(3)" EnumType="typeof(CreditType)" />
    <GXAttributeField Edit="Edit" Index="4" Label="Priority" Enabled="CanEditAttribute(4)" />
    <GXAttributeField Edit="Edit" Index="5" Label="Warning Threshold" Enabled="CanEditAttribute(5)" />
    <GXAttributeField Edit="Edit" Index="6" Label="Limit" Enabled="CanEditAttribute(6)" />
    <GXAttributeField Edit="Edit" Index="7" Label="Credit Configuration" Enabled="CanEditAttribute(7)" EnumType="typeof(CreditConfiguration)" />
    <GXAttributeField Edit="Edit" Index="8" Label="Status" Enabled="CanEditAttribute(8)" EnumType="typeof(CreditStatus)" />
    <GXAttributeField Edit="Edit" Index="9" Label="Preset Credit Amount" Enabled="CanEditAttribute(9)" />
    <GXAttributeField Edit="Edit" Index="10" Label="Credit Available Threshold" Enabled="CanEditAttribute(10)" />
    <GXAttributeField Edit="Edit" Index="11" Label="Period" Enabled="CanEditAttribute(11)" />
    <fieldset><legend>Methods</legend>
    <GXValueField Label="Amount (Int32)" Value="@Amount" Enabled="@(CanInvokeMethod(1) || CanInvokeMethod(2) || CanInvokeMethod(3))" InputKind="number" OnCommit="value => Amount = value" Validate="text => ValidateParameter(nameof(Amount), text)" />
    <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="UpdateAmountAsync">Update amount</GXButton>
    <GXButton type="button" Disabled="@(!CanInvokeMethod(2))" OnClick="SetAmountAsync">Set amount</GXButton>
    <GXValueField Label="Requested status" Value="@RequestedStatus" Enabled="CanInvokeMethod(3)" EnumType="typeof(CreditStatus)" OnCommit="value => RequestedStatus = value" />
    <GXButton type="button" Disabled="@(!CanInvokeMethod(3))" OnClick="InvokeCreditAsync">Invoke credit</GXButton>
    </fieldset>
</section>

@code {
    /// <summary>
    /// Credit amount entered for an adjustment or replacement request.
    /// </summary>
    public string Amount { get; set; } = string.Empty;
    /// <summary>
    /// Credit status entered for the invocation request.
    /// </summary>
    public string RequestedStatus { get; set; } = string.Empty;
    /// <summary>
    /// Requests adjustment of the credit by the entered amount.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task UpdateAmountAsync() => InvokeMethodAsync(1, client => Target.UpdateAmount(client, int.Parse(Amount, CultureInfo.InvariantCulture)));
    /// <summary>
    /// Requests replacement of the credit with the entered amount.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task SetAmountAsync() => InvokeMethodAsync(2, client => Target.SetAmountToValue(client, int.Parse(Amount, CultureInfo.InvariantCulture)));
    /// <summary>
    /// Requests credit invocation with the entered status.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task InvokeCreditAsync() => InvokeMethodAsync(3, client =>
    {
        var status = Enum.Parse<CreditStatus>(RequestedStatus);
        if (!Enum.IsDefined(status))
        {
            throw new FormatException("Select a valid credit status.");
        }
        return Target.InvokeCredit(client, status);
    });

    private static string? ValidateParameter(string field, string text)
    {
        try
        {
            switch (field)
            {
                case nameof(Amount):
                    {
                        int.Parse(text, CultureInfo.InvariantCulture);
                        break;
                    }
            }
            return null;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException) { return ex.Message; }
    }
}
