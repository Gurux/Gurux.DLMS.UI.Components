@* <summary>Displays and edits DLMS mbus diagnostic values and supported actions.</summary> *@

@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSMBusDiagnostic>


<section class="gx-network-view">
<div class="gx-view-content">
<GXObjectViewHeader Title="@Properties.Resources.MBusDiagnosticObject" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="@Properties.Resources.ReceivedSignalStrengthLabel" Enabled="CanEditAttribute(2)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.ChannelIDLabel" Enabled="CanEditAttribute(3)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="@Properties.Resources.LinkStatusLabel" Enabled="CanEditAttribute(4)" EnumType="typeof(MBusLinkStatus)"  />
    }
<fieldset class="gx-object-fields"><legend>@Properties.Resources.BroadcastFramesCounter</legend>
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="@Properties.Resources.BroadcastFrames" Enabled="CanEditAttribute(5)" Columns='@(new[] { Properties.Resources.ClientID, Properties.Resources.Counter, Properties.Resources.TimeStamp })' CreateRow='@(() => new GXStructure { (byte)0, (uint)0, new GXDateTime() })' />
    }
</fieldset>
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
    {
        <GXAttributeField Edit="Edit" Index="6" Label="@Properties.Resources.TransmissionsCounterLabel" Enabled="CanEditAttribute(6)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 7)
    {
        <GXAttributeField Edit="Edit" Index="7" Label="@Properties.Resources.FCSOKFramesCounterLabel" Enabled="CanEditAttribute(7)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 8)
    {
        <GXAttributeField Edit="Edit" Index="8" Label="@Properties.Resources.FCSNOKFramesCounterLabel" Enabled="CanEditAttribute(8)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 9)
    {
        <GXAttributeField Edit="Edit" Index="9" Label="@Properties.Resources.CaptureIDLabel" Enabled="CanEditAttribute(9)" Part="0" />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 9)
    {
        <GXAttributeField Edit="Edit" Index="9" Label="@Properties.Resources.CaptureTimeLabel2" Enabled="CanEditAttribute(9)" Part="1" />
    }
</div>
</section>
<section class="gx-object-actions"><GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="ResetAsync">@Properties.Resources.Reset</GXButton></section>
@code {
    /// <summary>Submits the object&apos;s reset method through the host action callback.</summary>
    /// <returns>A task that completes when the request or callback has finished.</returns>
    private Task ResetAsync() => InvokeMethodAsync(1, client => Target.Reset(client));
}
