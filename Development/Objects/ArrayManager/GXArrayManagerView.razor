@* <summary>Displays and edits DLMS array manager values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using System.Xml
@using System.Xml.Linq
@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@inherits GXDLMSObjectViewBase<GXDLMSArrayManager>

<section class="gx-object-view" @key="Target">
    <GXObjectViewHeader Title="Array Manager Object" Target="Target" Edit="Edit" Error="@ActionError" />
    <GXAttributeField Edit="Edit" Index="2" Label="Elements" Enabled="CanEditAttribute(2)"
        Columns='@(new[] { "ID", "Class ID", "Logical name", "Attribute index" })'
        ColumnPaths='@(new[] { "0", "1.0", "1.1", "1.2" })'
        EditorKinds='@(new[] { "number", "number", "logicalname", "number" })'
        CreateRow="CreateElement" />
    <fieldset><legend>Array</legend>
        <GXValueField @ref="_arrayIdField" Label="Array ID (0–255)" Value="@ArrayId" Enabled="CanUseArray" InputKind="number" OnCommit="value => ArrayId = value" Validate="ValidateId" />
        <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="NumberOfEntriesAsync">Number of entries</GXButton>
    </fieldset>
    <fieldset><legend>Entry range</legend>
        <GXValueField @ref="_fromField" Label="From index (1–65535)" Value="@FromIndex" Enabled="CanUseRange" InputKind="number" OnCommit="value => FromIndex = value" Validate="ValidateIndex" />
        <GXValueField @ref="_toField" Label="To index (1–65535)" Value="@ToIndex" Enabled="CanUseRange" InputKind="number" OnCommit="value => ToIndex = value" Validate="ValidateIndex" />
        <GXButton type="button" Disabled="@(!CanInvokeMethod(2))" OnClick="RetrieveEntriesAsync">Retrieve entries</GXButton>
        <GXButton type="button" Disabled="@(!CanInvokeMethod(5))" OnClick="RemoveEntriesAsync">Remove entries</GXButton>
    </fieldset>
    <fieldset><legend>Entry</legend>
        <GXValueField @ref="_indexField" Label="Entry index (1–65535)" Value="@EntryIndex" Enabled="CanUseEntry" InputKind="number" OnCommit="value => EntryIndex = value" Validate="ValidateIndex" />
        <GXValueField @ref="_entryField" Label="Entry (DLMS XML)" Value="@EntryXml" Enabled="CanUseEntry" OnCommit="value => EntryXml = value" Validate="ValidateEntry" />
        <p>Use a typed value, for example &lt;Int32 Value="7" /&gt;, or a Structure containing typed values.</p>
        <GXButton type="button" Disabled="@(!CanInvokeMethod(3))" OnClick="InsertEntryAsync">Insert entry</GXButton>
        <GXButton type="button" Disabled="@(!CanInvokeMethod(4))" OnClick="UpdateEntryAsync">Update entry</GXButton>
    </fieldset>
</section>

@code {
    /// <summary>
    /// Array identifier entered for array-manager operations.
    /// </summary>
    public string ArrayId { get; set; } = "0";
    /// <summary>
    /// First entry index entered for retrieval or removal.
    /// </summary>
    public string FromIndex { get; set; } = "1";
    /// <summary>
    /// Last entry index entered for retrieval or removal.
    /// </summary>
    public string ToIndex { get; set; } = "1";
    /// <summary>
    /// Entry index entered for the selected operation.
    /// </summary>
    public string EntryIndex { get; set; } = "1";
    /// <summary>
    /// XML representation of the value to insert or update.
    /// </summary>
    public string EntryXml { get; set; } = "<Int32 Value=\"0\" />";
    private GXValueField? _arrayIdField, _fromField, _toField, _indexField, _entryField;
    private bool CanUseArray => Enumerable.Range(1, 5).Any(CanInvokeMethod);
    private bool CanUseRange => CanInvokeMethod(2) || CanInvokeMethod(5);
    private bool CanUseEntry => CanInvokeMethod(3) || CanInvokeMethod(4);
    private static object CreateElement() => new GXStructure
    {
        (byte)0, new GXStructure { (ushort)ObjectType.Data, new byte[6], (sbyte)2 }
    };

    /// <summary>
    /// Requests the number of entries in the selected managed array.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task NumberOfEntriesAsync() => ExecuteAsync(1);
    /// <summary>
    /// Requests the entered index range from the selected managed array.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task RetrieveEntriesAsync() => ExecuteAsync(2);
    /// <summary>
    /// Requests insertion of the XML value at the entered array index.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task InsertEntryAsync() => ExecuteAsync(3);
    /// <summary>
    /// Requests replacement of the entered array entry with the XML value.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task UpdateEntryAsync() => ExecuteAsync(4);
    /// <summary>
    /// Requests removal of the entered index range from the managed array.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task RemoveEntriesAsync() => ExecuteAsync(5);

    private async Task ExecuteAsync(int method)
    {
        if (!CanInvokeMethod(method))
        {
            return;
        }
        try
        {
            if (_arrayIdField?.Error is not null
                || (method == 2 || method == 5) && (_fromField?.Error is not null || _toField?.Error is not null)
                || (method == 3 || method == 4) && (_indexField?.Error is not null || _entryField?.Error is not null))
            {
                throw new FormatException("Correct the invalid parameters before invoking the method.");
            }
            var id = byte.Parse(ArrayId, NumberStyles.None, CultureInfo.InvariantCulture);
            var target = Target;
            Func<GXDLMSClient, byte[][]> createMessages;
            if (method == 1)
            {
                createMessages = client => target.NumberOfEntries(client, id);
            }
            else if (method == 2 || method == 5)
            {
                var from = ParseIndex(FromIndex);
                var to = ParseIndex(ToIndex);
                if (from > to)
                {
                    throw new FormatException("From index must not exceed to index.");
                }
                createMessages = method == 2
                    ? client => target.RetrieveEntries(client, id, from, to)
                    : client => target.RemoveEntries(client, id, from, to);
            }
            else
            {
                var index = ParseIndex(EntryIndex);
                var entry = ParseEntry(EntryXml);
                createMessages = method == 3
                    ? client => target.InsertEntry(client, id, index, entry)
                    : client => target.UpdateEntry(client, id, index, entry);
            }
            await InvokeMethodAsync(method, createMessages);
        }
        catch (Exception error) when (error is not OutOfMemoryException)
        {
            ActionError = $"Action failed: {error.Message}";
        }
    }

    private static ushort ParseIndex(string text)
    {
        var index = ushort.Parse(text, NumberStyles.None, CultureInfo.InvariantCulture);
        if (index == 0)
        {
            throw new FormatException("Entry indices must be between 1 and 65535.");
        }
        return index;
    }

    private static object ParseEntry(string text)
    {
        using var reader = XmlReader.Create(new StringReader(text), new XmlReaderSettings { DtdProcessing = DtdProcessing.Prohibit, XmlResolver = null });
        var document = XDocument.Load(reader);
        return GXDLMSTranslator.XmlToValue(document.ToString())
            ?? throw new FormatException("Enter a typed DLMS value.");
    }

    private static string? ValidateId(string text) => byte.TryParse(text, NumberStyles.None, CultureInfo.InvariantCulture, out _)
        ? null : "Enter an array ID between 0 and 255.";
    private static string? ValidateIndex(string text) => ushort.TryParse(text, NumberStyles.None, CultureInfo.InvariantCulture, out var index) && index != 0
        ? null : "Enter an index between 1 and 65535.";
    private static string? ValidateEntry(string text)
    {
        try
        {
            ParseEntry(text);
            return null;
        }
        catch (Exception error) when (error is not OutOfMemoryException)
        {
            return error.Message;
        }
    }
}
