@* <summary>Displays and edits DLMS clock values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using Gurux.UI.Components
@using Gurux.UI.Components.Tab
@inherits GXDLMSObjectViewBase<GXDLMSClock>

<section class="gx-clock-view" @key="Target">
    <GXObjectViewHeader Target="Target" Edit="Edit" Error="@ActionError" Title="@Properties.Resources.ClockObject" />
    <GXTabControl NavigateOnSelection="false">
        <GXTabPage Text="@Properties.Resources.General">
            <div class="clock-inline-action clock-time-action">
                <GXAttributeField @ref="_timeField" Edit="Edit" Index="2" Label="@Properties.Resources.TimeLabel" Enabled="CanEditAttribute(2)" InputKind="datetime" />
                <GXButton type="button" Disabled="@(!CanEditAttribute(2))" OnClick="ConfirmCurrentTime">@Properties.Resources.CurrentTime</GXButton>
            </div>
            <GXValueField Label="@Properties.Resources.UseTimeZoneLabel" Value="@TimeZoneEnabled.ToString()" Enabled="CanEditAttribute(3)" InputKind="bool" OnCommit="text => EnableTimeZone(bool.Parse(text))" />
            <div class="clock-inline-action clock-number-action">
                <GXAttributeField @ref="_timeZoneField" Edit="Edit" Index="3" Label="@Properties.Resources.TimeZoneLabel" Enabled="@(CanEditAttribute(3) && TimeZoneEnabled)" />
                <GXButton type="button" Disabled="@(!CanEditAttribute(3) || !TimeZoneEnabled)" OnClick="ConfirmCurrentTimeZone">@Properties.Resources.CurrentTimeZone</GXButton>
            </div>
            <GXAttributeField Edit="Edit" Index="4" Label="@Properties.Resources.StatusLabel" Enabled="CanEditAttribute(4)" EnumType="typeof(ClockStatus)" />
            <fieldset>
                <legend>@Properties.Resources.DaylightSavings</legend>
                <GXAttributeField Edit="Edit" Index="5" Label="@Properties.Resources.BeginLabel" Enabled="@(CanEditAttribute(5) && DaylightEnabled)" InputKind="datetime" />
                <GXAttributeField Edit="Edit" Index="6" Label="@Properties.Resources.EndLabel" Enabled="@(CanEditAttribute(6) && DaylightEnabled)" InputKind="datetime" />
                <GXAttributeField Edit="Edit" Index="7" Label="@Properties.Resources.DeviationLabel" Enabled="@(CanEditAttribute(7) && DaylightEnabled)" />
                <GXAttributeField Edit="Edit" Index="8" Label="@Properties.Resources.EnabledLabel" Enabled="CanEditAttribute(8)" InputKind="bool" />
            </fieldset>
            <GXAttributeField Edit="Edit" Index="9" Label="@Properties.Resources.ClockBaseLabel" Enabled="CanEditAttribute(9)" EnumType="typeof(ClockBase)" />
        </GXTabPage>
        <GXTabPage Text="@Properties.Resources.Adjustments">
            <fieldset>
                <legend>@Properties.Resources.AdjustTo</legend>
                <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="AdjustToQuarterAsync">@Properties.Resources.Quarter</GXButton>
                <GXButton type="button" Disabled="@(!CanInvokeMethod(2))" OnClick="AdjustToMeasuringPeriodAsync">@Properties.Resources.MeasuringPeriod</GXButton>
                <GXButton type="button" Disabled="@(!CanInvokeMethod(3))" OnClick="AdjustToMinuteAsync">@Properties.Resources.Minute</GXButton>
                <GXButton type="button" Disabled="@(!CanInvokeMethod(4))" OnClick="AdjustToPresetTimeAsync">@Properties.Resources.PresetTime</GXButton>
            </fieldset>
            <fieldset>
                <legend>@Properties.Resources.PresetAdjustingTime</legend>
                <GXValueField Label="@Properties.Resources.PresetTimeLabel" Value="@PresetTimeText" Enabled="CanInvokeMethod(5)" InputKind="datetime" OnCommit="text => PresetTimeText = text" />
                <GXValueField Label="@Properties.Resources.ValidityStartLabel" Value="@ValidityStartText" Enabled="CanInvokeMethod(5)" InputKind="datetime" OnCommit="text => ValidityStartText = text" />
                <GXValueField Label="@Properties.Resources.ValidityEndLabel" Value="@ValidityEndText" Enabled="CanInvokeMethod(5)" InputKind="datetime" OnCommit="text => ValidityEndText = text" />
                <GXButton type="button" Disabled="@(!CanInvokeMethod(5))" OnClick="PresetAdjustingTimeAsync">@Properties.Resources.PresetAdjustingTime2</GXButton>
            </fieldset>
            <div class="clock-inline-action clock-number-action">
                <GXValueField Label="@Properties.Resources.ShiftSecondsLabel" Value="@ShiftSeconds" Enabled="CanInvokeMethod(6)" InputKind="number" Validate="ValidateShift" OnCommit="text => ShiftSeconds = text" />
                <GXButton type="button" Disabled="@(!CanInvokeMethod(6))" OnClick="ShiftTimeAsync">@Properties.Resources.ShiftTime</GXButton>
            </div>
        </GXTabPage>
    </GXTabControl>
</section>
@code {
    /// <summary>References the clock time editor used to stage the current time. References the time-zone editor used to stage the local offset.</summary>
    private GXAttributeField? _timeField, _timeZoneField;
    /// <summary>Opens the time field and fills its draft with the current local time.</summary>
    private void ConfirmCurrentTime()
    {
        if (_timeField is null || !CanEditAttribute(2))
        {
            return;
        }
        _timeField.BeginEdit();
        _timeField.Draft = new GXDateTime(DateTime.Now).ToFormatMeterString(CultureInfo.InvariantCulture);
    }
    /// <summary>Opens the time-zone field and fills its draft with the current local offset.</summary>
    private void ConfirmCurrentTimeZone()
    {
        if (_timeZoneField is null || !CanEditAttribute(3))
        {
            return;
        }
        _timeZoneField.BeginEdit();
        _timeZoneField.Draft = (-(int)TimeZoneInfo.Local.BaseUtcOffset.TotalMinutes).ToString(CultureInfo.InvariantCulture);
    }
    /// <summary>Gets the clock&apos;s current date-time value when it can be converted.</summary>
    private DateTime? TimeValue
    {
        get => Edit.AttributeValue(2) switch
        {
            GXDateTime value when value.Value.DateTime != DateTime.MinValue => value.Value.DateTime,
            DateTime value when value != DateTime.MinValue => value,
            DateTimeOffset value when value.DateTime != DateTime.MinValue => value.DateTime,
            _ => null
        };
        set => ChangeAttribute(2, value.HasValue
            ? new GXDateTime(value.Value).ToFormatMeterString(CultureInfo.InvariantCulture)
            : string.Empty);
    }
    /// <summary>Validates that the requested time shift is between -900 and 900 seconds.</summary>
    /// <param name="text">The user input in the editor&apos;s invariant text representation.</param>
    /// <returns>The validation message, or null when the input is valid.</returns>
    private static string? ValidateShift(string text) => int.TryParse(text, out var value) && value is >= -900 and <= 900 ? null : Properties.Resources.ShiftSecondsMustBeBetween900And900;
    /// <summary>
    /// Meter date and time entered for the preset-adjustment request.
    /// </summary>
    public string PresetTimeText { get; set; } = string.Empty;
    /// <summary>
    /// Start of the validity interval for the preset time.
    /// </summary>
    public string ValidityStartText { get; set; } = string.Empty;
    /// <summary>
    /// End of the validity interval for the preset time.
    /// </summary>
    public string ValidityEndText { get; set; } = string.Empty;
    /// <summary>
    /// Signed number of seconds entered for the clock-shift request.
    /// </summary>
    public string ShiftSeconds { get; set; } = string.Empty;
    /// <summary>
    /// Requests clock adjustment to the nearest quarter hour.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task AdjustToQuarterAsync() => InvokeMethodAsync(1, client => Target.AdjustToQuarter(client));
    /// <summary>
    /// Requests clock adjustment to the measuring-period boundary.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task AdjustToMeasuringPeriodAsync() => InvokeMethodAsync(2, client => Target.AdjustToMeasuringPeriod(client));
    /// <summary>
    /// Requests clock adjustment to the nearest minute.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task AdjustToMinuteAsync() => InvokeMethodAsync(3, client => Target.AdjustToMinute(client));
    /// <summary>
    /// Requests clock adjustment to the previously preset time.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task AdjustToPresetTimeAsync() => InvokeMethodAsync(4, client => Target.AdjustToPresetTime(client));
    /// <summary>
    /// Requests the entered preset time and its validity interval.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task PresetAdjustingTimeAsync() => InvokeMethodAsync(5, client =>
    {
        var formats = new[] { "yyyy-MM-ddTHH:mm:ss", "yyyy-MM-ddTHH:mm" };
        var preset = DateTime.ParseExact(PresetTimeText, formats, CultureInfo.InvariantCulture, DateTimeStyles.None);
        var start = DateTime.ParseExact(ValidityStartText, formats, CultureInfo.InvariantCulture, DateTimeStyles.None);
        var end = DateTime.ParseExact(ValidityEndText, formats, CultureInfo.InvariantCulture, DateTimeStyles.None);
        if (start > end)
        {
            throw new FormatException(Properties.Resources.TheValidityStartMustNotFollowTheValidityEnd);
        }
        return Target.PresetAdjustingTime(client, preset, start, end);
    });
    /// <summary>
    /// Requests a clock shift by the entered number of seconds.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task ShiftTimeAsync() => InvokeMethodAsync(6, client =>
    {
        var seconds = int.Parse(ShiftSeconds, CultureInfo.InvariantCulture);
        if (seconds < -900 || seconds > 900)
        {
            throw new FormatException(Properties.Resources.ShiftSecondsMustBeBetween900And900);
        }
        return Target.ShiftTime(client, seconds);
    });
    /// <summary>
    /// Whether the edited clock has daylight saving enabled.
    /// </summary>
    public bool DaylightEnabled => Convert.ToBoolean(Edit.AttributeValue(8), CultureInfo.InvariantCulture);
    /// <summary>
    /// Whether the edited clock specifies a time-zone deviation.
    /// </summary>
    public bool TimeZoneEnabled => Convert.ToInt32(Edit.AttributeValue(3), CultureInfo.InvariantCulture) != short.MinValue;
    /// <summary>
    /// Clock status flags from the pending or current attribute value.
    /// </summary>
    public ClockStatus Status => (ClockStatus)Convert.ToByte(Edit.AttributeValue(4), CultureInfo.InvariantCulture);
    /// <summary>
    /// Stages a clock attribute from the supplied text and refreshes the view.
    /// </summary>
    /// <param name="index">One-based clock attribute index.</param>
    /// <param name="text">Text to parse and stage.</param>
    public void ChangeAttribute(int index, string text)
    {
        if (index < 2 || index > 9 || !CanEditAttribute(index) || index is >= 5 and <= 7 && !DaylightEnabled)
        {
            return;
        }
        Edit.EditAttribute(index, text);
    }
    /// <summary>
    /// Stages the local current date and time as the meter clock value.
    /// </summary>
    public void UseCurrentTime() => ChangeAttribute(2, new GXDateTime(DateTime.Now).ToFormatMeterString(CultureInfo.InvariantCulture));
    /// <summary>
    /// Stages the local time-zone deviation as the meter clock deviation.
    /// </summary>
    public void UseCurrentTimeZone() => ChangeAttribute(3, (-(int)TimeZoneInfo.Local.BaseUtcOffset.TotalMinutes).ToString(CultureInfo.InvariantCulture));
    /// <summary>
    /// Stages the local time-zone deviation or the unspecified-deviation value.
    /// </summary>
    /// <param name="enabled">Whether the local time-zone deviation is specified.</param>
    public void EnableTimeZone(bool enabled)
    {
        if (enabled)
        {
            UseCurrentTimeZone();
        }
        else
        {
            ChangeAttribute(3, short.MinValue.ToString(CultureInfo.InvariantCulture));
        }
    }
    /// <summary>
    /// Adds or removes a flag in the edited clock status.
    /// </summary>
    /// <param name="enabled">Whether to set the flag.</param>
    /// <param name="flag">Clock status flag to change.</param>
    public void ChangeStatus(ClockStatus flag, bool enabled)
        => ChangeAttribute(4, ((byte)(enabled ? Status | flag : Status & ~flag)).ToString(CultureInfo.InvariantCulture));
}
