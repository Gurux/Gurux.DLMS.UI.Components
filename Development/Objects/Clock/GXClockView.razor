@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using Gurux.UI.Components
@using Gurux.UI.Components.Tab
@inherits GXDLMSObjectViewBase<GXDLMSClock>

<section class="gx-clock-view" @key="Target">
    <GXObjectViewHeader Target="Target" Edit="Edit" Error="@ActionError" Title="Clock Object" />
    <GXTabControl NavigateOnSelection="false">
        <GXTabPage Text="General">
            <div class="clock-inline-action clock-time-action">
                <GXAttributeField @ref="_timeField" Edit="Edit" Index="2" Label="Time:" Enabled="CanEditAttribute(2)" InputKind="datetime" />
                <GXButton type="button" Disabled="@(!CanEditAttribute(2))" OnClick="ConfirmCurrentTime">Current time</GXButton>
            </div>
            <GXValueField Label="Use time zone:" Value="@TimeZoneEnabled.ToString()" Enabled="CanEditAttribute(3)" InputKind="bool" OnCommit="text => EnableTimeZone(bool.Parse(text))" />
            <div class="clock-inline-action clock-number-action">
                <GXAttributeField @ref="_timeZoneField" Edit="Edit" Index="3" Label="Time Zone:" Enabled="@(CanEditAttribute(3) && TimeZoneEnabled)" />
                <GXButton type="button" Disabled="@(!CanEditAttribute(3) || !TimeZoneEnabled)" OnClick="ConfirmCurrentTimeZone">Current time Zone</GXButton>
            </div>
            <GXAttributeField Edit="Edit" Index="4" Label="Status:" Enabled="CanEditAttribute(4)" EnumType="typeof(ClockStatus)" />
            <fieldset>
                <legend>Daylight Savings</legend>
                <GXAttributeField Edit="Edit" Index="5" Label="Begin:" Enabled="@(CanEditAttribute(5) && DaylightEnabled)" InputKind="datetime" />
                <GXAttributeField Edit="Edit" Index="6" Label="End:" Enabled="@(CanEditAttribute(6) && DaylightEnabled)" InputKind="datetime" />
                <GXAttributeField Edit="Edit" Index="7" Label="Deviation:" Enabled="@(CanEditAttribute(7) && DaylightEnabled)" />
                <GXAttributeField Edit="Edit" Index="8" Label="Enabled:" Enabled="CanEditAttribute(8)" InputKind="bool" />
            </fieldset>
            <GXAttributeField Edit="Edit" Index="9" Label="Clock Base:" Enabled="CanEditAttribute(9)" EnumType="typeof(ClockBase)" />
        </GXTabPage>
        <GXTabPage Text="Adjustments">
            <fieldset>
                <legend>Adjust to</legend>
                <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="AdjustToQuarterAsync">Quarter</GXButton>
                <GXButton type="button" Disabled="@(!CanInvokeMethod(2))" OnClick="AdjustToMeasuringPeriodAsync">Measuring period</GXButton>
                <GXButton type="button" Disabled="@(!CanInvokeMethod(3))" OnClick="AdjustToMinuteAsync">Minute</GXButton>
                <GXButton type="button" Disabled="@(!CanInvokeMethod(4))" OnClick="AdjustToPresetTimeAsync">Preset time</GXButton>
            </fieldset>
            <fieldset>
                <legend>Preset Adjusting Time</legend>
                <GXValueField Label="Preset time:" Value="@PresetTimeText" Enabled="CanInvokeMethod(5)" InputKind="datetime" OnCommit="text => PresetTimeText = text" />
                <GXValueField Label="Validity start:" Value="@ValidityStartText" Enabled="CanInvokeMethod(5)" InputKind="datetime" OnCommit="text => ValidityStartText = text" />
                <GXValueField Label="Validity end:" Value="@ValidityEndText" Enabled="CanInvokeMethod(5)" InputKind="datetime" OnCommit="text => ValidityEndText = text" />
                <GXButton type="button" Disabled="@(!CanInvokeMethod(5))" OnClick="PresetAdjustingTimeAsync">Preset Adjusting Time...</GXButton>
            </fieldset>
            <div class="clock-inline-action clock-number-action">
                <GXValueField Label="Shift seconds:" Value="@ShiftSeconds" Enabled="CanInvokeMethod(6)" InputKind="number" Validate="ValidateShift" OnCommit="text => ShiftSeconds = text" />
                <GXButton type="button" Disabled="@(!CanInvokeMethod(6))" OnClick="ShiftTimeAsync">Shift Time...</GXButton>
            </div>
        </GXTabPage>
    </GXTabControl>
</section>
@code {
    private GXAttributeField? _timeField, _timeZoneField;
    private void ConfirmCurrentTime() { if (_timeField is null || !CanEditAttribute(2)) return; _timeField.BeginEdit(); _timeField.Draft = new GXDateTime(DateTime.Now).ToFormatMeterString(CultureInfo.InvariantCulture); }
    private void ConfirmCurrentTimeZone() { if (_timeZoneField is null || !CanEditAttribute(3)) return; _timeZoneField.BeginEdit(); _timeZoneField.Draft = (-(int)TimeZoneInfo.Local.BaseUtcOffset.TotalMinutes).ToString(CultureInfo.InvariantCulture); }
    private DateTime? TimeValue
    {
        get => Edit.AttributeValue(2) switch
        {
            GXDateTime value when value.Value.DateTime != DateTime.MinValue => value.Value.DateTime,
            DateTime value when value != DateTime.MinValue => value,
            DateTimeOffset value when value.DateTime != DateTime.MinValue => value.DateTime,
            _ => null
        };
        set => ChangeAttribute(2, value.HasValue
            ? new GXDateTime(value.Value).ToFormatMeterString(CultureInfo.InvariantCulture)
            : string.Empty);
    }
    private static string? ValidateShift(string text) => int.TryParse(text, out var value) && value is >= -900 and <= 900 ? null : "Shift seconds must be between -900 and 900.";
    public string PresetTimeText { get; set; } = string.Empty;
    public string ValidityStartText { get; set; } = string.Empty;
    public string ValidityEndText { get; set; } = string.Empty;
    public string ShiftSeconds { get; set; } = string.Empty;
    public Task AdjustToQuarterAsync() => InvokeMethodAsync(1, client => Target.AdjustToQuarter(client));
    public Task AdjustToMeasuringPeriodAsync() => InvokeMethodAsync(2, client => Target.AdjustToMeasuringPeriod(client));
    public Task AdjustToMinuteAsync() => InvokeMethodAsync(3, client => Target.AdjustToMinute(client));
    public Task AdjustToPresetTimeAsync() => InvokeMethodAsync(4, client => Target.AdjustToPresetTime(client));
    public Task PresetAdjustingTimeAsync() => InvokeMethodAsync(5, client =>
    {
        var formats = new[] { "yyyy-MM-ddTHH:mm:ss", "yyyy-MM-ddTHH:mm" };
        var preset = DateTime.ParseExact(PresetTimeText, formats, CultureInfo.InvariantCulture, DateTimeStyles.None);
        var start = DateTime.ParseExact(ValidityStartText, formats, CultureInfo.InvariantCulture, DateTimeStyles.None);
        var end = DateTime.ParseExact(ValidityEndText, formats, CultureInfo.InvariantCulture, DateTimeStyles.None);
        if (start > end) throw new FormatException("The validity start must not follow the validity end.");
        return Target.PresetAdjustingTime(client, preset, start, end);
    });
    public Task ShiftTimeAsync() => InvokeMethodAsync(6, client =>
    {
        var seconds = int.Parse(ShiftSeconds, CultureInfo.InvariantCulture);
        if (seconds < -900 || seconds > 900) throw new FormatException("Shift seconds must be between -900 and 900.");
        return Target.ShiftTime(client, seconds);
    });
    public bool DaylightEnabled => Convert.ToBoolean(Edit.AttributeValue(8), CultureInfo.InvariantCulture);
    public bool TimeZoneEnabled => Convert.ToInt32(Edit.AttributeValue(3), CultureInfo.InvariantCulture) != short.MinValue;
    public ClockStatus Status => (ClockStatus)Convert.ToByte(Edit.AttributeValue(4), CultureInfo.InvariantCulture);
    public void ChangeAttribute(int index, string text)
    {
        if (index < 2 || index > 9 || !CanEditAttribute(index) || index is >= 5 and <= 7 && !DaylightEnabled) return;
        Edit.EditAttribute(index, text);
    }
    public void UseCurrentTime() => ChangeAttribute(2, new GXDateTime(DateTime.Now).ToFormatMeterString(CultureInfo.InvariantCulture));
    public void UseCurrentTimeZone() => ChangeAttribute(3, (-(int)TimeZoneInfo.Local.BaseUtcOffset.TotalMinutes).ToString(CultureInfo.InvariantCulture));
    public void EnableTimeZone(bool enabled)
    {
        if (enabled) UseCurrentTimeZone();
        else ChangeAttribute(3, short.MinValue.ToString(CultureInfo.InvariantCulture));
    }
    public void ChangeStatus(ClockStatus flag, bool enabled)
        => ChangeAttribute(4, ((byte)(enabled ? Status | flag : Status & ~flag)).ToString(CultureInfo.InvariantCulture));
}
