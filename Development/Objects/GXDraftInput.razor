@* <summary>Edits a draft scalar or enumeration value and reports input changes.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.UI.Components
@using Gurux.UI.Components.BitEditor

@if (ValueItems is { Count: > 0 })
{
    @NamedEditor
}
else if (EnumType?.IsEnum == true && !EnumType.IsDefined(typeof(FlagsAttribute), false))
{
    <select id="@Id" class="form-select" aria-label="@Label" disabled="@Disabled" value="@EnumValue" @onchange="e => Change(e.Value?.ToString() ?? string.Empty)">
        @foreach (var option in Enum.GetValues(EnumType).Cast<Enum>().Distinct())
        {
            <option value="@Convert.ToInt64(option, CultureInfo.InvariantCulture)">@option</option>
        }
    </select>
}
else if (EnumType?.IsEnum == true)
{
    <div class="gx-draft-flags" role="group" aria-label="@Label">
        @foreach (var option in Enum.GetValues(EnumType).Cast<Enum>().Distinct())
        {
            var flag = Convert.ToInt64(option, CultureInfo.InvariantCulture);
            <div class="gx-draft-flag">
                <GXInputSwitch TValue="bool" Inline="true" Save="false" id="@(_flagsId + "-" + flag)" role="switch"
                    Value="@(flag == 0 ? Flags == 0 : (Flags & flag) == flag)" ValueChanged="@(value => ChangeFlag(flag, value))" Disabled="Disabled" />
                <GXLabel for="@(_flagsId + "-" + flag)">@option</GXLabel>
            </div>
        }
    </div>
}
else if (InputKind == "bool")
{
    <GXInputSwitch TValue="bool" Inline="true" Save="false" id="@Id" role="switch" Value="@Boolean" ValueChanged="value => Change(value.ToString())" Disabled="Disabled" aria-label="@Label" />
}
else if (InputKind == "password")
{
    <GXInputPassword id="@Id" Value="@Value" ValueChanged="Change" ValueExpression="@(() => Value)" disabled="@Disabled" aria-label="@Label" />
}
else if (InputKind == "textarea")
{
    <GXInputTextArea id="@Id" Value="@Value" ValueChanged="Change" disabled="@Disabled" aria-label="@Label" rows="6" />
}
else if (InputKind == "ip")
{
    <GXInputIpAddress TItem="string" Save="false" id="@Id" Value="@Value" ValueChanged="Change" @oninput="e => Change(e.Value?.ToString())" disabled="@Disabled" aria-label="@Label" />
}
else if (InputKind == "hex")
{
    <GXInputText id="@Id" Value="@Value" ValueChanged="Change" disabled="@Disabled" aria-label="@Label" placeholder="@Properties.Resources.Hexadecimal" />
}
else if (InputKind == "number")
{
    <GXInputText id="@Id" Value="@Value" ValueChanged="Change" disabled="@Disabled" aria-label="@Label" inputmode="decimal" />
}
else if (InputKind is "datetime" or "date" or "time")
{
    <GXDateTimeSelector TItem="string" id="@Id" Value="@Value" ValueChanged="Change" Save="false" Disabled="Disabled" aria-label="@Label" />
}
else
{
    <GXInputText id="@Id" Value="@Value" ValueChanged="Change" disabled="@Disabled" aria-label="@Label" inputmode="@(InputKind == "number" ? "decimal" : null)" />
}

@code {
    /// <summary>Gets the manufacturer masks and their names in their supplied order.</summary>
    private IReadOnlyDictionary<ulong, string> NamedValues => ValueItems!
        .GroupBy(item => unchecked((ulong)(long)item.Value))
        .ToDictionary(group => group.Key, group => group.First().UIValue ?? string.Empty);
    /// <summary>Gets or sets whether the named-value bit editor displays its format selector.</summary>
    [Parameter] public bool ShowFormatSelector { get; set; } = true;

    /// <summary>Gets or sets the value representations shown below the named-value bit grid.</summary>
    [Parameter] public Gurux.UI.Components.Enums.GXBitEditorFormats DisplayFormats { get; set; } = Gurux.UI.Components.Enums.GXBitEditorFormats.All;
    /// <summary>Gets or sets the declared DLMS wire type used to preserve the bit width.</summary>
    [Parameter] public Gurux.DLMS.Enums.DataType WireType { get; set; }

    /// <summary>Gets the named bit editor specialized for the attribute's integer wire type.</summary>
    private RenderFragment NamedEditor => WireType switch
    {
        Gurux.DLMS.Enums.DataType.UInt8 or Gurux.DLMS.Enums.DataType.Enum => RenderNamedEditor<byte>(),
        Gurux.DLMS.Enums.DataType.UInt16 => RenderNamedEditor<ushort>(),
        Gurux.DLMS.Enums.DataType.UInt32 => RenderNamedEditor<uint>(),
        Gurux.DLMS.Enums.DataType.Int8 => RenderNamedEditor<sbyte>(),
        Gurux.DLMS.Enums.DataType.Int16 => RenderNamedEditor<short>(),
        Gurux.DLMS.Enums.DataType.Int32 => RenderNamedEditor<int>(),
        Gurux.DLMS.Enums.DataType.Int64 => RenderNamedEditor<long>(),
        _ => RenderNamedEditor<ulong>()
    };

    /// <summary>Renders a typed bit editor and forwards numeric edits through the existing draft validation.</summary>
    /// <typeparam name="T">The CLR integer type matching the declared DLMS wire width.</typeparam>
    /// <returns>The render fragment for the typed named bit editor.</returns>
    private RenderFragment RenderNamedEditor<T>() where T : struct => builder =>
    {
        var value = string.IsNullOrWhiteSpace(Value) ? default(T) : (T)Convert.ChangeType(Value, typeof(T), CultureInfo.InvariantCulture);
        builder.OpenComponent<GXBitEditor<T>>(0);
        builder.AddAttribute(1, nameof(GXBitEditor<T>.Value), value);
        builder.AddAttribute(2, nameof(GXBitEditor<T>.ValueChanged),
            EventCallback.Factory.Create<T>(this, next => Change(Convert.ToString(next, CultureInfo.InvariantCulture))));
        builder.AddAttribute(3, nameof(GXBitEditor<T>.ValueExpression), (System.Linq.Expressions.Expression<Func<T>>)(() => value));
        builder.AddAttribute(4, nameof(GXBitEditor<T>.NamedValues), NamedValues);
        builder.AddAttribute(5, nameof(GXBitEditor<T>.ReadOnly), Disabled);
        builder.AddAttribute(6, nameof(GXBitEditor<T>.Disabled), Disabled);
        builder.AddAttribute(7, nameof(GXBitEditor<T>.ShowToolbar), false);
        builder.AddAttribute(8, "aria-label", Label);
        builder.AddAttribute(9, nameof(GXBitEditor<T>.DisplayFormats), DisplayFormats);
        builder.AddAttribute(10, nameof(GXBitEditor<T>.ShowFormatSelector), ShowFormatSelector);
        builder.CloseComponent();
    };
    /// <summary>Manufacturer-defined device values and their display labels.</summary>
    [Parameter] public Gurux.DLMS.ManufacturerSettings.GXObisValueItemCollection? ValueItems { get; set; }
    /// <summary>
    /// HTML identifier of the input element.
    /// </summary>
    [Parameter] public string Id { get; set; } = string.Empty;
    /// <summary>
    /// Label displayed for the input value.
    /// </summary>
    [Parameter] public string Label { get; set; } = string.Empty;
    /// <summary>
    /// Value displayed and edited by the component.
    /// </summary>
    [Parameter] public string Value { get; set; } = string.Empty;
    /// <summary>
    /// Callback receiving a successfully converted edited value.
    /// </summary>
    [Parameter]
    public EventCallback<string> ValueChanged
    {
        get; set;
    }
    /// <summary>
    /// Input representation used to edit the value, such as text, hex, or datetime.
    /// </summary>
    [Parameter] public string InputKind { get; set; } = "text";
    /// <summary>
    /// Enumeration type whose members are offered as input choices.
    /// </summary>
    [Parameter]
    public Type? EnumType
    {
        get; set;
    }
    /// <summary>
    /// Whether user interaction with this control is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled
    {
        get; set;
    }
    /// <summary>Provides a unique HTML identifier prefix for the enum flag switches.</summary>
    private readonly string _flagsId = $"gx-flags-{Guid.NewGuid():N}";
    /// <summary>Gets the input value interpreted as a Boolean.</summary>
    private bool Boolean => bool.TryParse(Value, out var value) && value;
    /// <summary>Gets the numeric bit mask represented by the current enum input.</summary>
    private long Flags => long.TryParse(Value, out var value) ? value : EnumType is not null && Enum.TryParse(EnumType, Value, out var parsed) ? Convert.ToInt64(parsed, CultureInfo.InvariantCulture) : 0;
    /// <summary>Gets the enum input normalized to its invariant numeric representation.</summary>
    private string EnumValue => EnumType?.IsEnum == true && Enum.TryParse(EnumType, Value, out var parsed)
        ? Convert.ToInt64(parsed, CultureInfo.InvariantCulture).ToString(CultureInfo.InvariantCulture) : Value;
    /// <summary>Updates the editable draft when editing is enabled.</summary>
    /// <param name="value">The input value to convert, format or stage.</param>
    /// <returns>A task that completes when the request or callback has finished.</returns>
    private System.Threading.Tasks.Task Change(string? value) => Disabled ? System.Threading.Tasks.Task.CompletedTask : ValueChanged.InvokeAsync(value ?? string.Empty);
    /// <summary>Sets or clears an enum bit and forwards the new input value.</summary>
    /// <param name="flag">The enum bit to set or clear; zero clears the mask.</param>
    /// <param name="enabled">Whether the selected flag or option is enabled.</param>
    /// <returns>A task that completes when the request or callback has finished.</returns>
    private System.Threading.Tasks.Task ChangeFlag(long flag, bool enabled) => Change((flag == 0 ? 0 : enabled ? Flags | flag : Flags & ~flag).ToString(CultureInfo.InvariantCulture));
}
