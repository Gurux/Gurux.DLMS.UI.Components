@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.DLMS.Objects
@inherits GXDLMSObjectViewBase<GXDLMSCoAPDiagnostic>

<section class="gx-object-view" @key="Target">
    <GXObjectViewHeader Title="CoAP Diagnostic Object" Target="Target" Edit="Edit" Error="@ActionError" />
    <fieldset class="gx-object-fields"><legend>Messages counter</legend>
        <GXAttributeField Edit="Edit" Index="2" Part="0" Label="Transmitted messages:" Enabled="CanEditAttribute(2)" />
        <GXAttributeField Edit="Edit" Index="2" Part="1" Label="Received messages:" Enabled="CanEditAttribute(2)" />
        <GXAttributeField Edit="Edit" Index="2" Part="2" Label="Retransmitted messages:" Enabled="CanEditAttribute(2)" />
        <GXAttributeField Edit="Edit" Index="2" Part="3" Label="Transmitted resets:" Enabled="CanEditAttribute(2)" />
        <GXAttributeField Edit="Edit" Index="2" Part="4" Label="Received resets:" Enabled="CanEditAttribute(2)" />
        <GXAttributeField Edit="Edit" Index="2" Part="5" Label="Transmitted acknowledgements:" Enabled="CanEditAttribute(2)" />
        <GXAttributeField Edit="Edit" Index="2" Part="6" Label="Received acknowledgements:" Enabled="CanEditAttribute(2)" />
        <GXAttributeField Edit="Edit" Index="2" Part="7" Label="Dropped messages:" Enabled="CanEditAttribute(2)" />
        <GXAttributeField Edit="Edit" Index="2" Part="8" Label="Non-piggybacked responses:" Enabled="CanEditAttribute(2)" />
        <GXAttributeField Edit="Edit" Index="2" Part="9" Label="Maximum retransmissions exceeded:" Enabled="CanEditAttribute(2)" />
    </fieldset>
    <fieldset class="gx-object-fields"><legend>Request and response counter</legend>
        <GXAttributeField Edit="Edit" Index="3" Part="0" Label="Received requests:" Enabled="CanEditAttribute(3)" />
        <GXAttributeField Edit="Edit" Index="3" Part="1" Label="Transmitted requests:" Enabled="CanEditAttribute(3)" />
        <GXAttributeField Edit="Edit" Index="3" Part="2" Label="Received responses:" Enabled="CanEditAttribute(3)" />
        <GXAttributeField Edit="Edit" Index="3" Part="3" Label="Transmitted responses:" Enabled="CanEditAttribute(3)" />
        <GXAttributeField Edit="Edit" Index="3" Part="4" Label="Transmitted client errors:" Enabled="CanEditAttribute(3)" />
        <GXAttributeField Edit="Edit" Index="3" Part="5" Label="Received client errors:" Enabled="CanEditAttribute(3)" />
        <GXAttributeField Edit="Edit" Index="3" Part="6" Label="Transmitted server errors:" Enabled="CanEditAttribute(3)" />
        <GXAttributeField Edit="Edit" Index="3" Part="7" Label="Received server errors:" Enabled="CanEditAttribute(3)" />
    </fieldset>
    <fieldset class="gx-object-fields"><legend>Block-wise transfer counter</legend>
        <GXAttributeField Edit="Edit" Index="4" Part="0" Label="Transfers started:" Enabled="CanEditAttribute(4)" />
        <GXAttributeField Edit="Edit" Index="4" Part="1" Label="Transfers completed:" Enabled="CanEditAttribute(4)" />
        <GXAttributeField Edit="Edit" Index="4" Part="2" Label="Transfers timed out:" Enabled="CanEditAttribute(4)" />
    </fieldset>
    <fieldset class="gx-object-fields"><legend>Capture time</legend>
        <GXAttributeField Edit="Edit" Index="5" Part="0" Label="Attribute ID:" Enabled="CanEditAttribute(5)" />
        <GXAttributeField Edit="Edit" Index="5" Part="1" Label="Capture time:" Enabled="CanEditAttribute(5)" />
    </fieldset>
    <section class="gx-object-actions">
        <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="ResetAsync">Reset counters</GXButton>
    </section>
</section>

@code {
    private Task ResetAsync() => InvokeMethodAsync(1, client => Target.Reset(client));
}
