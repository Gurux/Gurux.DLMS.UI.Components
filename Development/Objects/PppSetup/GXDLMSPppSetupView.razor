@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSPppSetup>


<section class="gx-network-view">
<div class="gx-view-content">
<GXObjectViewHeader Title="PPP Setup Object" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="PHY Reference:" Enabled="CanEditAttribute(2)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="LCP Options:" Enabled="CanEditAttribute(3)" Columns='@(new[] { "Type", "Length", "Data" })' CreateRow='@(() => new GXStructure { (byte)0, (byte)0, Array.Empty<byte>() })' />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="IPCP Options:" Enabled="CanEditAttribute(4)" Columns='@(new[] { "Type", "Length", "Data" })' CreateRow='@(() => new GXStructure { (byte)0, (byte)0, Array.Empty<byte>() })' />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="User Name:" Enabled="CanEditAttribute(5)" Part="0" InputKind="ascii" />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="Password:" Enabled="CanEditAttribute(5)" Part="1" InputKind="password" />
    }
</div>
</section>
