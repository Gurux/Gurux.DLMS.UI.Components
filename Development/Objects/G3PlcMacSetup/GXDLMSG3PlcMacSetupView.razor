@* <summary>Displays and edits DLMS g3 plc mac setup values and supported actions.</summary> *@

@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSG3PlcMacSetup>

@using Gurux.UI.Components.Tab

<section class="gx-network-view">
<div class="gx-view-content">
<GXObjectViewHeader Title="@Properties.Resources.G3PLCMACSetupObject" Target="Target" Edit="Edit" Error="@ActionError" />
<GXTabControl NavigateOnSelection="false">
<GXTabPage Text="@Properties.Resources.General">
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="@Properties.Resources.ShortAddressLabel" Enabled="CanEditAttribute(2)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.RouteCostToCoordLabel" Enabled="CanEditAttribute(3)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="@Properties.Resources.PANIDLabel" Enabled="CanEditAttribute(4)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
    {
        <GXAttributeField Edit="Edit" Index="6" Label="@Properties.Resources.FrameCounterLabel" Enabled="CanEditAttribute(6)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 7)
    {
        <GXAttributeField Edit="Edit" Index="7" Label="@Properties.Resources.ToneMaskLabel" Enabled="CanEditAttribute(7)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 8)
    {
        <GXAttributeField Edit="Edit" Index="8" Label="@Properties.Resources.ToneMapTTLLabel" Enabled="CanEditAttribute(8)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 9)
    {
        <GXAttributeField Edit="Edit" Index="9" Label="@Properties.Resources.MaxFrameRetriesLabel" Enabled="CanEditAttribute(9)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 10)
    {
        <GXAttributeField Edit="Edit" Index="10" Label="@Properties.Resources.NeighbourTableTTLLabel" Enabled="CanEditAttribute(10)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 12)
    {
        <GXAttributeField Edit="Edit" Index="12" Label="@Properties.Resources.HighPrioritySIzeLabel" Enabled="CanEditAttribute(12)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 13)
    {
        <GXAttributeField Edit="Edit" Index="13" Label="@Properties.Resources.CSCMFairnessLimitLabel" Enabled="CanEditAttribute(13)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 14)
    {
        <GXAttributeField Edit="Edit" Index="14" Label="@Properties.Resources.BeaconRndLabel" Enabled="CanEditAttribute(14)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 15)
    {
        <GXAttributeField Edit="Edit" Index="15" Label="@Properties.Resources.ALabel" Enabled="CanEditAttribute(15)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 16)
    {
        <GXAttributeField Edit="Edit" Index="16" Label="@Properties.Resources.KLabel" Enabled="CanEditAttribute(16)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 17)
    {
        <GXAttributeField Edit="Edit" Index="17" Label="@Properties.Resources.MinCWAttemptsLabel" Enabled="CanEditAttribute(17)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 18)
    {
        <GXAttributeField Edit="Edit" Index="18" Label="@Properties.Resources.CenelecLegacyLabel" Enabled="CanEditAttribute(18)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 19)
    {
        <GXAttributeField Edit="Edit" Index="19" Label="@Properties.Resources.FCCLegacyModeLabel" Enabled="CanEditAttribute(19)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 20)
    {
        <GXAttributeField Edit="Edit" Index="20" Label="@Properties.Resources.MaxBackoffLabel" Enabled="CanEditAttribute(20)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 21)
    {
        <GXAttributeField Edit="Edit" Index="21" Label="@Properties.Resources.MaxCSMABackoffs" Enabled="CanEditAttribute(21)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 22)
    {
        <GXAttributeField Edit="Edit" Index="22" Label="@Properties.Resources.MinBackoffLabel" Enabled="CanEditAttribute(22)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 23)
    {
        <GXAttributeField Edit="Edit" Index="23" Label="@Properties.Resources.BroadcastMaxCWEnabled" Enabled="CanEditAttribute(23)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 24)
    {
        <GXAttributeField Edit="Edit" Index="24" Label="@Properties.Resources.TransmitAttenLabel" Enabled="CanEditAttribute(24)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 26)
    {
        <GXAttributeField Edit="Edit" Index="26" Label="@Properties.Resources.DuplicateDetection" Enabled="CanEditAttribute(26)"  />
    }
</GXTabPage>
<GXTabPage Text="@Properties.Resources.KeyTable">
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="@Properties.Resources.KeyTable" Enabled="CanEditAttribute(5)" Columns='@(new[] { Properties.Resources.IDLabel, Properties.Resources.KeyLabel })' CreateRow='@(() => new GXStructure { (byte)0, new byte[16] })' />
    }
</GXTabPage>
<GXTabPage Text="@Properties.Resources.NeighbourTable">
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 11)
    {
        <GXAttributeField Edit="Edit" Index="11" Label="@Properties.Resources.NeighbourTable" Enabled="CanEditAttribute(11)" Columns='@(new[] { Properties.Resources.AddressLabel, Properties.Resources.EnabledLabel, Properties.Resources.ModulationLabel, Properties.Resources.ToneMapLabel })' CreateRow='@(() => new GXStructure { (ushort)0, false, new GXBitString("0"), new GXEnum(0), (sbyte)0, new GXEnum(0), new GXBitString("0"), (byte)0, (sbyte)0, (byte)0, (byte)0 })' ColumnIndices="@(new[] { 0, 1, 3, 2 })" EditorLabels='@(new[] { Properties.Resources.AddressLabel, Properties.Resources.EnabledLabel, Properties.Resources.ToneMapLabel, Properties.Resources.ModulationLabel, Properties.Resources.TXGain, Properties.Resources.TXResolution, Properties.Resources.TXCoefficients, Properties.Resources.LQI, Properties.Resources.PhaseDifferential, Properties.Resources.TMRValidTime, Properties.Resources.NeighbourValidTime })' />
    }
</GXTabPage>
<GXTabPage Text="@Properties.Resources.POSTable">
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 25)
    {
        <GXAttributeField Edit="Edit" Index="25" Label="@Properties.Resources.POSTable" Enabled="CanEditAttribute(25)" Columns='@(new[] { "_address", Properties.Resources.LQI, Properties.Resources.ValidTime2 })' CreateRow='@(() => new GXStructure { (ushort)0, (byte)0, (byte)0 })' />
    }
</GXTabPage>
</GXTabControl>
</div>
</section>
<section class="gx-object-actions">
    <GXValueField @key='@((Target, Properties.Resources.ShortAddress))' Label="@Properties.Resources.ShortAddress" Value="@_address" Enabled="@(CanInvokeMethod(1) || CanInvokeMethod(2))" InputKind="number" OnCommit="@(value => _address = value)" Validate='@(value => ushort.TryParse(value, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out _) ? null : Properties.Resources.EnterAShortAddressFrom0To65535)' />
    <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="NeighbourAsync">@Properties.Resources.GetNeighbourTableEntry</GXButton><GXButton type="button" Disabled="@(!CanInvokeMethod(2))" OnClick="PositionAsync">@Properties.Resources.GetPOSTableEntry</GXButton>
</section>
@code {
    /// <summary>Retains the address text supplied to the object&apos;s address methods.</summary>
    private string _address = "";
    /// <summary>Requests the neighbour-table entry for the specified short address.</summary>
    /// <returns>A task that completes when the request or callback has finished.</returns>
    private Task NeighbourAsync() => InvokeMethodAsync(1, client => Target.GetNeighbourTableEntry(client, ushort.Parse(_address, System.Globalization.CultureInfo.InvariantCulture)));
    /// <summary>Requests the position-table entry for the specified short address.</summary>
    /// <returns>A task that completes when the request or callback has finished.</returns>
    private Task PositionAsync() => InvokeMethodAsync(2, client => Target.GetPosTableEntry(client, ushort.Parse(_address, System.Globalization.CultureInfo.InvariantCulture)));
}


