@* <summary>Displays and edits DLMS security setup values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.DLMS
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Objects.Enums
@using Gurux.UI.Components.Tab
@using Gurux.UI.Components
@using Gurux.UI.Components.Table
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inherits GXDLMSObjectViewBase<GXDLMSSecuritySetup>

<section class="gx-object-view" @key="Target">
<GXObjectViewHeader Target="Target" Edit="Edit" Error="@ActionError" Title="@Properties.Resources.SecuritySetupObject" />
<GXTabControl NavigateOnSelection="false">
<GXTabPage Text="@Properties.Resources.General">
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
{
<GXAttributeField Edit="Edit" Index="2" Label="@Properties.Resources.PolicyLabel" Enabled="CanEditAttribute(2)" EnumType="@(Target.Version == 0 ? typeof(VersionZeroSecurityPolicy) : typeof(SecurityPolicy))" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
{
<GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.SuiteLabel" Enabled="CanEditAttribute(3)" EnumType="typeof(SecuritySuite)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
{
<GXAttributeField Edit="Edit" Index="4" Label="@Properties.Resources.ClientSystemTitleLabel" Enabled="CanEditAttribute(4)" InputKind="hex" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
{
<GXAttributeField Edit="Edit" Index="5" Label="@Properties.Resources.ServerSystemTitleLabel" Enabled="CanEditAttribute(5)" InputKind="hex" />
}
<GXValueField Label="@Properties.Resources.SystemTitleDescriptionLabel" Value="@SystemTitleDescription" Enabled="false" />
<fieldset><legend>@Properties.Resources.SecurityActivation</legend>
<GXValueField Label="@Properties.Resources.SecurityPolicyBitMaskLabel" Value="@PolicyText" Enabled="@(CanInvokeMethod(1))" OnCommit="@((string value) => { if (CanInvokeMethod(1)) { PolicyText = value; } })" InputKind="number" Validate="@(value => byte.TryParse(value, out var policy) && (Target.Version == 0 ? policy <= 3 : (policy & ~252) == 0) ? null : Properties.Resources.SecurityPolicyContainsUnsupportedFlags)" />
<GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="ActivateAsync">@Properties.Resources.ActivateSecurity</GXButton>
</fieldset>
<fieldset><legend>@Properties.Resources.KeyTransferAndAgreement</legend>
<GXValueField Label="@Properties.Resources.TypeLabel" Value="@KeyType.ToString()" Enabled="@(CanInvokeMethod(2) || CanInvokeMethod(3))" OnCommit="@((string value) => { if (CanInvokeMethod(2) || CanInvokeMethod(3)) { KeyType = Enum.Parse<GlobalKeyType>(value); } })" EnumType="typeof(GlobalKeyType)" />
<GXValueField Label="@Properties.Resources.KEKHexLabel" Value="@KekText" Enabled="@(CanInvokeMethod(2))" OnCommit="@((string value) => { if (CanInvokeMethod(2)) { KekText = value; } })" InputKind="password" Validate="@(value => CheckParameter(() => KeyValue(value)))" />
<GXValueField Label="@Properties.Resources.KeyHexLabel" Value="@KeyText" Enabled="@(CanInvokeMethod(2))" OnCommit="@((string value) => { if (CanInvokeMethod(2)) { KeyText = value; } })" InputKind="password" Validate="@(value => CheckParameter(() => KeyValue(value)))" />
<GXButton type="button" Disabled="@(!CanInvokeMethod(2))" OnClick="TransferKeyAsync">@Properties.Resources.UpdateKey</GXButton>
@if (Target.Version > 0)
{
<GXValueField Label="@Properties.Resources.SignedEphemeralPublicKeyHexLabel" Value="@AgreementText" Enabled="@(CanInvokeMethod(3))" OnCommit="@((string value) => { if (CanInvokeMethod(3)) { AgreementText = value; } })" InputKind="hex" Validate="@(value => CheckParameter(() => RequireParameter(Target.SecuritySuite != SecuritySuite.Suite0 && Hex(value).Length == (Target.SecuritySuite == SecuritySuite.Suite2 ? 192 : 128), Properties.Resources.EnterASignedEphemeralPublicKeyForSecuritySuiteOneOrTwo)))" />
<GXButton type="button" Disabled="@(!CanInvokeMethod(3))" OnClick="AgreeAsync">@Properties.Resources.AgreeKey</GXButton>
}
</fieldset>
</GXTabPage>
@if (Target.Version > 0)
{
<GXTabPage Text="@Properties.Resources.Certificates">
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
{
<GXTable @key="CertificateTableKey" TItem="GXDLMSCertificateInfo" ItemsProvider="CertificateItems" Filter="false" Menu="false" Total="false" ShowAllData="true" Save="false" AllowColumnCustomization="false">
<HeaderContent>
    <GXTh TItem="GXDLMSCertificateInfo">@Properties.Resources.Entity</GXTh><GXTh TItem="GXDLMSCertificateInfo">@Properties.Resources.Type</GXTh>
    <GXTh TItem="GXDLMSCertificateInfo">@Properties.Resources.SerialNumber</GXTh><GXTh TItem="GXDLMSCertificateInfo">@Properties.Resources.Issuer</GXTh>
    <GXTh TItem="GXDLMSCertificateInfo">@Properties.Resources.Subject</GXTh><GXTh TItem="GXDLMSCertificateInfo">@Properties.Resources.SubjectAltName</GXTh>
</HeaderContent>
<ItemContent Context="certificate">
    <GXTd>@certificate.Entity</GXTd><GXTd>@certificate.Type</GXTd><GXTd>@certificate.SerialNumber</GXTd>
    <GXTd>@certificate.Issuer</GXTd><GXTd>@certificate.Subject</GXTd><GXTd>@certificate.SubjectAltName</GXTd>
</ItemContent>
</GXTable>
}
<GXValueField Label="@Properties.Resources.CertificateTypeLabel" Value="@SelectedCertificateType.ToString()" Enabled="@(CanInvokeMethod(4) || CanInvokeMethod(5) || CanInvokeMethod(7) || CanInvokeMethod(8))" OnCommit="@((string value) => { if (CanInvokeMethod(4) || CanInvokeMethod(5) || CanInvokeMethod(7) || CanInvokeMethod(8)) { SelectedCertificateType = Enum.Parse<CertificateType>(value); } })" EnumType="typeof(CertificateType)" />
<GXButton type="button" Disabled="@(!CanInvokeMethod(4))" OnClick="GenerateKeyAsync">@Properties.Resources.KeyPair</GXButton>
<GXButton type="button" Disabled="@(!CanInvokeMethod(5))" OnClick="GenerateRequestAsync">@Properties.Resources.CertificateRequest</GXButton>
<GXValueField Label="@Properties.Resources.X509CertificateDERHexLabel" Value="@CertificateText" Enabled="@(CanInvokeMethod(6))" OnCommit="@((string value) => { if (CanInvokeMethod(6)) { CertificateText = value; } })" InputKind="hex" Validate="@(value => CheckParameter(() => { _ = new Gurux.DLMS.ASN.GXx509Certificate(Hex(value)); }))" />
<GXButton type="button" Disabled="@(!CanInvokeMethod(6))" OnClick="ImportAsync">@Properties.Resources.ImportCertificate</GXButton>
<GXValueField Label="@Properties.Resources.IdentifyBySerialNumberAndIssuerLabel" Value="@UseSerial.ToString()" Enabled="@(CanInvokeMethod(7) || CanInvokeMethod(8))" EnumType="typeof(BooleanChoice)" OnCommit="@((string value) => { if (CanInvokeMethod(7) || CanInvokeMethod(8)) { UseSerial = Enum.Parse<BooleanChoice>(value) == BooleanChoice.True; } })" />
@if (UseSerial)
{
<GXValueField Label="@Properties.Resources.SerialNumberDecimalLabel" Value="@SerialText" Enabled="@(CanInvokeMethod(7) || CanInvokeMethod(8))" OnCommit="@((string value) => { if (CanInvokeMethod(7) || CanInvokeMethod(8)) { SerialText = value; } })" InputKind="number" Validate="@(value => System.Numerics.BigInteger.TryParse(value, out var number) && number > 0 ? null : Properties.Resources.CertificateSerialNumberMustBePositive)" />
<GXValueField Label="@Properties.Resources.IssuerDERHexLabel" Value="@IssuerText" Enabled="@(CanInvokeMethod(7) || CanInvokeMethod(8))" OnCommit="@((string value) => { if (CanInvokeMethod(7) || CanInvokeMethod(8)) { IssuerText = value; } })" InputKind="hex" Validate="@(value => CheckParameter(() => RequireParameter(Hex(value).Length > 0, Properties.Resources.ADERIssuerIsRequired)))" />
}
else
{
<GXValueField Label="@Properties.Resources.EntityLabel" Value="@Entity.ToString()" Enabled="@(CanInvokeMethod(7) || CanInvokeMethod(8))" OnCommit="@((string value) => { if (CanInvokeMethod(7) || CanInvokeMethod(8)) { Entity = Enum.Parse<CertificateEntity>(value); } })" EnumType="typeof(CertificateEntity)" />
<GXValueField Label="@Properties.Resources.SystemTitle8BytesHexLabel" Value="@SystemTitleText" Enabled="@(CanInvokeMethod(7) || CanInvokeMethod(8))" OnCommit="@((string value) => { if (CanInvokeMethod(7) || CanInvokeMethod(8)) { SystemTitleText = value; } })" InputKind="hex" Validate="@(value => CheckParameter(() => RequireParameter(Hex(value).Length == 8, Properties.Resources.SystemTitleMustContainEightBytes)))" />
}
<GXButton type="button" Disabled="@(!CanInvokeMethod(7))" OnClick="ExportAsync">@Properties.Resources.ExportCertificate</GXButton>
<GXButton type="button" Disabled="@(!CanInvokeMethod(8))" OnClick="RemoveAsync">@Properties.Resources.RemoveCertificate</GXButton>
<p>@Properties.Resources.CertificateRequestsAndExportResponsesAreReturnedToTheConnectionSession</p>
</GXTabPage>
}
</GXTabControl>
</section>

@code {
    /// <summary>Gets a render key that changes when certificate table contents change.</summary>
    private string CertificateTableKey => string.Join("\n", Target.Certificates.Select(certificate =>
        $"{certificate.Entity}\t{certificate.Type}\t{certificate.SerialNumber}\t{certificate.Issuer}\t{certificate.Subject}\t{certificate.SubjectAltName}"));
    /// <summary>Supplies the object&apos;s certificate rows and their total count.</summary>
    /// <param name="request">The table request; this provider returns the complete current row set.</param>
    /// <returns>The current table rows together with their total count.</returns>
    private ValueTask<ItemsProviderResult<GXDLMSCertificateInfo>> CertificateItems(GXItemsProviderRequest request)
    {
        var rows = Target.Certificates.ToArray();
        return ValueTask.FromResult(new ItemsProviderResult<GXDLMSCertificateInfo>(rows, rows.Length));
    }

    /// <summary>Runs parameter validation and converts validation exceptions into input error text.</summary>
    /// <param name="validate">The validation callback whose input exceptions become error text.</param>
    /// <returns>The validation message, or null when the input is valid.</returns>
    private static string? CheckParameter(Action validate)
    {
        try
        {
            validate();
            return null;
        }
        catch (Exception error) when (error is not OutOfMemoryException) { return error.Message; }
    }
    /// <summary>Throws an argument exception when a method parameter condition is not satisfied.</summary>
    /// <param name="valid">Whether the required parameter condition is satisfied.</param>
    /// <param name="message">The error shown when the required condition is not satisfied.</param>
    private static void RequireParameter(bool valid, string message)
    {
        if (!valid)
        {
            throw new ArgumentException(message);
        }
    }

    /// <summary>Gets the human-readable description of the configured system title.</summary>
    private string SystemTitleDescription
    {
        get
        {
            try
            {
                return GXDLMSConverter.SystemTitleToString(Standard.DLMS, Target.GetDirty(5, out var pending) && pending is byte[] title ? title : Target.ServerSystemTitle, true);
            }
            catch (Exception error) when (error is not OutOfMemoryException) { return string.Empty; }
        }
    }

    /// <summary>Represents the Boolean choices accepted by method parameter editors.</summary>
    private enum BooleanChoice
    {
        /// <summary>Represents the disabled or false method parameter value.</summary>
        False,
        /// <summary>Represents the enabled or true method parameter value.</summary>
        True
    }

    // The pinned API exposes both versions through SecurityPolicy, but version zero is a four-value enum.
    /// <summary>
    /// Security-policy values supported by version-zero security setup objects.
    /// </summary>
    public enum VersionZeroSecurityPolicy : byte
    {
        /// <summary>No authentication or encryption.</summary>
        None = 0,
        /// <summary>Authentication without encryption.</summary>
        Authenticated = 1,
        /// <summary>Encryption without authentication.</summary>
        Encrypted = 2,
        /// <summary>Authentication and encryption.</summary>
        AuthenticatedEncrypted = 3
    }
    /// <summary>
    /// Numeric security policy entered for activation.
    /// </summary>
    public string PolicyText { get; set; } = "";
    /// <summary>
    /// Global key type selected for transfer or agreement.
    /// </summary>
    public GlobalKeyType KeyType
    {
        get; set;
    }
    /// <summary>
    /// Hexadecimal key-encrypting key used to protect the transferred key.
    /// </summary>
    public string KekText { get; set; } = "";
    /// <summary>
    /// Hexadecimal key material entered for global key transfer.
    /// </summary>
    public string KeyText { get; set; } = "";
    /// <summary>
    /// Hexadecimal signed ephemeral public key entered for key agreement.
    /// </summary>
    public string AgreementText { get; set; } = "";
    /// <summary>
    /// Certificate type selected for key generation and certificate operations.
    /// </summary>
    public CertificateType SelectedCertificateType
    {
        get; set;
    }
    /// <summary>
    /// Certificate entity selected when identifying a certificate by entity.
    /// </summary>
    public CertificateEntity Entity
    {
        get; set;
    }
    /// <summary>
    /// Hexadecimal DER certificate entered for import.
    /// </summary>
    public string CertificateText { get; set; } = "";
    /// <summary>
    /// Hexadecimal system title identifying the certificate owner.
    /// </summary>
    public string SystemTitleText { get; set; } = "";
    /// <summary>
    /// Whether certificate operations identify certificates by serial number.
    /// </summary>
    public bool UseSerial
    {
        get; set;
    }
    /// <summary>
    /// Positive certificate serial number entered for export or removal.
    /// </summary>
    public string SerialText { get; set; } = "";
    /// <summary>
    /// Hexadecimal DER issuer name entered for export or removal.
    /// </summary>
    public string IssuerText { get; set; } = "";
    /// <summary>Decodes hexadecimal input after removing whitespace.</summary>
    /// <param name="text">The user input in the editor&apos;s invariant text representation.</param>
    /// <returns>The decoded bytes after validation.</returns>
    private static byte[] Hex(string text) => Convert.FromHexString(new string(text.Where(c => !char.IsWhiteSpace(c)).ToArray()));
    /// <summary>Decodes a security key and checks its byte length against the selected suite.</summary>
    /// <param name="text">The user input in the editor&apos;s invariant text representation.</param>
    /// <returns>The decoded bytes after validation.</returns>
    private byte[] KeyValue(string text)
    {
        var value = Hex(text);
        var length = Target.SecuritySuite == SecuritySuite.Suite2 ? 32 : 16;
        if (value.Length != length)
        {
            throw new ArgumentException(string.Format(System.Globalization.CultureInfo.CurrentCulture, Properties.Resources.TheSelectedSecuritySuiteRequires0KeyBytes, length));
        }
        return value;
    }
    /// <summary>Decodes and validates the eight-byte system title supplied to certificate methods.</summary>
    /// <returns>The title for the current account table attribute.</returns>
    private byte[] Title()
    {
        var value = Hex(SystemTitleText);
        if (value.Length != 8)
        {
            throw new ArgumentException(Properties.Resources.SystemTitleMustContainEightBytes);
        }
        return value;
    }
    /// <summary>Parses and validates the positive certificate serial number.</summary>
    /// <returns>The parsed value in the representation required by the method.</returns>
    private System.Numerics.BigInteger Serial()
    {
        var value = System.Numerics.BigInteger.Parse(SerialText, System.Globalization.CultureInfo.InvariantCulture);
        if (value <= 0)
        {
            throw new ArgumentException(Properties.Resources.CertificateSerialNumberMustBePositive);
        }
        return value;
    }
    /// <summary>Decodes the required DER-encoded certificate issuer.</summary>
    /// <returns>The decoded bytes after validation.</returns>
    private byte[] Issuer()
    {
        var value = Hex(IssuerText);
        if (value.Length == 0)
        {
            throw new ArgumentException(Properties.Resources.ADERIssuerIsRequired);
        }
        return value;
    }
    /// <summary>
    /// Requests activation of the entered security policy.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task ActivateAsync() => InvokeMethodAsync(1, client =>
    {
        var policy = byte.Parse(PolicyText, System.Globalization.CultureInfo.InvariantCulture);
        if (Target.Version == 0)
        {
            if (policy > 3)
            {
                throw new ArgumentException(Properties.Resources.VersionZeroSecurityPolicyMustBeBetweenZeroAndThree);
            }
        }
        else if ((policy & ~252) != 0)
        {
            throw new ArgumentException(Properties.Resources.SecurityPolicyContainsUnsupportedFlags);
        }
        return Target.Activate(client, (SecurityPolicy)policy);
    });
    /// <summary>
    /// Requests transfer of the entered global key protected with the key-encrypting key.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task TransferKeyAsync() => InvokeMethodAsync(2, client =>
    {
        if (!Enum.IsDefined(KeyType) || Target.Version == 0 && KeyType == GlobalKeyType.Kek)
        {
            throw new ArgumentException(Properties.Resources.SelectAKeyTypeSupportedByThisVersion);
        }
        return Target.GlobalKeyTransfer(client, KeyValue(KekText), new List<KeyValuePair<GlobalKeyType, byte[]>> { new(KeyType, KeyValue(KeyText)) });
    });
    /// <summary>
    /// Requests key agreement using the entered signed ephemeral public key.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task AgreeAsync() => InvokeMethodAsync(3, client =>
    {
        if (Target.SecuritySuite == SecuritySuite.Suite0)
        {
            throw new ArgumentException(Properties.Resources.KeyAgreementRequiresSecuritySuiteOneOrTwo);
        }
        var data = Hex(AgreementText);
        var expected = Target.SecuritySuite == SecuritySuite.Suite2 ? 192 : 128;
        if (data.Length != expected)
        {
            throw new ArgumentException(string.Format(System.Globalization.CultureInfo.CurrentCulture, Properties.Resources.ASignedEphemeralPublicKeyRequires0Bytes, expected));
        }
        return Target.KeyAgreement(client, new List<KeyValuePair<GlobalKeyType, byte[]>> { new(KeyType, data) });
    });
    /// <summary>
    /// Requests a key pair for the selected certificate type.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task GenerateKeyAsync() => InvokeMethodAsync(4, client => Target.GenerateKeyPair(client, SelectedCertificateType));
    /// <summary>
    /// Requests a certificate-signing request for the selected certificate type.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task GenerateRequestAsync() => InvokeMethodAsync(5, client => Target.GenerateCertificate(client, SelectedCertificateType));
    /// <summary>
    /// Requests import of the entered DER certificate.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task ImportAsync() => InvokeMethodAsync(6, client => Target.ImportCertificate(client, new Gurux.DLMS.ASN.GXx509Certificate(Hex(CertificateText))));
    /// <summary>
    /// Requests export of the certificate identified by serial number or entity.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task ExportAsync() => InvokeMethodAsync(7, client => UseSerial ? Target.ExportCertificateBySerial(client, Serial(), Issuer()) : Target.ExportCertificateByEntity(client, Entity, SelectedCertificateType, Title()));
    /// <summary>
    /// Requests removal of the certificate identified by serial number or entity.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task RemoveAsync() => InvokeMethodAsync(8, client => UseSerial ? Target.RemoveCertificateBySerial(client, Serial(), Issuer()) : Target.RemoveCertificateByEntity(client, Entity, SelectedCertificateType, Title()));
}









