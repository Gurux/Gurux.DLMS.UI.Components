@* <summary>Displays and edits DLMS sap assignment values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@inherits GXDLMSObjectViewBase<GXDLMSSapAssignment>

<section @key="Target" class="gx-object-view">
    <GXObjectViewHeader Title="@Properties.Resources.SAPAssignmentObject" Target="Target" Edit="Edit" Error="@ActionError" />
    <GXAttributeField Edit="Edit" Index="2" EditorKinds="@(new[] { "number", "text" })" Label="@Properties.Resources.SapAssignmentList" Enabled="CanEditAttribute(2)" Columns="@(new[] { Properties.Resources.SAPAddress, Properties.Resources.LogicalDeviceName })" CreateRow="@(() => new GXStructure { (ushort)1, Array.Empty<byte>() })" />
    <fieldset><legend>@Properties.Resources.Methods</legend>
    <GXValueField Label="@Properties.Resources.SAPID165535" Value="@SapId" Enabled="@(CanInvokeMethod(1))" InputKind="number" OnCommit="value => SapId = value" Validate="text => ValidateParameter(nameof(SapId), text)" />
    <GXValueField Label="@Properties.Resources.LogicalDeviceName2" Value="@DeviceName" Enabled="@(CanInvokeMethod(1))" InputKind="text" OnCommit="value => DeviceName = value" Validate="text => ValidateParameter(nameof(DeviceName), text)" />
    <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="AddAsync">@Properties.Resources.AddSAP</GXButton>
    <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="RemoveAsync">@Properties.Resources.RemoveSAP</GXButton>
    </fieldset>
</section>

@code {
    /// <summary>
    /// Service access point identifier entered for the assignment.
    /// </summary>
    public string SapId { get; set; } = string.Empty;
    /// <summary>
    /// Device name entered for the SAP assignment operation.
    /// </summary>
    public string DeviceName { get; set; } = string.Empty;
    /// <summary>Returns the required logical device name for a SAP assignment.</summary>
    /// <returns>The required logical device name for a SAP assignment.</returns>
    private string RequireName() => !string.IsNullOrWhiteSpace(DeviceName) ? DeviceName : throw new FormatException(Properties.Resources.EnterALogicalDeviceName);
    /// <summary>
    /// Requests adding the entered SAP identifier and device name.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task AddAsync() => InvokeMethodAsync(1, client =>
    {
        var id = ushort.Parse(SapId, CultureInfo.InvariantCulture);
        if (id == 0)
        {
            throw new FormatException(Properties.Resources.SAPIDZeroRemovesAnAssignmentEnterAnIDFrom1To65535);
        }
        return Target.AddSap(client, id, RequireName());
    });
    /// <summary>
    /// Requests removal of the entered SAP device name.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task RemoveAsync() => InvokeMethodAsync(1, client => Target.RemoveSap(client, RequireName()));

    /// <summary>Checks a method input and returns a validation message instead of throwing.</summary>
    /// <param name="field">The input identifier selecting the parameter validation rules.</param>
    /// <param name="text">The user input in the editor&apos;s invariant text representation.</param>
    /// <returns>The validation message, or null when the input is valid.</returns>
    private static string? ValidateParameter(string field, string text)
    {
        try
        {
            switch (field)
            {
                case nameof(SapId):
                    {
                        if (ushort.Parse(text, CultureInfo.InvariantCulture) == 0)
                        {
                            throw new FormatException(Properties.Resources.EnterAnIDFrom1To65535);
                        }
                        break;
                    }
                case nameof(DeviceName):
                    {
                        if (string.IsNullOrWhiteSpace(text))
                        {
                            throw new FormatException(Properties.Resources.EnterALogicalDeviceName);
                        }
                        break;
                    }
            }
            return null;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException) { return ex.Message; }
    }
}
