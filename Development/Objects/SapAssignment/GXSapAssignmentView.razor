@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@inherits GXDLMSObjectViewBase<GXDLMSSapAssignment>

<section @key="Target" class="gx-object-view">
    <GXObjectViewHeader Title="SAP Assignment Object" Target="Target" Edit="Edit" Error="@ActionError" />
    <GXAttributeField Edit="Edit" Index="2" EditorKinds="@(new[] { "number", "text" })" Label="Sap Assignment List" Enabled="CanEditAttribute(2)" Columns="@(new[] { "SAP address", "Logical Device Name" })" CreateRow="@(() => new GXStructure { (ushort)1, Array.Empty<byte>() })" />
    <fieldset><legend>Methods</legend>
    <GXValueField Label="SAP ID (1–65535)" Value="@SapId" Enabled="@(CanInvokeMethod(1))" InputKind="number" OnCommit="value => SapId = value" Validate="text => ValidateParameter(nameof(SapId), text)" />
    <GXValueField Label="Logical device name" Value="@DeviceName" Enabled="@(CanInvokeMethod(1))" InputKind="text" OnCommit="value => DeviceName = value" Validate="text => ValidateParameter(nameof(DeviceName), text)" />
    <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="AddAsync">Add SAP</GXButton>
    <GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="RemoveAsync">Remove SAP</GXButton>
    </fieldset>
</section>

@code {
    public string SapId { get; set; } = string.Empty;
    public string DeviceName { get; set; } = string.Empty;
    private string RequireName() => !string.IsNullOrWhiteSpace(DeviceName) ? DeviceName : throw new FormatException("Enter a logical device name.");
    public Task AddAsync() => InvokeMethodAsync(1, client => {
        var id = ushort.Parse(SapId, CultureInfo.InvariantCulture);
        if (id == 0) throw new FormatException("SAP ID zero removes an assignment; enter an ID from 1 to 65535.");
        return Target.AddSap(client, id, RequireName());
    });
    public Task RemoveAsync() => InvokeMethodAsync(1, client => Target.RemoveSap(client, RequireName()));

    private static string? ValidateParameter(string field, string text)
    {
        try
        {
            switch (field)
            {
                case nameof(SapId): { if (ushort.Parse(text, CultureInfo.InvariantCulture) == 0) throw new FormatException("Enter an ID from 1 to 65535."); break; }
                case nameof(DeviceName): { if (string.IsNullOrWhiteSpace(text)) throw new FormatException("Enter a logical device name."); break; }
            }
            return null;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException) { return ex.Message; }
    }
}
