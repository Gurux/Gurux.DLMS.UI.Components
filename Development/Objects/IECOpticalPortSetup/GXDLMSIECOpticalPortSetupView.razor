@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSIECLocalPortSetup>


<section class="gx-network-view">
<fieldset class="gx-object-fields"><legend>IEC Optical Port Setup</legend>
<GXObjectViewHeader Title="@string.Empty" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="Default Mode:" Enabled="CanEditAttribute(2)" EnumType="typeof(OpticalProtocolMode)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="Default Baudrate:" Enabled="CanEditAttribute(3)" EnumType="typeof(BaudRate)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Maximum Baudrate:" Enabled="CanEditAttribute(4)" EnumType="typeof(BaudRate)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="Response Time:" Enabled="CanEditAttribute(5)" EnumType="typeof(LocalPortResponseTime)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
    {
        <GXAttributeField Edit="Edit" Index="6" Label="Device Address:" Enabled="CanEditAttribute(6)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 7)
    {
        <GXAttributeField Edit="Edit" Index="7" Label="Password 1:" Enabled="CanEditAttribute(7)" InputKind="password"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 8)
    {
        <GXAttributeField Edit="Edit" Index="8" Label="Password 2:" Enabled="CanEditAttribute(8)" InputKind="password"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 9)
    {
        <GXAttributeField Edit="Edit" Index="9" Label="Password 5:" Enabled="CanEditAttribute(9)" InputKind="password"  />
    }
</fieldset>
</section>
