@* <summary>Displays and edits DLMS mbus master port setup values and supported actions.</summary> *@

@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSMBusMasterPortSetup>


<section class="gx-network-view">
<div class="gx-view-content">
<GXObjectViewHeader Title="MBus Master Port Setup Object" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="Comm Speed:" Enabled="CanEditAttribute(2)" EnumType="typeof(BaudRate)"  />
    }
</div>
</section>
