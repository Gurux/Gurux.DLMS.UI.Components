@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSAutoAnswer>


<section class="gx-network-view">
<fieldset class="gx-object-fields"><legend>Auto Answer Object</legend>
<GXObjectViewHeader Title="@string.Empty" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="Mode:" Enabled="CanEditAttribute(2)" EnumType="typeof(AutoAnswerMode)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="Listening Window:" Enabled="CanEditAttribute(3)" Columns='@(new[] { "Start Time:", "End Time:" })' CreateRow='@(() => new GXStructure { new byte[] { 255, 255, 1, 1, 255, 0, 0, 0, 0, 128, 0, 0 }, new byte[] { 255, 255, 1, 1, 255, 0, 0, 0, 0, 128, 0, 0 } })' />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Status:" Enabled="CanEditAttribute(4)" EnumType="typeof(AutoAnswerStatus)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="Number Of Calls:" Enabled="CanEditAttribute(5)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
    {
        <GXAttributeField Edit="Edit" Index="6" Label="Ring Count In Window:" Enabled="CanEditAttribute(6)" Part="0" />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
    {
        <GXAttributeField Edit="Edit" Index="6" Label="Ring Count Out Of Window:" Enabled="CanEditAttribute(6)" Part="1" />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 7)
    {
        <GXAttributeField Edit="Edit" Index="7" Label="Allowed callers" Enabled="CanEditAttribute(7)" Columns='@(new[] { "Caller identity", "Call type" })' CreateRow='@(() => new GXStructure { Array.Empty<byte>(), new GXEnum(0) })' />
    }
</fieldset>
</section>

