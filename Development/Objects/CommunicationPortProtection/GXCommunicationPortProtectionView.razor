@* <summary>Displays and edits DLMS communication port protection values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.DLMS
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Objects.Enums
@using Gurux.UI.Components.Tab
@inherits GXDLMSObjectViewBase<GXDLMSCommunicationPortProtection>

<section class="gx-object-view" @key="Target">
<GXObjectViewHeader Target="Target" Edit="Edit" Error="@ActionError" Title="@Properties.Resources.CommunicationPortProtectionObject" />
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
{
<GXAttributeField Edit="Edit" Index="2" Label="@Properties.Resources.ProtectionModeLabel" Enabled="CanEditAttribute(2)" EnumType="typeof(ProtectionMode)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
{
<GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.AllowedFailedAttemptsLabel" Enabled="CanEditAttribute(3)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
{
<GXAttributeField Edit="Edit" Index="4" Label="@Properties.Resources.InitialLockoutTimeLabel" Enabled="CanEditAttribute(4)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
{
<GXAttributeField Edit="Edit" Index="5" Label="@Properties.Resources.SteepnessFactorLabel" Enabled="CanEditAttribute(5)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
{
<GXAttributeField Edit="Edit" Index="6" Label="@Properties.Resources.MaxLockoutTimeLabel" Enabled="CanEditAttribute(6)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 7)
{
<GXAttributeField Edit="Edit" Index="7" Label="@Properties.Resources.PortLabel" Enabled="CanEditAttribute(7)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 8)
{
<GXAttributeField Edit="Edit" Index="8" Label="@Properties.Resources.ProtectionStatusLabel" Enabled="CanEditAttribute(8)" EnumType="typeof(ProtectionStatus)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 9)
{
<GXAttributeField Edit="Edit" Index="9" Label="@Properties.Resources.FailedAttemptsLabel" Enabled="CanEditAttribute(9)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 10)
{
<GXAttributeField Edit="Edit" Index="10" Label="@Properties.Resources.CumulativeFailedAttemptsLabel" Enabled="CanEditAttribute(10)" />
}
<GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="ResetAsync">@Properties.Resources.ResetProtection</GXButton>
</section>

@code {
    /// <summary>
    /// Requests execution of the target object's reset method.
    /// </summary>
    /// <returns>A task representing completion of the operation.</returns>
    public Task ResetAsync() => InvokeMethodAsync(1, client => Target.Reset(client));
}




