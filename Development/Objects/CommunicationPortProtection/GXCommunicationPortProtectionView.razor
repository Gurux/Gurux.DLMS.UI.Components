@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.DLMS
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Objects.Enums
@using Gurux.UI.Components.Tab
@inherits GXDLMSObjectViewBase<GXDLMSCommunicationPortProtection>

<section class="gx-object-view" @key="Target">
<GXObjectViewHeader Target="Target" Edit="Edit" Error="@ActionError" Title="Communication port protection Object" />
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
{
<GXAttributeField Edit="Edit" Index="2" Label="Protection Mode:" Enabled="CanEditAttribute(2)" EnumType="typeof(ProtectionMode)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
{
<GXAttributeField Edit="Edit" Index="3" Label="Allowed failed attempts:" Enabled="CanEditAttribute(3)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
{
<GXAttributeField Edit="Edit" Index="4" Label="Initial lockout time:" Enabled="CanEditAttribute(4)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
{
<GXAttributeField Edit="Edit" Index="5" Label="Steepness Factor:" Enabled="CanEditAttribute(5)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
{
<GXAttributeField Edit="Edit" Index="6" Label="Max Lockout Time:" Enabled="CanEditAttribute(6)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 7)
{
<GXAttributeField Edit="Edit" Index="7" Label="Port:" Enabled="CanEditAttribute(7)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 8)
{
<GXAttributeField Edit="Edit" Index="8" Label="Protection Status:" Enabled="CanEditAttribute(8)" EnumType="typeof(ProtectionStatus)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 9)
{
<GXAttributeField Edit="Edit" Index="9" Label="Failed Attempts:" Enabled="CanEditAttribute(9)" />
}
@if (((IGXDLMSBase)Target).GetAttributeCount() >= 10)
{
<GXAttributeField Edit="Edit" Index="10" Label="Cumulative Failed Attempts:" Enabled="CanEditAttribute(10)" />
}
<GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="ResetAsync">Reset protection</GXButton>
</section>

@code {
public Task ResetAsync() => InvokeMethodAsync(1, client => Target.Reset(client));
}




