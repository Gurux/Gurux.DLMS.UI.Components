@* <summary>Displays and edits DLMS tariff plan values and supported actions.</summary> *@

@using Gurux.UI.Components.Tab
@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using Gurux.DLMS.Objects.Italy
@inherits GXDLMSObjectViewBase<GXDLMSTariffPlan>

<section @key="Target" class="gx-object-view">
    <GXObjectViewHeader Title="@Properties.Resources.TariffPlanObject" Target="Target" Edit="Edit" Error="@ActionError" />
    <GXAttributeField Edit="Edit" Index="2" InputKind="text" Label="@Properties.Resources.CalendarName" Enabled="CanEditAttribute(2)" />
    <GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.Enabled" Enabled="CanEditAttribute(3)" />
    <GXAttributeField Edit="Edit" Index="5" Label="@Properties.Resources.ActivationTime" Enabled="CanEditAttribute(5)" />
    <fieldset><legend>@Properties.Resources.TariffPlan</legend>
    <GXTabControl NavigateOnSelection="false">
        <GXTabPage Text="@Properties.Resources.General">
            <GXAttributeField Edit="Edit" Index="4" Part="0" Label="@Properties.Resources.DefaultTariffBand" Enabled="CanEditAttribute(4)" />
            <GXAttributeField Edit="Edit" Index="4" Part="2" Label="@Properties.Resources.WeeklyActivation" Enabled="CanEditAttribute(4)" />
            <GXAttributeField Edit="Edit" Index="4" Part="3" Label="@Properties.Resources.SpecialDays" Enabled="CanEditAttribute(4)" Columns="@(new[] { Properties.Resources.SpecialDays })" CreateRow="@(() => (ushort)1)" />
        </GXTabPage>
        @for (var season = 0; season < 2; ++season)
        {
            var position = season;
            <GXTabPage Text="@(position == 0 ? Properties.Resources.WinterSeason : Properties.Resources.SummerSeason)">
                <fieldset><legend>@Properties.Resources.Activate</legend>
                    <GXAttributeField Edit="Edit" Index="4" Path="@($"1.{position}.0")" Label="@Properties.Resources.DayOfMonth" Enabled="CanEditAttribute(4)" />
                    <GXAttributeField Edit="Edit" Index="4" Path="@($"1.{position}.1")" Label="@Properties.Resources.Month" Enabled="CanEditAttribute(4)" />
                </fieldset>
                <GXTabControl NavigateOnSelection="false">
                    <GXTabPage Text="@Properties.Resources.WorkingDayIntervals"><GXTariffIntervals Edit="Edit" Season="position" Kind="0" Enabled="CanEditAttribute(4)" /></GXTabPage>
                    <GXTabPage Text="@Properties.Resources.SaturdayIntervals"><GXTariffIntervals Edit="Edit" Season="position" Kind="1" Enabled="CanEditAttribute(4)" /></GXTabPage>
                    <GXTabPage Text="@Properties.Resources.HolidayIntervals"><GXTariffIntervals Edit="Edit" Season="position" Kind="2" Enabled="CanEditAttribute(4)" /></GXTabPage>
                </GXTabControl>
            </GXTabPage>
        }
    </GXTabControl>
    </fieldset>
</section>
