@* <summary>Edits the packed tariff interval fields for a selected season and day kind.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS
@using Gurux.DLMS.Objects.Italy.Enums

@for (var row = 0; row < 5; ++row)
{
    var position = row;
    var packed = Interval(position);
    <fieldset><legend>Interval @(position + 1)</legend>
        <GXValueField @key="(Edit, position, 0)" Label="Start Hour" Value="@((packed & 31).ToString(CultureInfo.InvariantCulture))" Enabled="Enabled" InputKind="number" Validate="ValidateHour" OnCommit="value => SetInterval(position, 0, value)" />
        <GXValueField @key="(Edit, position, 1)" Label="Interval Tariff" Value="@(((packed >> 5) & 3).ToString(CultureInfo.InvariantCulture))" Enabled="Enabled" EnumType="typeof(DefaultTariffBand)" OnCommit="value => SetInterval(position, 1, value)" />
        <GXValueField @key="(Edit, position, 2)" Label="In use" InputKind="bool" Value="@(((packed & 128) != 0).ToString())" Enabled="Enabled" Validate="ValidateBool" OnCommit="value => SetInterval(position, 2, value)" />
    </fieldset>
}
@if (Error is not null) { <p role="alert">@Error</p> }

@code {
    /// <summary>
    /// Edit state containing pending attribute changes and validation errors.
    /// </summary>
    [Parameter, EditorRequired] public GXDLMSObjectEditState Edit { get; set; } = default!;
    /// <summary>
    /// Zero-based season index containing the tariff intervals.
    /// </summary>
    [Parameter]
    public int Season
    {
        get; set;
    }
    /// <summary>
    /// Day-kind offset selecting the interval collection within the season.
    /// </summary>
    [Parameter]
    public int Kind
    {
        get; set;
    }
    /// <summary>
    /// Whether tariff interval values can be edited.
    /// </summary>
    [Parameter]
    public bool Enabled
    {
        get; set;
    }
    /// <summary>
    /// Validation or operation error displayed by the component.
    /// </summary>
    public string? Error
    {
        get; private set;
    }
    private object Root() => Edit.Target.GetDirty(4, out var value) ? value : GXDLMSAttributeCodec.Read(Edit.Target, 4)!;
    private byte Interval(int position) => Convert.ToByte(((IList<object>)((IList<object>)((IList<object>)Root())[1])[Season])[Kind + 2] is IList<object> intervals ? intervals[position] : (byte)0, CultureInfo.InvariantCulture);
    private static string? ValidateHour(string text) => byte.TryParse(text, out var value) && value < 24 ? null : "Start hour must be between 0 and 23.";
    private static string? ValidateBool(string text) => bool.TryParse(text, out _) ? null : "Enter True or False.";
    private static object CloneValue(object value) => value switch
    {
        GXStructure structure => CloneStructure(structure),
        GXArray array => CloneArray(array),
        byte[] bytes => bytes.ToArray(),
        _ => value
    };
    private static GXStructure CloneStructure(GXStructure value)
    {
        var copy = new GXStructure();
        copy.AddRange(value.Select(CloneValue));
        return copy;
    }
    private static GXArray CloneArray(GXArray value)
    {
        var copy = new GXArray();
        copy.AddRange(value.Select(CloneValue));
        return copy;
    }
    /// <summary>
    /// Validates and stages a tariff interval field while preserving the other packed fields.
    /// </summary>
    /// <param name="text">Field value to parse and stage.</param>
    /// <param name="position">Zero-based interval position.</param>
    /// <param name="field">Field selector: zero for hour, one for tariff band, or two for enabled.</param>
    public void SetInterval(int position, int field, string text)
    {
        if (!Enabled)
        {
            return;
        }
        try
        {
            var root = (IList<object>)CloneValue(Root());
            var intervals = (IList<object>)((IList<object>)((IList<object>)root[1])[Season])[Kind + 2];
            var original = Convert.ToByte(intervals[position], CultureInfo.InvariantCulture);
            var value = field switch
            {
                0 when ValidateHour(text) is null => (byte)((original & 224) | byte.Parse(text, CultureInfo.InvariantCulture)),
                1 => (byte)((original & 159) | ((byte)Enum.Parse<DefaultTariffBand>(text) << 5)),
                2 => (byte)((original & 127) | (bool.Parse(text) ? 128 : 0)),
                _ => throw new FormatException("Start hour must be between 0 and 23.")
            };
            intervals[position] = value;
            var xml = GXDLMSObjectEditState.Format(root);
            var isolated = GXDLMSObjectEditState.For(Edit.Target.Clone());
            isolated.EditAttribute(4, xml);
            if (!isolated.IsValid)
            {
                throw new FormatException(isolated.Error(4));
            }
            Edit.EditAttribute(4, xml);
            Error = Edit.Error(4);
        }
        catch (Exception ex) when (ex is not OutOfMemoryException) { Error = ex.Message; }
    }
}
