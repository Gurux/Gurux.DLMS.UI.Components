@* <summary>Displays and edits DLMS prime nb ofdm plc mac network administration data values and supported actions.</summary> *@

@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSPrimeNbOfdmPlcMacNetworkAdministrationData>

@using Gurux.UI.Components.Tab

<section class="gx-network-view">
<div class="gx-view-content">
<GXObjectViewHeader Title="@Properties.Resources.PRIMENBOFDMPLCMACNetworkAdministrationDataObject" Target="Target" Edit="Edit" Error="@ActionError" />
<GXTabControl NavigateOnSelection="false">
<GXTabPage Text="@Properties.Resources.MulticastLabel">
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="@Properties.Resources.MulticastLabel" Enabled="CanEditAttribute(2)" Columns='@(new[] { Properties.Resources.ID, Properties.Resources.Members })' CreateRow='@(() => new GXStructure { (sbyte)0, (short)0 })' />
    }
</GXTabPage>
<GXTabPage Text="@Properties.Resources.SwitchTable">
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.SwitchTable" Enabled="CanEditAttribute(3)" Columns='@(new[] { Properties.Resources.SIDLabel })' CreateRow='@(() => (short)0)' />
    }
</GXTabPage>
<GXTabPage Text="@Properties.Resources.DirectTableLabel">
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="@Properties.Resources.DirectTableLabel" Enabled="CanEditAttribute(4)" Columns='@(new[] { Properties.Resources.SrcSID, Properties.Resources.SrcLNID, Properties.Resources.SrcLCID, Properties.Resources.DstSID, Properties.Resources.DstLNID, Properties.Resources.DstLCID, Properties.Resources.DID })' CreateRow='@(() => new GXStructure { (short)0, (short)0, (short)0, (short)0, (short)0, (short)0, new byte[6] })' InputKind="hex" />
    }
</GXTabPage>
<GXTabPage Text="@Properties.Resources.AvailableSwitchesLabel">
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="@Properties.Resources.AvailableSwitchesLabel" Enabled="CanEditAttribute(5)" Columns='@(new[] { Properties.Resources.SNA, Properties.Resources.LSID, Properties.Resources.Level, Properties.Resources.RXLevel, Properties.Resources.RXSNR })' CreateRow='@(() => new GXStructure { new byte[6], (short)0, (sbyte)0, (sbyte)0, (sbyte)0 })' InputKind="hex" />
    }
</GXTabPage>
<GXTabPage Text="@Properties.Resources.PhyCommunicationLabel">
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
    {
        <GXAttributeField Edit="Edit" Index="6" Label="@Properties.Resources.PhyCommunicationLabel" Enabled="CanEditAttribute(6)" Columns='@(new[] { Properties.Resources.EUI, Properties.Resources.TXPwr, Properties.Resources.TXCode, Properties.Resources.RXCode, Properties.Resources.RXLvl, Properties.Resources.SNR, Properties.Resources.TXPwrMod, Properties.Resources.TXCodeMod, Properties.Resources.RXCodeMod })' CreateRow='@(() => new GXStructure { new byte[6], (sbyte)0, (sbyte)0, (sbyte)0, (sbyte)0, (sbyte)0, (sbyte)0, (sbyte)0, (sbyte)0 })' InputKind="hex" />
    }
</GXTabPage>
</GXTabControl>
</div>
</section>
<section class="gx-object-actions"><GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="ResetAsync">@Properties.Resources.ResetNetworkAdministrationData</GXButton></section>
@code {
    /// <summary>Submits the object&apos;s reset method through the host action callback.</summary>
    /// <returns>A task that completes when the request or callback has finished.</returns>
    private Task ResetAsync() => InvokeMethodAsync(1, client => Target.Reset(client));
}

