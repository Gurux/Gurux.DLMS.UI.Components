@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.DLMS.Objects.Enums
@using Gurux.UI.Components
@using Gurux.UI.Components.Table

<div class="account-reference-table">
    @if (!Editing && Error is not null) { <p role="alert">@Error</p> }
    <div class="account-table-scroll">
        <GXTable @key="(Edit, Index, GXDLMSObjectEditState.Format(Rows))" TItem="int" ItemsProvider="ProvideRows" Filter="false" Menu="false" Total="false" ShowAllData="true" AllowColumnCustomization="false" OnRowChanged="SelectRow" aria-label="@Title">
            <HeaderContent Context="unused">@foreach (var header in Headers) { <GXTh TItem="int" Name="@header">@header</GXTh> }</HeaderContent>
            <ItemContent Context="row">@foreach (var cell in Cells(row)) { <GXTd @ondblclick="() => EditRow(row)">@cell</GXTd> }</ItemContent>
        </GXTable>
    </div>
    <div class="account-table-actions">
        <GXButton type="button" Disabled="@(!Enabled)" OnClick="BeginAdd">Add...</GXButton>
        <GXButton type="button" Disabled="@(!Enabled || !HasSelection)" OnClick="BeginEdit">Edit...</GXButton>
        <GXButton type="button" Disabled="@(!Enabled || !HasSelection)" OnClick="BeginRemove">Remove</GXButton>
    </div>
    @if (Editing)
    {
        <GXDialog Id="@(_referenceListId + "-dialog")" Title="@($"{(_editRow < 0 ? "Add" : "Edit")} {Title}")" Save="false" ManageFocus="true"
                  OkButtonTitle="" OnOk="SaveRow" OnCancel="CancelEdit" class="account-editor-dialog" aria-modal="true"
                  aria-labelledby="@(_referenceListId + "-dialog-title")">
            <ChildContent>
            @if (_removing) { <p>Remove the selected @Title row?</p> }
            else {
            <div class="account-row-editor">
            @if (Error is not null) { <p role="alert">@Error</p> }
            <label class="account-dialog-field"><span>@(Index <= 10 ? "Name" : "Credit Reference")</span>
                <GXInputText aria-label="@(Index <= 10 ? "Name" : "Credit Reference")" list="@_referenceListId" disabled="@(!Enabled)" @bind-Value="Reference" />
            </label>
            <datalist id="@_referenceListId">@foreach (var name in ReferenceOptions) { <option value="@name" /> }</datalist>
            @if (Index == 11)
            {
                <label class="account-dialog-field"><span>Charge Reference</span><GXInputText aria-label="Charge Reference" list="@_chargeListId" disabled="@(!Enabled)" @bind-Value="ChargeReference" /></label>
                <datalist id="@_chargeListId">@foreach (var name in ChargeOptions) { <option value="@name" /> }</datalist>
                <fieldset><legend>Configuration</legend>
                    @foreach (var flag in Enum.GetValues<CreditCollectionConfiguration>().Where(flag => flag != 0))
                    {
                        <div class="account-configuration-switch">
                            <GXInputSwitch TValue="bool" Inline="true" Save="false" id="@(_referenceListId + "-configuration-" + (int)flag)" role="switch"
                                Disabled="@(!Enabled)" Value="@((Configuration & flag) != 0)"
                                ValueChanged="value => Configuration = value ? Configuration | flag : Configuration & ~flag" />
                            <GXLabel for="@(_referenceListId + "-configuration-" + (int)flag)">@flag</GXLabel>
                        </div>
                    }
                </fieldset>
            }
            @if (Index == 12)
            {
                <label class="account-dialog-field"><span>Token proportion</span><GXInputText aria-label="Token proportion" inputmode="numeric" disabled="@(!Enabled)" @bind-Value="TokenProportionText" /></label>
            }
            </div>
            }
            </ChildContent>
            <FooterContent>
                <GXButton type="button" Disabled="@(!Enabled)" OnClick="SaveRow">OK</GXButton>
            </FooterContent>
        </GXDialog>
    }
</div>
