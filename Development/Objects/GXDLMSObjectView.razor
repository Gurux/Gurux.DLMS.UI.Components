@namespace Gurux.DLMS.UI.Components.Objects
@using Gurux.DLMS.Objects

@if (_viewType is not null)
{
    <CascadingValue Value="_access"><section class="gx-object-host"><DynamicComponent @key="Target" Type="_viewType" Parameters="_parameters" /></section></CascadingValue>
}

@code {
    [Parameter, EditorRequired] public GXDLMSObject Target { get; set; } = default!;
    [Parameter] public GXDLMSAssociationLogicalName? Association { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public GXDLMSClient? Client { get; set; }
    [Parameter] public bool ActionsEnabled { get; set; }
    [Parameter] public bool ImmediateWriteEnabled { get; set; }
    [Parameter] public EventCallback<GXDLMSObjectEditState> OnChanged { get; set; }
    [Parameter] public EventCallback<GXDLMSActionRequest> OnActionRequested { get; set; }
    [Parameter] public EventCallback<GXDLMSWriteRequest> OnWriteRequested { get; set; }
    [Parameter] public EventCallback<GXProfileReadRequest> OnProfileReadRequested { get; set; }
    private Type? _viewType;
    private GXObjectEditorAccess? _access;
    private IDictionary<string, object> _parameters = new Dictionary<string, object>();
    protected override void OnParametersSet()
    {
        var target = Target;
        _access = new(target, index => ReferenceEquals(Target, target) && !ReadOnly && GXDLMSObjectAccess.CanEdit(target, index, Association));
        _viewType = GXDLMSObjectViewRegistry.GetViewType(Target);
        _parameters = new Dictionary<string, object>
        {
            ["Target"] = Target, ["Association"] = Association!, ["ReadOnly"] = ReadOnly,
            ["OnChanged"] = OnChanged, ["Client"] = Client!, ["OnActionRequested"] = OnActionRequested,
            ["ActionsEnabled"] = ActionsEnabled
        };
        if (_viewType == typeof(GXDLMSRegisterView)) _parameters["ResetEnabled"] = ActionsEnabled;
        if (_viewType == typeof(GXProfileGenericView)) _parameters["OnReadRequested"] = OnProfileReadRequested;
        if (_viewType == typeof(GXDLMSUnixTimeView))
        {
            _parameters["WriteEnabled"] = ImmediateWriteEnabled;
            _parameters["OnWriteRequested"] = OnWriteRequested;
        }
    }
}
