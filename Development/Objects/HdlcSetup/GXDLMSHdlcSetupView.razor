@* <summary>Displays and edits DLMS hdlc setup values and supported actions.</summary> *@

@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSHdlcSetup>


<section class="gx-network-view">
<div class="gx-view-content">
<GXObjectViewHeader Title="HDLC Setup Object" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="Speed:" Enabled="CanEditAttribute(2)" EnumType="typeof(BaudRate)"  />
    }
<fieldset class="gx-object-fields"><legend>Transmit</legend>
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="Window Size:" Enabled="CanEditAttribute(3)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="Maximum Length:" Enabled="CanEditAttribute(5)"  />
    }
</fieldset>
<fieldset class="gx-object-fields"><legend>Receive:</legend>
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Window Size:" Enabled="CanEditAttribute(4)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
    {
        <GXAttributeField Edit="Edit" Index="6" Label="Maximum Length:" Enabled="CanEditAttribute(6)"  />
    }
</fieldset>
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 7)
    {
        <GXAttributeField Edit="Edit" Index="7" Label="Internal Timeout" Enabled="CanEditAttribute(7)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 8)
    {
        <GXAttributeField Edit="Edit" Index="8" Label="Inactivity Timeout:" Enabled="CanEditAttribute(8)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 9)
    {
        <GXAttributeField Edit="Edit" Index="9" Label="Device Address:" Enabled="CanEditAttribute(9)"  />
    }
</div>
</section>
