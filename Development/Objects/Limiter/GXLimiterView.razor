@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@inherits GXDLMSObjectViewBase<GXDLMSLimiter>

<section @key="Target" class="gx-object-view">
    <GXObjectViewHeader Title="Limiter Object" Target="Target" Edit="Edit" Error="@ActionError" />
    <fieldset><legend>Monitored</legend>
        <GXAttributeField Edit="Edit" Index="2" Part="0" Label="Object Type" Enabled="CanEditAttribute(2)" />
        <GXAttributeField Edit="Edit" Index="2" Part="1" Label="Value" Enabled="CanEditAttribute(2)" />
        <GXAttributeField Edit="Edit" Index="2" Part="2" Label="Index" Enabled="CanEditAttribute(2)" />
    </fieldset>
    <GXAttributeField Edit="Edit" Index="3" Label="Threshold Active" Enabled="CanEditAttribute(3)" />
    <GXAttributeField Edit="Edit" Index="4" Label="Threshold Normal" Enabled="CanEditAttribute(4)" />
    <GXAttributeField Edit="Edit" Index="5" Label="Threshold Emergency" Enabled="CanEditAttribute(5)" />
    <GXAttributeField Edit="Edit" Index="6" Label="Minimal Over" Enabled="CanEditAttribute(6)" />
    <GXAttributeField Edit="Edit" Index="7" Label="Minimal Under" Enabled="CanEditAttribute(7)" />
    <fieldset><legend>Emergency profile</legend>
        <GXAttributeField Edit="Edit" Index="8" Part="0" Label="ID" Enabled="CanEditAttribute(8)" />
        <GXAttributeField Edit="Edit" Index="8" Part="1" Label="Activation Time" Enabled="CanEditAttribute(8)" />
        <GXAttributeField Edit="Edit" Index="8" Part="2" Label="Duration" Enabled="CanEditAttribute(8)" />
        <GXAttributeField Edit="Edit" Index="9" Label="Group IDs" Enabled="CanEditAttribute(9)" Columns="@(new[] { "Group ID" })" CreateRow="@(() => (ushort)0)" />
        <GXAttributeField Edit="Edit" Index="10" Label="Active" Enabled="CanEditAttribute(10)" />
    </fieldset>
    <fieldset><legend>Action Over</legend>
        <GXAttributeField Edit="Edit" Index="11" Path="0.0" Label="Script" Enabled="CanEditAttribute(11)" />
        <GXAttributeField Edit="Edit" Index="11" Path="0.1" Label="Selector" Enabled="CanEditAttribute(11)" />
    </fieldset>
    <fieldset><legend>Action Under</legend>
        <GXAttributeField Edit="Edit" Index="11" Path="1.0" Label="Script" Enabled="CanEditAttribute(11)" />
        <GXAttributeField Edit="Edit" Index="11" Path="1.1" Label="Selector" Enabled="CanEditAttribute(11)" />
    </fieldset>
</section>
