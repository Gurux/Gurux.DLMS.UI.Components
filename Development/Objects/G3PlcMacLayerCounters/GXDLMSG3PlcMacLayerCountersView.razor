@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSG3PlcMacLayerCounters>


<section class="gx-network-view">
<fieldset class="gx-object-fields"><legend>G3 PLC MAC layer counters Object</legend>
<GXObjectViewHeader Title="@string.Empty" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="Tx Data Packets:" Enabled="CanEditAttribute(2)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="Rx Data Packets:" Enabled="CanEditAttribute(3)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Tx Cmd Packets:" Enabled="CanEditAttribute(4)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="Rx Cmd Packets:" Enabled="CanEditAttribute(5)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 6)
    {
        <GXAttributeField Edit="Edit" Index="6" Label="CSMA Fails:" Enabled="CanEditAttribute(6)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 7)
    {
        <GXAttributeField Edit="Edit" Index="7" Label="CSMA No Acks:" Enabled="CanEditAttribute(7)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 8)
    {
        <GXAttributeField Edit="Edit" Index="8" Label="Bad CRCs:" Enabled="CanEditAttribute(8)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 9)
    {
        <GXAttributeField Edit="Edit" Index="9" Label="Tx Data Broadcasts:" Enabled="CanEditAttribute(9)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 10)
    {
        <GXAttributeField Edit="Edit" Index="10" Label="Rx Data Broadcasts:" Enabled="CanEditAttribute(10)"  />
    }
</fieldset>
</section>
<section class="gx-object-actions"><GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="ResetAsync">Reset counters</GXButton></section>
@code {
    // Legacy view explicitly sends signed zero; this object has no typed Reset helper.
    private Task ResetAsync() => InvokeMethodAsync(1, client => client.Method(Target, 1, (sbyte)0));
}

