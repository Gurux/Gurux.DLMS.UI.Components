@* <summary>Displays and edits DLMS gprs setup values and supported actions.</summary> *@

@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSGprsSetup>


<section class="gx-network-view">
<div class="gx-view-content">
<GXObjectViewHeader Title="GPRS Modem Setup Object" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="APN:" Enabled="CanEditAttribute(2)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="PIN Code:" Enabled="CanEditAttribute(3)"  />
    }
<fieldset class="gx-object-fields"><legend>Default Quality of Service</legend>
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Precedence:" Enabled="CanEditAttribute(4)" Path="0.0" />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Delay:" Enabled="CanEditAttribute(4)" Path="0.1" />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Reliability:" Enabled="CanEditAttribute(4)" Path="0.2" />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Peak Throughput:" Enabled="CanEditAttribute(4)" Path="0.3" />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Mean Throughput:" Enabled="CanEditAttribute(4)" Path="0.4" />
    }
</fieldset>
<fieldset class="gx-object-fields"><legend>Requested Quality of Service</legend>
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Precedence:" Enabled="CanEditAttribute(4)" Path="1.0" />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Delay:" Enabled="CanEditAttribute(4)" Path="1.1" />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Reliability:" Enabled="CanEditAttribute(4)" Path="1.2" />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Peak Throughput:" Enabled="CanEditAttribute(4)" Path="1.3" />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Mean Throughput:" Enabled="CanEditAttribute(4)" Path="1.4" />
    }
</fieldset>
</div>
</section>
