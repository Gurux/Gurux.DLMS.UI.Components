@* <summary>Displays and edits DLMS prime nb ofdm plc physical layer counters values and supported actions.</summary> *@

@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSPrimeNbOfdmPlcPhysicalLayerCounters>


<section class="gx-network-view">
<div class="gx-view-content">
<GXObjectViewHeader Title="@Properties.Resources.PRIMENBOFDMPLCPhysicalLayerCountersObject" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="@Properties.Resources.CRCIncorrectCountLabel" Enabled="CanEditAttribute(2)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="@Properties.Resources.CRCFailedCountLabel" Enabled="CanEditAttribute(3)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="@Properties.Resources.TXDropCountLabel" Enabled="CanEditAttribute(4)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="@Properties.Resources.RXDropCountLabel" Enabled="CanEditAttribute(5)"  />
    }
</div>
</section>
<section class="gx-object-actions"><GXButton type="button" Disabled="@(!CanInvokeMethod(1))" OnClick="ResetAsync">@Properties.Resources.ResetCounters</GXButton></section>
@code {
    // Legacy view explicitly sends signed zero; this object has no typed Reset helper.
    /// <summary>Submits the object&apos;s reset method through the host action callback.</summary>
    /// <returns>A task that completes when the request or callback has finished.</returns>
    private Task ResetAsync() => InvokeMethodAsync(1, client => client.Method(Target, 1, (sbyte)0));
}
