@* <summary>Displays and edits DLMS iec twisted pair setup values and supported actions.</summary> *@

@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@using System.Net
@namespace Gurux.DLMS.UI.Components.Objects
@inherits GXDLMSObjectViewBase<GXDLMSIecTwistedPairSetup>


<section class="gx-network-view">
<div class="gx-view-content">
<GXObjectViewHeader Title="IEC Twisted Pair Setup Object" Target="Target" Edit="Edit" Error="@ActionError" />
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 2)
    {
        <GXAttributeField Edit="Edit" Index="2" Label="Mode" Enabled="CanEditAttribute(2)" EnumType="typeof(IecTwistedPairSetupMode)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 3)
    {
        <GXAttributeField Edit="Edit" Index="3" Label="Speed:" Enabled="CanEditAttribute(3)" EnumType="typeof(BaudRate)"  />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 4)
    {
        <GXAttributeField Edit="Edit" Index="4" Label="Primary addresses:" Enabled="CanEditAttribute(4)" Columns='@(new[] { "Name" })' CreateRow='@(() => (byte)0)' />
    }
    @if (((IGXDLMSBase)Target).GetAttributeCount() >= 5)
    {
        <GXAttributeField Edit="Edit" Index="5" Label="TAB(i)" Enabled="CanEditAttribute(5)" Columns='@(new[] { "Name" })' CreateRow='@(() => (byte)0)' />
    }
</div>
</section>
