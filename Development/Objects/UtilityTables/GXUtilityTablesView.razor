@* <summary>Displays and edits DLMS utility tables values and supported actions.</summary> *@

@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@inherits GXDLMSObjectViewBase<GXDLMSUtilityTables>

<section @key="Target" class="gx-object-view">
    <GXObjectViewHeader Title="Utility Tables Object" Target="Target" Edit="Edit" Error="@ActionError" />
    <GXAttributeField Edit="Edit" Index="2" Label="Table ID" Enabled="CanEditAttribute(2)" />
    <GXAttributeField Edit="Edit" Index="3" Label="Length" Enabled="CanEditAttribute(3)" />
    <GXAttributeField Edit="Edit" Index="4" InputKind="hex" Label="Buffer" Enabled="CanEditAttribute(4)" />
</section>
