    <GXAttributeField Edit="Edit" Index="5" Path="1.2" Label="Index" Enabled="CanEditAttribute(5)" />
</fieldset>
<fieldset><legend>Charge Tables</legend>
    <GXAttributeField Edit="Edit" Index="5" Path="2" EditorKinds="@(new[] { "hex", "number" })" Label="Charge Tables" Enabled="CanEditAttribute(5)" Columns="@(new[] { "Index", "Charge Per Unit" })" CreateRow="@(() => new GXStructure { Array.Empty<byte>(), (short)0 })" /><GXButton type="button" Disabled="true" title="This action is not available.">Collect</GXButton><GXButton type="button" Disabled="true">Update Total...</GXButton><GXButton type="button" Disabled="true">Set Total...</GXButton></fieldset></GXTabPage><GXTabPage Text="Unit Charge Passive">
