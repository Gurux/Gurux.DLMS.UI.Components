@using Gurux.UI.Components.Tab
@namespace Gurux.DLMS.UI.Components.Objects
@using System.Globalization
@using Gurux.DLMS
@using Gurux.DLMS.Objects
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects.Enums
@inherits GXDLMSObjectViewBase<GXDLMSCharge>

<section @key="Target" class="gx-object-view">
    <GXObjectViewHeader Title="Charge Object" Target="Target" Edit="Edit" Error="@ActionError" />
<GXTabControl NavigateOnSelection="false"><GXTabPage Text="General"><GXAttributeField Edit="Edit" Index="2" Label="Total Amount Paid" Enabled="CanEditAttribute(2)" />
<GXAttributeField Edit="Edit" Index="3" Label="Charge Type" Enabled="CanEditAttribute(3)" EnumType="typeof(ChargeType)" />
<GXAttributeField Edit="Edit" Index="4" Label="Priority" Enabled="CanEditAttribute(4)" />
<GXAttributeField Edit="Edit" Index="7" Label="Unit Charge Activation Time" Enabled="CanEditAttribute(7)" />
<GXAttributeField Edit="Edit" Index="8" Label="Period" Enabled="CanEditAttribute(8)" />
<GXAttributeField Edit="Edit" Index="9" Label="Charge Configuration" Enabled="CanEditAttribute(9)" EnumType="typeof(ChargeConfiguration)" />
<GXAttributeField Edit="Edit" Index="10" Label="Last Collection Time" Enabled="CanEditAttribute(10)" />
<GXAttributeField Edit="Edit" Index="11" Label="Last Collection Amount" Enabled="CanEditAttribute(11)" />
<GXAttributeField Edit="Edit" Index="12" Label="Total Amount Remaining" Enabled="CanEditAttribute(12)" />
<GXAttributeField Edit="Edit" Index="13" Label="Proportion" Enabled="CanEditAttribute(13)" /></GXTabPage><GXTabPage Text="Unit Charge Active">
<fieldset><legend>Charge Per Unit Scaling Type</legend>
