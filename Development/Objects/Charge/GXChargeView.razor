    <GXAttributeField Edit="Edit" Index="6" Path="1.2" Label="Index" Enabled="CanEditAttribute(6)" />
</fieldset>
<fieldset><legend>Charge Tables</legend>
    <GXAttributeField Edit="Edit" Index="6" Path="2" EditorKinds="@(new[] { "hex", "number" })" Label="Charge Tables" Enabled="CanEditAttribute(6)" Columns="@(new[] { "Index", "Charge Per Unit" })" CreateRow="@(() => new GXStructure { Array.Empty<byte>(), (short)0 })" /><GXButton type="button" Disabled="true">Update</GXButton><GXButton type="button" Disabled="true">Activate</GXButton></fieldset></GXTabPage></GXTabControl>
